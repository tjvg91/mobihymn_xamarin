rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function hasLeadershipRole(uid) {
      return userDoc(uid).roles.hasAny(['pastor', 'worshipLeader', 'projector', 'accompaniment']);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isVerified() && request.auth.uid == userId;

      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /notifications/{notificationId} {
        allow read, update: if isSignedIn() && request.auth.uid == userId;
        allow create, delete: if false;
      }

      // Local app settings backup (reader prefs, bookmarks, history).
      match /appData/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function memberHasLeadershipRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.roles
        .hasAny(['pastor', 'worshipLeader', 'projector', 'accompaniment']);
    }

    function memberDoc(groupId, uid) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(uid)).data;
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
        && memberDoc(groupId, request.auth.uid).isAdmin == true;
    }

    function isGroupCreator(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function canManageMembers(groupId) {
      return isVerified() && (isGroupAdmin(groupId) || isGroupCreator(groupId));
    }

    function canEditGroup(groupId) {
      return isVerified()
        && isGroupMember(groupId)
        && (hasLeadershipRole(request.auth.uid) || memberHasLeadershipRole(groupId));
    }

    match /groups/{groupId} {
      // get: any signed-in user can open a group doc by ID to join.
      // list: verified users can query (e.g. joinCode). Boards still require membership.
      allow get: if isSignedIn();
      allow list: if isGroupMember(groupId) || isVerified();
      allow create: if isVerified() && hasLeadershipRole(request.auth.uid);
      allow update: if isVerified()
        && isGroupMember(groupId)
        && hasLeadershipRole(request.auth.uid);

      match /members/{memberId} {
        // Own membership readable so collection-group discovery works even when
        // profile.groupIds is empty/stale (same pattern as the PWA).
        allow read: if isGroupMember(groupId)
          || (isSignedIn() && request.auth.uid == memberId);
        allow create: if isVerified();
        // Self may update own membership (e.g. mute). Admins may update others (promote).
        allow update: if canManageMembers(groupId)
          || (isVerified() && request.auth.uid == memberId);
        // Self may leave. Only group admins may remove other members.
        allow delete: if (isVerified() && request.auth.uid == memberId)
          || canManageMembers(groupId);
      }

      match /boards/{dateKey} {
        allow read: if isGroupMember(groupId);
        allow write: if canEditGroup(groupId);
      }

      match /sectionTemplate/{docId} {
        allow read: if isGroupMember(groupId);
        allow write: if canEditGroup(groupId);
      }
    }

    match /invites/{inviteId} {
      allow read: if isVerified();
      allow create: if isVerified() && hasLeadershipRole(request.auth.uid);
      allow update: if isVerified();
    }
  }
}
