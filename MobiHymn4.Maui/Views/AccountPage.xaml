<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MobiHymn4.ViewModels"
    xmlns:elements="clr-namespace:MobiHymn4.Elements"
    x:Class="MobiHymn4.Views.AccountPage"
    Title="{Binding Title}">
    <ContentPage.BindingContext>
        <vm:AccountViewModel/>
    </ContentPage.BindingContext>

    <Shell.TitleView>
        <Grid ColumnDefinitions="44,*" VerticalOptions="Center">
            <ImageButton
                x:Name="btnBack"
                Grid.Column="0"
                HeightRequest="36"
                WidthRequest="36"
                BackgroundColor="Transparent"
                Padding="8"
                Clicked="btnBack_Clicked"/>
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                TextColor="{StaticResource PrimaryText}"
                FontSize="18"
                FontAttributes="Bold"/>
        </Grid>
    </Shell.TitleView>

    <ContentPage.Resources>
        <Style TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            <Setter Property="Background" Value="{AppThemeBinding Dark={StaticResource Gray}, Light={StaticResource GrayLight}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="0,10,0,20">
            <Grid Padding="15,12" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <elements:RoleAvatarView
                    Grid.Column="0"
                    Roles="{Binding Roles}"
                    Size="56"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="{Binding DisplayName}" Style="{StaticResource Title}" FontAttributes="Bold"/>
                    <Label Text="{Binding Email}" Style="{StaticResource Subtitle}" LineBreakMode="WordWrap"/>
                    <Label Text="{Binding RolesSummary}" Style="{StaticResource Subtitle}" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Grid>

            <BoxView/>

            <Grid Padding="15,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Label
                    Grid.Column="0"
                    FontFamily="FAS"
                    Text="{Binding VerificationIconGlyph}"
                    FontSize="16"
                    TextColor="{Binding VerificationColor}"
                    VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="Email verification" Style="{StaticResource Title}"/>
                    <Label
                        Text="{Binding VerificationStatusText}"
                        Style="{StaticResource Subtitle}"
                        TextColor="{Binding VerificationColor}"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Border
                    Grid.Column="2"
                    Padding="8,4"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    VerticalOptions="Center">
                    <Border.BackgroundColor>
                        <AppThemeBinding Light="#E8F5E9" Dark="#1B3A1F"/>
                    </Border.BackgroundColor>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsEmailVerified}" Value="False">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF8E1, Dark=#3A2E12}"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Label
                        Text="{Binding VerificationBadgeText}"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{Binding VerificationColor}"/>
                </Border>
            </Grid>

            <VerticalStackLayout
                Padding="15,0,15,12"
                Spacing="8"
                IsVisible="{Binding ShowVerificationActions}">
                <Button Text="Resend verification email" Command="{Binding ResendVerificationCommand}"/>
                <Button Text="Refresh verification status" Style="{StaticResource Button-Outline}" Command="{Binding RefreshVerificationCommand}"/>
            </VerticalStackLayout>

            <BoxView/>

            <Grid Padding="15,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditProfileCommand}"/>
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Edit profile" Style="{StaticResource Title}"/>
                    <Label
                        Text="Update your name, nickname, and roles."
                        Style="{StaticResource Subtitle}"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Label
                    Grid.Column="1"
                    FontFamily="FAS"
                    Text="&#xf054;"
                    FontSize="14"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"/>
            </Grid>

            <BoxView/>

            <Grid
                Padding="15,12"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12"
                IsVisible="{Binding CanManagePassword}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PasswordOptionsCommand}"/>
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Password" Style="{StaticResource Title}"/>
                    <Label
                        Text="Change your account password."
                        Style="{StaticResource Subtitle}"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Label
                    Grid.Column="1"
                    FontFamily="FAS"
                    Text="&#xf054;"
                    FontSize="14"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"/>
            </Grid>

            <BoxView IsVisible="{Binding CanManagePassword}"/>

            <Grid Padding="15,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding NotificationsToggleTitle}" Style="{StaticResource Title}"/>
                    <Label
                        Text="{Binding NotificationsToggleSubtitle}"
                        Style="{StaticResource Subtitle}"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Switch
                    Grid.Column="1"
                    IsToggled="{Binding NotificationsEnabled}"
                    VerticalOptions="Center"
                    ThumbColor="{StaticResource Primary}"
                    OnColor="{StaticResource PrimaryLight}"
                    Toggled="NotificationsSwitch_Toggled"/>
            </Grid>

            <BoxView/>

            <Grid Padding="15,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenGroupsCommand}"/>
                </Grid.GestureRecognizers>
                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label Text="Worship groups" Style="{StaticResource Title}"/>
                    <Label
                        Text="View, create, and join groups."
                        Style="{StaticResource Subtitle}"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
                <Label
                    Grid.Column="1"
                    FontFamily="FAS"
                    Text="&#xf054;"
                    FontSize="14"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center"/>
            </Grid>

            <BoxView/>

            <VerticalStackLayout Padding="15,20" Spacing="10">
                <Label
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource Subsubtitle}"
                    TextColor="{StaticResource Red}"
                    IsVisible="{Binding HasStatusMessage}"
                    LineBreakMode="WordWrap"/>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
