<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="MobiHymn4.Views.Popups.CreateHymnListPopup"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <ContentView
            BackgroundColor="#8C000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Overlay_Tapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>

        <Border
            Padding="20"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}"
            StrokeShape="RoundRectangle 16"
            WidthRequest="320"
            MaximumWidthRequest="400"
            Margin="24,0"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="24" Opacity="0.35"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <Label
                    x:Name="lblTitle"
                    Text="New hymn list"
                    FontAttributes="Bold"
                    FontSize="17"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>

                <Label
                    x:Name="lblMessage"
                    Text="Choose a date for this hymn list."
                    FontSize="14"
                    LineBreakMode="WordWrap"
                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>

                <Border
                    Padding="10,12,10,8"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}"
                    StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="40,*,40" ColumnSpacing="4">
                            <Button
                                Grid.Column="0"
                                Text="&#xf077;"
                                FontFamily="FAS"
                                FontSize="14"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"
                                Clicked="PrevMonth_Clicked"/>
                            <Label
                                x:Name="lblMonthTitle"
                                Grid.Column="1"
                                FontAttributes="Bold"
                                FontSize="15"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                            <Button
                                Grid.Column="2"
                                Text="&#xf078;"
                                FontFamily="FAS"
                                FontSize="14"
                                WidthRequest="40"
                                HeightRequest="36"
                                Padding="0"
                                CornerRadius="8"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"
                                Clicked="NextMonth_Clicked"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="2">
                            <Label Grid.Column="0" Text="Su" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="1" Text="Mo" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="2" Text="Tu" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="3" Text="We" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="4" Text="Th" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="5" Text="Fr" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            <Label Grid.Column="6" Text="Sa" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        </Grid>

                        <Grid
                            x:Name="dayGrid"
                            ColumnDefinitions="*,*,*,*,*,*,*"
                            ColumnSpacing="2"
                            RowSpacing="2"
                            HeightRequest="228"/>

                        <HorizontalStackLayout HorizontalOptions="End">
                            <Button
                                Text="Today"
                                FontSize="14"
                                FontAttributes="Bold"
                                Padding="8,4"
                                HeightRequest="32"
                                BackgroundColor="Transparent"
                                TextColor="#2563EB"
                                Clicked="Today_Clicked"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label
                    x:Name="lblError"
                    IsVisible="False"
                    FontSize="13"
                    LineBreakMode="WordWrap"
                    TextColor="{StaticResource Red}"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        HeightRequest="44"
                        CornerRadius="10"
                        FontSize="15"
                        BackgroundColor="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"
                        Clicked="Cancel_Clicked"/>
                    <Button
                        x:Name="btnConfirm"
                        Grid.Column="1"
                        Text="Create"
                        HeightRequest="44"
                        CornerRadius="10"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="#000000"
                        Clicked="Create_Clicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>
