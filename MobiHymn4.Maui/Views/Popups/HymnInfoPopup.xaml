<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:fontawesome="clr-namespace:FontAwesome"
    x:Class="MobiHymn4.Views.Popups.HymnInfoPopup"
    Color="Transparent">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <ContentView
            BackgroundColor="#99000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Overlay_Tapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>

        <Border
            StrokeThickness="0"
            Stroke="Transparent"
            Background="{AppThemeBinding Light=White, Dark={StaticResource PrimaryText}}"
            StrokeShape="RoundRectangle 20"
            WidthRequest="340"
            MaximumWidthRequest="420"
            Margin="24"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="28" Opacity="0.35"/>
            </Border.Shadow>

            <Grid
                RowDefinitions="Auto,*,Auto"
                MaximumHeightRequest="520">

                <!-- Header -->
                <Grid
                    Grid.Row="0"
                    Padding="20,18,20,16"
                    BackgroundColor="{StaticResource Primary}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        BackgroundColor="#33FFFFFF"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Start"
                        Margin="0,0,14,0">
                        <Label
                            Text="{x:Static fontawesome:FontAwesomeIcons.Music}"
                            FontFamily="FAS"
                            FontSize="20"
                            TextColor="{StaticResource PrimaryText}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            Text="HYMN DETAILS"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="1.2"
                            TextColor="{StaticResource PrimaryText}"
                            Opacity="0.55"/>
                        <Label
                            x:Name="lblNumber"
                            FontAttributes="Bold"
                            FontSize="22"
                            LineBreakMode="TailTruncation"
                            TextColor="{StaticResource PrimaryText}"/>
                        <Label
                            x:Name="lblName"
                            FontSize="14"
                            LineBreakMode="WordWrap"
                            TextColor="{StaticResource PrimaryText}"
                            Opacity="0.8"
                            IsVisible="False"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Details -->
                <ScrollView
                    Grid.Row="1"
                    Padding="16,14,16,4"
                    VerticalOptions="Fill">
                    <VerticalStackLayout Spacing="8">
                        <VerticalStackLayout
                            x:Name="detailsHost"
                            Spacing="8"/>
                        <Label
                            x:Name="lblEmpty"
                            Text="No details available for this hymn."
                            FontSize="14"
                            Margin="8,24"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer -->
                <Grid
                    Grid.Row="2"
                    Padding="16,10,16,16"
                    BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}">
                    <Button
                        Text="Close"
                        HeightRequest="46"
                        CornerRadius="12"
                        FontSize="15"
                        FontAttributes="Bold"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource PrimaryText}"
                        Clicked="btnClose_Clicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</toolkit:Popup>
