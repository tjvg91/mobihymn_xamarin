<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:ViewModels="clr-namespace:MobiHymn4.ViewModels"
    xmlns:elements="clr-namespace:MobiHymn4.Elements"
    x:Class="MobiHymn4.Views.Popups.IntroPopup">
    <toolkit:Popup.BindingContext>
        <ViewModels:AboutViewModel/>
    </toolkit:Popup.BindingContext>

    <Grid
        Background="{StaticResource PrimaryText}"
        Padding="{OnIdiom Tablet='24,40,24,0', Default='20,50,20,0'}"
        RowDefinitions="*,Auto"
        RowSpacing="0">

        <Grid
            Grid.Row="0"
            RowDefinitions="*,Auto"
            RowSpacing="8"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

            <CarouselView
                x:Name="carouselIntro"
                Grid.Row="0"
                ItemsSource="{Binding IntroSlides}"
                IndicatorView="{x:Reference introIndicator}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill"
                Loop="False"
                Position="{Binding CurrentSlideIndex, Mode=TwoWay}"
                PositionChanged="CarouselIntro_PositionChanged"
                CurrentItemChanged="CarouselIntro_CurrentItemChanged">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="ViewModels:IntroSlide">
                        <VerticalStackLayout
                            Spacing="14"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill"
                            Padding="8,0">
                            <elements:AnimatingView
                                Source="{Binding Image}"
                                Size="{Binding Size}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                            <Label
                                Text="{Binding Title}"
                                FontSize="Large"
                                TextColor="{StaticResource White}"
                                HorizontalTextAlignment="Center"/>
                            <Label
                                Text="{Binding Subitle}"
                                FontSize="Small"
                                TextColor="{StaticResource White}"
                                HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <IndicatorView
                x:Name="introIndicator"
                Grid.Row="1"
                HorizontalOptions="Center"
                IndicatorColor="#66FFFFFF"
                SelectedIndicatorColor="{StaticResource Primary}"
                Margin="0,0,0,4" />
        </Grid>

        <!-- Bottom actions — padding includes Android tablet taskbar inset (set in code). -->
        <Grid
            x:Name="bottomBar"
            Grid.Row="1"
            Padding="0,12,0,16"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <Button
                x:Name="btnSkip"
                Grid.Column="0"
                Style="{StaticResource Button-Clear}"
                Text="Skip"
                HorizontalOptions="Start"
                Clicked="Skip_Clicked"/>
            <Button
                x:Name="btnSkipDone"
                Grid.Column="1"
                Style="{StaticResource Button-Clear}"
                Text="Next"
                HorizontalOptions="End"
                Clicked="Button_Clicked"/>
        </Grid>
    </Grid>
</toolkit:Popup>
