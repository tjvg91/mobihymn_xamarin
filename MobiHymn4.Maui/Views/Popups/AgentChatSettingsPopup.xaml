<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:fontawesome="clr-namespace:FontAwesome"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True"
    x:Class="MobiHymn4.Views.Popups.AgentChatSettingsPopup">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <ContentView
            BackgroundColor="#8C000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Overlay_Tapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>

        <Border
            Padding="16"
            Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
            StrokeThickness="1"
            Background="{AppThemeBinding Light=White, Dark={StaticResource PrimaryText}}"
            StrokeShape="RoundRectangle 16"
            WidthRequest="280"
            MaximumWidthRequest="300"
            Margin="24"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label
                    x:Name="titleLabel"
                    Text="AI settings"
                    FontAttributes="Bold"
                    FontSize="16"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>

                <!-- Main settings rows -->
                <VerticalStackLayout x:Name="settingsPanel" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Text="Agent"
                            FontSize="13"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        <VerticalStackLayout
                            Grid.Column="1"
                            WidthRequest="64"
                            Spacing="4"
                            Padding="0,4"
                            HorizontalOptions="End">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AgentValue_Tapped"/>
                            </VerticalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="modeValueLabel"
                                Text="Auto"
                                FontSize="14"
                                Padding="6,0"
                                HorizontalTextAlignment="End"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label
                            Text="Results limit"
                            FontSize="13"
                            VerticalOptions="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        <VerticalStackLayout
                            Grid.Column="1"
                            WidthRequest="64"
                            Spacing="4"
                            Padding="0,4"
                            HorizontalOptions="End">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="LimitValue_Tapped"/>
                            </VerticalStackLayout.GestureRecognizers>
                            <Label
                                x:Name="limitValueLabel"
                                Text="30"
                                FontSize="14"
                                Padding="6,0"
                                HorizontalTextAlignment="End"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                            <BoxView
                                HeightRequest="1"
                                Color="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Choice list (Agent / Results) -->
                <VerticalStackLayout
                    x:Name="choicePanel"
                    IsVisible="False"
                    Spacing="4"/>

                <Grid ColumnDefinitions="*,Auto">
                    <Button
                        x:Name="backButton"
                        Text="Back"
                        IsVisible="False"
                        Clicked="Back_Clicked"
                        HorizontalOptions="Start"
                        Style="{AppThemeBinding Light={StaticResource Button-Clear-Reverse}, Dark={StaticResource Button-Clear}}"/>
                    <Button
                        x:Name="doneButton"
                        Grid.Column="1"
                        Text="Done"
                        Clicked="Done_Clicked"
                        HorizontalOptions="End"
                        Style="{AppThemeBinding Light={StaticResource Button-Clear-Reverse}, Dark={StaticResource Button-Clear}}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>
