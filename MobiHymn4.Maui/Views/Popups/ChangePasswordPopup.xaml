<?xml version="1.0" encoding="UTF-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:fontawesome="clr-namespace:FontAwesome"
    x:Class="MobiHymn4.Views.Popups.ChangePasswordPopup"
    Color="Transparent"
    CanBeDismissedByTappingOutsideOfPopup="True">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
        <ContentView
            x:Name="overlay"
            BackgroundColor="#8C000000"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Overlay_Tapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>

        <Border
            Padding="20,16"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#333333}"
            StrokeShape="RoundRectangle 16"
            WidthRequest="320"
            MaximumWidthRequest="400"
            Margin="24,0"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,6" Radius="24" Opacity="0.35"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Change password"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>

                <VerticalStackLayout Spacing="4">
                    <Label Text="New password" Style="{StaticResource Title}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="entryNewPassword"
                                Style="{StaticResource FormEntry}"
                                IsPassword="True"
                                Placeholder="New password"/>
                            <ImageButton
                                Grid.Column="1"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="8"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                Clicked="ToggleNewPassword_Clicked">
                                <ImageButton.Source>
                                    <FontImageSource
                                        x:Name="newPasswordVisibilityIcon"
                                        FontFamily="FAS"
                                        Glyph="{x:Static fontawesome:FontAwesomeIcons.Eye}"
                                        Size="16"
                                        Color="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Confirm password" Style="{StaticResource Title}"/>
                    <Border Style="{StaticResource InputBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry
                                x:Name="entryConfirmPassword"
                                Style="{StaticResource FormEntry}"
                                IsPassword="True"
                                Placeholder="Re-enter password"/>
                            <ImageButton
                                Grid.Column="1"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="8"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                Clicked="ToggleConfirmPassword_Clicked">
                                <ImageButton.Source>
                                    <FontImageSource
                                        x:Name="confirmPasswordVisibilityIcon"
                                        FontFamily="FAS"
                                        Glyph="{x:Static fontawesome:FontAwesomeIcons.Eye}"
                                        Size="16"
                                        Color="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label
                    x:Name="lblError"
                    IsVisible="False"
                    FontSize="12"
                    TextColor="{StaticResource Red}"
                    LineBreakMode="WordWrap"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                    <Button
                        Grid.Column="0"
                        Text="Cancel"
                        Style="{StaticResource Button-Outline}"
                        HeightRequest="44"
                        Clicked="Cancel_Clicked"/>
                    <Button
                        Grid.Column="1"
                        Text="Save"
                        HeightRequest="44"
                        Clicked="Save_Clicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</toolkit:Popup>
