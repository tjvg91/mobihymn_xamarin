<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:elements="clr-namespace:MobiHymn4.Elements"
    xmlns:models="clr-namespace:MobiHymn4.Models"
    xmlns:fontawesome="clr-namespace:FontAwesome"
    x:Class="MobiHymn4.Elements.GroupDashboardPane"
    x:Name="root"
    HorizontalOptions="Fill"
    VerticalOptions="Fill"
    IsVisible="False"
    InputTransparent="True">

    <Grid HorizontalOptions="Fill" VerticalOptions="Fill" ColumnDefinitions="*,340">
        <ContentView
            x:Name="dimmer"
            Grid.Column="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            BackgroundColor="#B3000000"
            Opacity="0"
            InputTransparent="True">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Tapped="Dimmer_Tapped"/>
            </ContentView.GestureRecognizers>
        </ContentView>

        <Border
            x:Name="pane"
            Grid.Column="1"
            VerticalOptions="Fill"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Dark={StaticResource PrimaryText}, Light=White}"
            TranslationX="360">

            <Grid RowDefinitions="Auto,*" Padding="20,20,20,16" RowSpacing="0">

                <!-- Header -->
                <VerticalStackLayout x:Name="headerRow" Grid.Row="0" Spacing="4" IsVisible="False">
                    <Label
                        Text="Group Board"
                        FontSize="11"
                        CharacterSpacing="1.2"
                        TextTransform="Uppercase"
                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <Label
                            x:Name="lblGroupName"
                            Grid.Column="0"
                            Text="—"
                            FontAttributes="Bold"
                            FontSize="20"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            LineBreakMode="TailTruncation"
                            MaxLines="1"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                        <Label
                            x:Name="btnGroupMenu"
                            Grid.Column="1"
                            Text="&#xf0c0;"
                            FontFamily="FAS"
                            FontSize="16"
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            WidthRequest="32"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="GroupMenu_Tapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <BoxView
                        HeightRequest="1"
                        Margin="0,10,0,0"
                        Color="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"/>
                </VerticalStackLayout>

                <!-- Board content -->
                <Grid x:Name="boardContent" Grid.Row="1" Margin="0,14,0,0" RowDefinitions="*" RowSpacing="0" IsVisible="False">

                    <!-- Hymn lists overview -->
                    <Grid x:Name="listsOverview" IsVisible="True" RowDefinitions="Auto,*">
                        <Label
                            Grid.Row="0"
                            Text="Hymn Setlist"
                            FontSize="15"
                            FontAttributes="Bold"
                            Margin="0,0,0,10"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                        <CollectionView
                            x:Name="hymnListsCollection"
                            Grid.Row="1"
                            Margin="0,0,0,72"
                            VerticalOptions="Fill"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Padding="24,40"
                                    Spacing="6">
                                    <Label
                                        Text="No hymn lists yet"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="Center"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                    <Label
                                        Text="Create a hymn list to plan hymns and sections."
                                        Style="{StaticResource Subtitle}"
                                        HorizontalTextAlignment="Center"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupHymnListSummary">
                                    <SwipeView>
                                        <SwipeView.RightItems>
                                            <SwipeItems Mode="Reveal">
                                                <SwipeItemView Invoked="HymnList_Edit_Invoked" IsVisible="{Binding CanManage}">
                                                    <Grid WidthRequest="58" BackgroundColor="{StaticResource Primary}">
                                                        <Label
                                                            Text="&#xf304;"
                                                            FontFamily="FAS"
                                                            FontSize="16"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            TextColor="{StaticResource PrimaryText}"/>
                                                    </Grid>
                                                </SwipeItemView>
                                                <SwipeItemView Invoked="HymnList_Delete_Invoked" IsVisible="{Binding CanManage}">
                                                    <Grid WidthRequest="58" BackgroundColor="#C62828">
                                                        <Label
                                                            Text="&#xf2ed;"
                                                            FontFamily="FAS"
                                                            FontSize="16"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            TextColor="White"/>
                                                    </Grid>
                                                </SwipeItemView>
                                            </SwipeItems>
                                        </SwipeView.RightItems>
                                        <Border
                                            Padding="14,12"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                            BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#333333}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="HymnList_Tapped"/>
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="4">
                                                <Label
                                                    Text="{Binding Name}"
                                                    FontSize="15"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2"
                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                <Label
                                                    Text="{Binding Subtitle}"
                                                    FontSize="12"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </SwipeView>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button
                            x:Name="btnCreateHymnList"
                            Grid.Row="1"
                            Style="{StaticResource Button-FAB}"
                            IsVisible="False"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,4,12"
                            Clicked="CreateHymnList_Tapped">
                            <Button.ImageSource>
                                <FontImageSource
                                    FontFamily="FAS"
                                    Glyph="{x:Static fontawesome:FontAwesomeIcons.Plus}"
                                    Size="22"
                                    Color="{StaticResource PrimaryText}"/>
                            </Button.ImageSource>
                        </Button>
                    </Grid>

                    <!-- Active hymn list detail -->
                    <Grid x:Name="listDetail" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="8"
                            Padding="0,2">
                            <Label
                                Grid.Column="0"
                                Text="&#xf053;"
                                FontFamily="FAS"
                                FontSize="16"
                                WidthRequest="36"
                                HeightRequest="36"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackToLists_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                x:Name="lblActiveListName"
                                Grid.Column="1"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackToLists_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                x:Name="btnBoardOptions"
                                Grid.Column="2"
                                Text="&#xf142;"
                                FontFamily="FAS"
                                FontSize="17"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                WidthRequest="32"
                                HeightRequest="36"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                IsVisible="False"
                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BoardOptions_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <Grid Grid.Row="1">
                            <CollectionView
                                x:Name="hymnList"
                                VerticalOptions="Fill"
                                SelectionMode="Single"
                                ItemSizingStrategy="MeasureAllItems"
                                SelectionChanged="HymnList_SelectionChanged">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Padding="24,40"
                                Spacing="6">
                                <Label
                                    Text="No hymns scheduled"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                <Label
                                    Text="Tap + below to add a hymn."
                                    Style="{StaticResource Subtitle}"
                                    HorizontalTextAlignment="Center"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:BoardHymnEntry">
                                <Grid
                                    Margin="0,0,0,8"
                                    RowDefinitions="Auto,*,Auto"
                                    HorizontalOptions="Fill">
                                    <Grid.Triggers>
                                        <DataTrigger TargetType="Grid" Binding="{Binding IsSection}" Value="True">
                                            <Setter Property="Margin" Value="0,0,0,2"/>
                                        </DataTrigger>
                                    </Grid.Triggers>
                                    <BoxView
                                        Grid.Row="0"
                                        HeightRequest="3"
                                        CornerRadius="1.5"
                                        Margin="8,0,8,2"
                                        Color="{StaticResource Primary}"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding ShowDropLineAbove}"
                                        InputTransparent="True"/>
                                    <SwipeView
                                        Grid.Row="1"
                                        HorizontalOptions="Fill">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <SwipeView.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItemView Invoked="SaveSection_Invoked" IsVisible="{Binding ShowSectionSaveAction}">
                                                <Grid WidthRequest="58" BackgroundColor="#2E7D32">
                                                    <Label
                                                        Text="&#xf0c7;"
                                                        FontFamily="FAS"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="White"/>
                                                </Grid>
                                            </SwipeItemView>
                                            <SwipeItemView Invoked="UnsaveSection_Invoked" IsVisible="{Binding ShowSectionUnsaveAction}">
                                                <Grid WidthRequest="58" BackgroundColor="#616161">
                                                    <Label
                                                        Text="&#xf02e;"
                                                        FontFamily="FAS"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="White"/>
                                                </Grid>
                                            </SwipeItemView>
                                            <SwipeItemView Invoked="EditHymn_Invoked">
                                                <Grid WidthRequest="58" BackgroundColor="{StaticResource Primary}">
                                                    <Label
                                                        Text="&#xf304;"
                                                        FontFamily="FAS"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="{StaticResource PrimaryText}"/>
                                                </Grid>
                                            </SwipeItemView>
                                            <SwipeItemView Invoked="RemoveHymn_Invoked">
                                                <Grid WidthRequest="58" BackgroundColor="#C62828">
                                                    <Label
                                                        Text="&#xf2ed;"
                                                        FontFamily="FAS"
                                                        FontSize="16"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="White"/>
                                                </Grid>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border
                                        HorizontalOptions="Fill"
                                        Padding="12,10"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                        BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSection}" Value="True">
                                                <Setter Property="Padding" Value="0,6,0,6"/>
                                                <Setter Property="StrokeThickness" Value="0"/>
                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <DragGestureRecognizer
                                                CanDrag="True"
                                                DragStarting="BoardEntry_DragStarting"
                                                DropCompleted="BoardEntry_DropCompleted"/>
                                            <DropGestureRecognizer AllowDrop="True" DragOver="BoardEntry_DragOver" DragLeave="BoardEntry_DragLeave" Drop="BoardEntry_Drop"/>
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                                            <VerticalStackLayout Spacing="3" HorizontalOptions="Fill" IsVisible="{Binding IsNotEditing}">
                                                <Grid
                                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                                    ColumnSpacing="10"
                                                    Padding="4,4,0,4"
                                                    HorizontalOptions="Fill"
                                                    IsVisible="{Binding IsSection}">
                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf58e;"
                                                        FontFamily="FAS"
                                                        FontSize="14"
                                                        WidthRequest="24"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"
                                                        IsVisible="{Binding ShowDragHandle}"/>
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="{Binding SectionName}"
                                                        FontSize="14"
                                                        HorizontalOptions="Fill"
                                                        VerticalOptions="Center"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="1"
                                                        InputTransparent="True"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                    <Border
                                                        Grid.Column="2"
                                                        WidthRequest="26"
                                                        HeightRequest="26"
                                                        Padding="0"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 13"
                                                        BackgroundColor="{AppThemeBinding Light=#ECECEC, Dark=#404040}"
                                                        VerticalOptions="Center"
                                                        InputTransparent="True">
                                                        <Label
                                                            Text="{Binding SectionHymnCountText}"
                                                            FontSize="12"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                    </Border>
                                                    <Label
                                                        Grid.Column="3"
                                                        Text="{Binding ChevronGlyph}"
                                                        FontFamily="FAS"
                                                        FontSize="11"
                                                        WidthRequest="24"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Center"
                                                        TextColor="{StaticResource Primary}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="SectionHeader_Tapped"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsHymn}">
                                                    <Label
                                                        Grid.Column="0"
                                                        Text="&#xf58e;"
                                                        FontFamily="FAS"
                                                        FontSize="14"
                                                        WidthRequest="24"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalOptions="Start"
                                                        Margin="0,2,0,0"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"
                                                        IsVisible="{Binding ShowDragHandle}"
                                                        InputTransparent="True"/>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="3" InputTransparent="True">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Label
                                                            Grid.Column="0"
                                                            Text="{Binding HymnNumber, StringFormat='Hymn #{0}'}"
                                                            FontAttributes="Bold"
                                                            FontSize="15"
                                                            LineBreakMode="TailTruncation"
                                                            VerticalOptions="Center"
                                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                        <HorizontalStackLayout
                                                            Grid.Column="1"
                                                            Spacing="5"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="End">
                                                            <Label
                                                                Text="&#xf017;"
                                                                FontFamily="FAS"
                                                                FontSize="11"
                                                                VerticalOptions="Center"
                                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                            <Label
                                                                Text="{Binding AddedAtText}"
                                                                FontSize="12"
                                                                VerticalOptions="Center"
                                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                    <Label
                                                        Text="{Binding FirstLine}"
                                                        IsVisible="{Binding HasFirstLine}"
                                                        FontSize="13"
                                                        LineBreakMode="TailTruncation"
                                                        MaxLines="2"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" Margin="0,8,0,0" HorizontalOptions="Fill">
                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf007;"
                                                            FontFamily="FAS"
                                                            FontSize="11"
                                                            VerticalOptions="Center"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding AddedByName}"
                                                            FontSize="12"
                                                            VerticalOptions="Center"
                                                            LineBreakMode="TailTruncation"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                    </Grid>
                                                    <Grid
                                                        ColumnDefinitions="Auto,*"
                                                        ColumnSpacing="5"
                                                        Margin="0,4,0,0"
                                                        HorizontalOptions="Fill"
                                                        IsVisible="{Binding ShowNotes}">
                                                        <Label
                                                            Grid.Column="0"
                                                            Text="&#xf249;"
                                                            FontFamily="FAS"
                                                            FontSize="11"
                                                            VerticalOptions="Start"
                                                            Margin="0,2,0,0"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="{Binding Notes}"
                                                            FontAttributes="Italic"
                                                            FontSize="12"
                                                            Opacity="0.6"
                                                            LineBreakMode="WordWrap"
                                                            HorizontalOptions="Fill"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                    </Grid>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill" IsVisible="{Binding IsEditing}">
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Fill" IsVisible="{Binding IsSection}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                                            <Entry
                                                                Style="{StaticResource FormEntry}"
                                                                Text="{Binding EditText}"
                                                                Placeholder="Section name"
                                                                Keyboard="Text"
                                                                ReturnType="Done"
                                                                Completed="SaveEdit_Clicked"/>
                                                        </Border>
                                                        <Label
                                                            Grid.Column="1"
                                                            Text="&#xf00d;"
                                                            FontFamily="FAS"
                                                            FontSize="16"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center"
                                                            WidthRequest="28"
                                                            HorizontalTextAlignment="Center"
                                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                                            <Label.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="CancelEdit_Clicked"/>
                                                            </Label.GestureRecognizers>
                                                        </Label>
                                                    </Grid>
                                                    <Button
                                                        Text="Save"
                                                        Margin="0,10,0,0"
                                                        HeightRequest="40"
                                                        FontSize="14"
                                                        Clicked="SaveEdit_Clicked"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Spacing="0" HorizontalOptions="Fill" IsVisible="{Binding IsHymn}">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                                                        <Entry
                                                            Style="{StaticResource FormEntry}"
                                                            Text="{Binding EditText}"
                                                            Placeholder="Number or any line"
                                                            Keyboard="Text"
                                                            ReturnType="Done"
                                                            TextChanged="EditEntry_TextChanged"
                                                            Completed="SaveEdit_Clicked"/>
                                                    </Border>
                                                    <Label
                                                        Grid.Column="1"
                                                        Text="&#xf00d;"
                                                        FontFamily="FAS"
                                                        FontSize="16"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center"
                                                        WidthRequest="28"
                                                        HorizontalTextAlignment="Center"
                                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="CancelEdit_Clicked"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                </Grid>
                                                <Border Style="{StaticResource InputBorder}" Margin="0,8,0,0" IsVisible="{Binding ShowEditNote}">
                                                    <Entry
                                                        Style="{StaticResource FormEntry}"
                                                        Text="{Binding EditNote}"
                                                        Placeholder="Note (optional)"
                                                        Keyboard="Text"
                                                        ReturnType="Done"
                                                        Completed="SaveEdit_Clicked"/>
                                                </Border>
                                                <Border
                                                    IsVisible="{Binding HasEditSuggestions}"
                                                    Margin="0,4,0,0"
                                                    Padding="0"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                                    MaximumHeightRequest="240">
                                                    <ScrollView>
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditSuggestions}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="models:HymnSuggestion">
                                                                    <Grid Padding="10,8">
                                                                        <Grid.GestureRecognizers>
                                                                            <TapGestureRecognizer Tapped="EditSuggestion_Tapped"/>
                                                                        </Grid.GestureRecognizers>
                                                                        <VerticalStackLayout Spacing="2" IsVisible="{Binding LineFirst}">
                                                                            <Label
                                                                                Text="{Binding Line}"
                                                                                FontAttributes="Bold"
                                                                                FontSize="13"
                                                                                LineBreakMode="WordWrap"
                                                                                MaxLines="3"
                                                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                                            <Label
                                                                                Text="{Binding Number, StringFormat='Hymn #{0}'}"
                                                                                FontSize="12"
                                                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                                        </VerticalStackLayout>
                                                                        <VerticalStackLayout Spacing="2">
                                                                            <VerticalStackLayout.Triggers>
                                                                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding LineFirst}" Value="True">
                                                                                    <Setter Property="IsVisible" Value="False"/>
                                                                                </DataTrigger>
                                                                            </VerticalStackLayout.Triggers>
                                                                            <Label
                                                                                Text="{Binding Number, StringFormat='Hymn #{0}'}"
                                                                                FontAttributes="Bold"
                                                                                FontSize="13"
                                                                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                                            <Label
                                                                                Text="{Binding Line}"
                                                                                FontSize="13"
                                                                                LineBreakMode="WordWrap"
                                                                                MaxLines="3"
                                                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                                        </VerticalStackLayout>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </ScrollView>
                                                </Border>
                                                <Button
                                                    Text="Save"
                                                    Margin="0,10,0,0"
                                                    HeightRequest="40"
                                                    FontSize="14"
                                                    Clicked="SaveEdit_Clicked"/>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                    </SwipeView>
                                    <BoxView
                                        Grid.Row="2"
                                        HeightRequest="3"
                                        CornerRadius="1.5"
                                        Margin="8,2,8,0"
                                        Color="{StaticResource Primary}"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding ShowDropLineBelow}"
                                        InputTransparent="True"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                            <VerticalStackLayout
                                x:Name="addFabStack"
                                IsVisible="False"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="0,0,4,12"
                                Spacing="12">
                                <Button
                                    x:Name="btnAddSection"
                                    IsVisible="False"
                                    Style="{StaticResource Button-FAB}"
                                    Clicked="AddSectionFab_Tapped">
                                    <Button.ImageSource>
                                        <FontImageSource
                                            FontFamily="FAS"
                                            Glyph="{x:Static fontawesome:FontAwesomeIcons.LayerGroup}"
                                            Size="20"
                                            Color="{StaticResource PrimaryText}"/>
                                    </Button.ImageSource>
                                </Button>
                                <Button
                                    x:Name="btnAddHymn"
                                    IsVisible="False"
                                    Style="{StaticResource Button-FAB}"
                                    Clicked="AddHymnFab_Tapped">
                                    <Button.ImageSource>
                                        <FontImageSource
                                            FontFamily="FAS"
                                            Glyph="{x:Static fontawesome:FontAwesomeIcons.Music}"
                                            Size="22"
                                            Color="{StaticResource PrimaryText}"/>
                                    </Button.ImageSource>
                                </Button>
                                <Button
                                    x:Name="btnAddMenu"
                                    Style="{StaticResource Button-FAB}"
                                    Clicked="AddMenuFab_Tapped">
                                    <Button.ImageSource>
                                        <FontImageSource
                                            x:Name="imgAddMenuFab"
                                            FontFamily="FAS"
                                            Glyph="{x:Static fontawesome:FontAwesomeIcons.Plus}"
                                            Size="22"
                                            Color="{StaticResource PrimaryText}"/>
                                    </Button.ImageSource>
                                </Button>
                            </VerticalStackLayout>

                            <Border
                                x:Name="addRow"
                                IsVisible="False"
                                VerticalOptions="End"
                                HorizontalOptions="Fill"
                                Margin="0,0,0,8"
                                Padding="12"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label
                                            Text="Add hymn"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                        <Label
                                            Grid.Column="1"
                                            Text="&#xf00d;"
                                            FontFamily="FAS"
                                            FontSize="14"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="CloseAddHymnPanel_Tapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <VerticalStackLayout Spacing="0">
                                        <Border
                                            x:Name="suggestionsPanel"
                                            IsVisible="False"
                                            Margin="0,0,0,4"
                                            Padding="0"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                            MaximumHeightRequest="240">
                                            <CollectionView
                                                x:Name="hymnSuggestionsList"
                                                SelectionMode="Single"
                                                SelectionChanged="HymnSuggestions_SelectionChanged">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate x:DataType="models:HymnSuggestion">
                                                        <Grid Padding="10,8">
                                                            <VerticalStackLayout Spacing="2" IsVisible="{Binding LineFirst}">
                                                                <Label
                                                                    Text="{Binding Line}"
                                                                    FontAttributes="Bold"
                                                                    FontSize="13"
                                                                    LineBreakMode="WordWrap"
                                                                    MaxLines="3"
                                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                                <Label
                                                                    Text="{Binding Number, StringFormat='Hymn #{0}'}"
                                                                    FontSize="12"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                            </VerticalStackLayout>
                                                            <VerticalStackLayout Spacing="2">
                                                                <VerticalStackLayout.Triggers>
                                                                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding LineFirst}" Value="True">
                                                                        <Setter Property="IsVisible" Value="False"/>
                                                                    </DataTrigger>
                                                                </VerticalStackLayout.Triggers>
                                                                <Label
                                                                    Text="{Binding Number, StringFormat='Hymn #{0}'}"
                                                                    FontAttributes="Bold"
                                                                    FontSize="13"
                                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                                <Label
                                                                    Text="{Binding Line}"
                                                                    FontSize="13"
                                                                    LineBreakMode="WordWrap"
                                                                    MaxLines="3"
                                                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </Border>
                                        <Border Style="{StaticResource InputBorder}">
                                            <Entry
                                                x:Name="entHymnNumber"
                                                Style="{StaticResource FormEntry}"
                                                Placeholder="Number or any line"
                                                Keyboard="Text"
                                                ReturnType="Done"
                                                TextChanged="HymnNumber_TextChanged"
                                                Unfocused="HymnNumber_Unfocused"
                                                Completed="AddHymn_Completed"
                                                HandlerChanged="HymnNumber_HandlerChanged"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Border Style="{StaticResource InputBorder}">
                                        <Entry
                                            x:Name="entHymnNote"
                                            Style="{StaticResource FormEntry}"
                                            Placeholder="Note (optional)"
                                            Keyboard="Text"
                                            ReturnType="Done"
                                            Completed="AddHymn_Completed"/>
                                    </Border>
                                    <Button
                                        Text="Add hymn"
                                        HeightRequest="42"
                                        FontSize="14"
                                        Clicked="AddHymn_Completed"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                x:Name="addSectionRow"
                                IsVisible="False"
                                VerticalOptions="End"
                                HorizontalOptions="Fill"
                                Margin="0,0,0,8"
                                Padding="12"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label
                                            Text="Add section"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                        <Label
                                            Grid.Column="1"
                                            Text="&#xf00d;"
                                            FontFamily="FAS"
                                            FontSize="14"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="CloseAddSectionPanel_Tapped"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <Border Style="{StaticResource InputBorder}">
                                        <Entry
                                            x:Name="entSectionName"
                                            Style="{StaticResource FormEntry}"
                                            Placeholder="Section name (e.g. Group 1)"
                                            Keyboard="Text"
                                            ReturnType="Done"
                                            Completed="AddSection_Completed"/>
                                    </Border>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <CheckBox
                                            x:Name="chkSectionThisDayOnly"
                                            Grid.Column="0"
                                            IsChecked="True"
                                            VerticalOptions="Center"
                                            Color="{StaticResource Primary}"/>
                                        <Label
                                            Grid.Column="1"
                                            Text="This list only"
                                            Style="{StaticResource Subtitle}"
                                            VerticalOptions="Center"
                                            LineBreakMode="WordWrap"/>
                                        <Button
                                            Grid.Column="2"
                                            Text="Add"
                                            HeightRequest="42"
                                            FontSize="14"
                                            Padding="16,0"
                                            Clicked="AddSection_Completed"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                    </Grid>
                    </Grid>

                    <!-- Group members -->
                    <Grid x:Name="membersView" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label
                                Grid.Column="0"
                                Text="&#xf053;"
                                FontFamily="FAS"
                                FontSize="14"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="BackFromMembers_Tapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label
                                Grid.Column="1"
                                Text="Members"
                                FontSize="16"
                                FontAttributes="Bold"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Spacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="SEARCH"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                <Border Style="{StaticResource InputBorder}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,0,4,0">
                                        <Label
                                            Grid.Column="0"
                                            Text="&#xf002;"
                                            FontFamily="FAS"
                                            FontSize="13"
                                            Margin="10,0,0,0"
                                            VerticalOptions="Center"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                        <Entry
                                            x:Name="entMemberSearch"
                                            Grid.Column="1"
                                            Style="{StaticResource FormEntry}"
                                            Placeholder="Name or nickname"
                                            ReturnType="Search"
                                            ClearButtonVisibility="WhileEditing"
                                            TextChanged="MemberSearch_TextChanged"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="FILTER BY ROLE"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                <FlexLayout
                                    x:Name="memberFilterChips"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    AlignItems="Start"
                                    JustifyContent="Start"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label
                                    Text="VIEW"
                                    FontSize="10"
                                    CharacterSpacing="1"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                <Border
                                    Padding="3"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                                    BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2A2A2A}">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                        <Border
                                            x:Name="btnMembersFlat"
                                            Padding="8,7"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="Transparent">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="MembersFlatView_Tapped"/>
                                            </Border.GestureRecognizers>
                                            <Label
                                                x:Name="lblMembersFlat"
                                                Text="List"
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                        </Border>
                                        <Border
                                            x:Name="btnMembersGrouped"
                                            Grid.Column="1"
                                            Padding="8,7"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="Transparent">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="MembersGroupedView_Tapped"/>
                                            </Border.GestureRecognizers>
                                            <Label
                                                x:Name="lblMembersGrouped"
                                                Text="By role"
                                                FontSize="12"
                                                HorizontalTextAlignment="Center"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Grid Grid.Row="2" RowDefinitions="*">
                            <ActivityIndicator
                                x:Name="membersLoader"
                                IsRunning="False"
                                IsVisible="False"
                                Color="{StaticResource Primary}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>
                            <CollectionView
                                x:Name="membersCollection"
                                Grid.Row="0"
                                IsVisible="False"
                                VerticalOptions="Fill"
                                SelectionMode="None"
                                ItemSizingStrategy="MeasureFirstItem">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.EmptyView>
                                    <Label
                                        Text="No members match your search."
                                        FontSize="14"
                                        HorizontalTextAlignment="Center"
                                        Margin="0,20"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                </CollectionView.EmptyView>
                                <CollectionView.GroupHeaderTemplate>
                                    <DataTemplate x:DataType="models:GroupMemberRoleSection">
                                        <Label
                                            Text="{Binding Title}"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            CharacterSpacing="0.8"
                                            Margin="0,14,0,2"
                                            TextTransform="Uppercase"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                                    </DataTemplate>
                                </CollectionView.GroupHeaderTemplate>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:GroupMemberDisplayItem">
                                        <Grid Padding="0,6" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border
                                                Grid.Column="0"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                Padding="0"
                                                StrokeThickness="2"
                                                Stroke="{Binding AvatarTintColor}"
                                                BackgroundColor="{Binding AvatarBackgroundColor}"
                                                StrokeShape="RoundRectangle 18"
                                                VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding Initials}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="{Binding AvatarTintColor}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label
                                                    Text="{Binding DisplayName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                                                <Label
                                                    Text="{Binding VisibleRolesSummary}"
                                                    FontSize="12"
                                                    LineBreakMode="WordWrap"
                                                    IsVisible="{Binding ShowRoleSummary}"
                                                    TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource Primary}}"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Label
                                x:Name="lblMembersError"
                                IsVisible="False"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"
                                LineBreakMode="WordWrap"
                                TextColor="{StaticResource Red}"/>
                        </Grid>
                    </Grid>

                    <Grid
                        x:Name="boardLoader"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryText}}">
                        <VerticalStackLayout
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Spacing="10"
                            Padding="24">
                            <ActivityIndicator
                                IsRunning="True"
                                Color="{StaticResource Primary}"
                                HorizontalOptions="Center"/>
                            <Label
                                x:Name="lblBoardLoader"
                                Text="Loading board..."
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>

                <!-- Signed-out overlay -->
                <VerticalStackLayout x:Name="signedOutPanel" Grid.RowSpan="2" IsVisible="False" VerticalOptions="Center" Spacing="16">
                    <elements:AnimatingView
                        Source="sign-in"
                        Size="160"
                        HorizontalOptions="Center"/>
                    <Label Text="Sign in to view your group board." Style="{StaticResource Subtitle}" HorizontalTextAlignment="Center"/>
                    <Button Text="Sign In" Clicked="SignIn_Clicked" HorizontalOptions="Center" WidthRequest="160"/>
                </VerticalStackLayout>

                <!-- Signed-in, no groups -->
                <VerticalStackLayout
                    x:Name="noGroupsPanel"
                    Grid.RowSpan="2"
                    IsVisible="False"
                    VerticalOptions="Center"
                    Spacing="14"
                    Padding="4,8">
                    <Label
                        Text="Join a group"
                        FontSize="15"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryText}, Dark=White}"/>
                    <Label
                        Text="Find an existing group or create a new one."
                        Style="{StaticResource Subtitle}"
                        HorizontalTextAlignment="Center"
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource Gray}, Dark={StaticResource GrayLight}}"/>
                    <Button
                        x:Name="btnFindGroup"
                        Text="Find Group by Id"
                        Style="{StaticResource Button-Outline}"
                        Clicked="FindGroup_Clicked"/>
                    <Border
                        x:Name="findGroupPanel"
                        IsVisible="False"
                        Padding="12"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light={StaticResource GrayLight}, Dark={StaticResource Gray}}"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#333333}">
                        <VerticalStackLayout Spacing="10">
                            <Border Style="{StaticResource InputBorder}">
                                <Entry
                                    x:Name="entGroupId"
                                    Style="{StaticResource FormEntry}"
                                    Placeholder="Group ID"
                                    ReturnType="Done"
                                    Completed="JoinGroup_Clicked"/>
                            </Border>
                            <Button Text="Enter" Clicked="JoinGroup_Clicked"/>
                        </VerticalStackLayout>
                    </Border>
                    <Button
                        x:Name="btnCreateGroup"
                        Text="Create New Group"
                        IsVisible="False"
                        Clicked="CreateGroup_Clicked"/>
                    <Label
                        x:Name="lblNoGroupsStatus"
                        Style="{StaticResource Subsubtitle}"
                        TextColor="{StaticResource Red}"
                        IsVisible="False"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
