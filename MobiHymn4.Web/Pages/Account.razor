@page "/account"
@inject IAuthService Auth
@inject IProfileService Profiles
@inject IGroupService Groups
@inject IUserSettingsSyncService Sync
@inject IBoardNotificationService BoardNotifications
@inject IAppPreferences Prefs
@inject AuthNavigation AuthNav
@inject NavigationManager Nav
@inject FirebaseJs Firebase
@inject BoardNavigationContext BoardNav

<PageTitle>Account</PageTitle>

@if (!Auth.IsSignedIn)
{
    <div class="empty">
        <p class="muted">Sign in to access your account.</p>
        <a class="btn" href="@AuthNav.LoginUrl("account")">Log in</a>
    </div>
}
else
{
    <!-- User header row — mirrors AccountPage Grid with RoleAvatarView + name/email -->
    <div class="account-header">
        <div class="avatar-circle">@Initials</div>
        <div>
            <div class="title">@(Profiles.CurrentProfile?.DisplayName ?? Auth.CurrentEmail)</div>
            <div class="subtitle">@Auth.CurrentEmail</div>
        </div>
    </div>
    <div class="list-divider"></div>

    <!-- Verification row — mirrors verification Grid with colored badge -->
    <div class="list-row">
        <div class="list-row-content">
            <span class="verify-icon" style="color:@(Auth.IsEmailVerified?"var(--success)":"var(--brown)")">
                @(Auth.IsEmailVerified ? "✓" : "!")
            </span>
            <div>
                <div class="title">Email verification</div>
                <div class="subtitle" style="color:@(Auth.IsEmailVerified?"var(--success)":"var(--brown)")">
                    @(Auth.IsEmailVerified ? "Verified" : "Not verified")
                </div>
            </div>
        </div>
        <span class="badge" style="background:@(Auth.IsEmailVerified?"#E8F5E9":"#FFF8E1");
              color:@(Auth.IsEmailVerified?"var(--success)":"var(--brown)")">
            @(Auth.IsEmailVerified ? "OK" : "Pending")
        </span>
    </div>
    @if (!Auth.IsEmailVerified)
    {
        <div style="padding:10px 16px 12px;display:flex;flex-direction:column;gap:8px">
            <a class="btn block" href="verify">Verify email</a>
        </div>
    }
    <div class="list-divider"></div>

    <!-- Edit profile row — mirrors ColumnDefinitions="*,Auto" with ChevronRight -->
    <a class="list-row" href="profile">
        <div class="list-row-content">
            <div>
                <div class="title">Edit profile</div>
                <div class="subtitle">Update your name, nickname, and roles.</div>
            </div>
        </div>
        <span class="list-chevron">›</span>
    </a>
    <div class="list-divider"></div>

    <!-- Board notifications — mirrors MAUI Account mute toggle -->
    <div class="list-row account-notif-row">
        <div class="list-row-content">
            <div>
                <div class="title">@(NotificationsEnabled ? "Board notifications" : "Board notifications muted")</div>
                <div class="subtitle">
                    @(NotificationsEnabled
                        ? "Push alerts when someone updates a group board."
                        : "You will not receive board push alerts.")
                </div>
            </div>
        </div>
        <label class="switch" title="Board notifications">
            <input type="checkbox"
                   checked="@NotificationsEnabled"
                   @onchange="OnNotificationsToggled" />
            <span class="switch-slider"></span>
        </label>
    </div>

    <div class="account-push-status">
        <div class="account-push-line">
            Browser permission: <strong>@BrowserPermissionLabel</strong>
        </div>
        <div class="account-push-line">
            Device push: <strong>@DevicePushLabel</strong>
        </div>
        @if (!string.IsNullOrWhiteSpace(PushStatusDetail))
        {
            <div class="account-push-detail">@PushStatusDetail</div>
        }
        <button type="button" class="btn block" disabled="@Busy" @onclick="RegisterPushAsync">
            @(Busy ? "Registering…" : (PushOk ? "Re-register this device" : "Register this device for push"))
        </button>
    </div>
    <div class="list-divider"></div>

    <!-- Sign out -->
    <div class="account-signout">
        <button class="btn block" disabled="@Busy" @onclick="() => showSignOutConfirm = true">
            @(Busy ? "Signing out…" : "Sign out")
        </button>
    </div>
}

<ConfirmDialog @bind-Visible="showSignOutConfirm"
               Title="Sign out?"
               Message="Are you sure you want to sign out?"
               ConfirmLabel="Yes"
               CancelLabel="No"
               OnConfirmed="SignOut" />

@code {
    bool Busy;
    bool showSignOutConfirm;
    bool NotificationsEnabled = true;
    bool suppressNotifToggle;
    bool PushOk;
    string BrowserPermission = "unknown";
    string DevicePushLabel = "checking…";
    string PushStatusDetail = "";
    string BrowserPermissionLabel => BrowserPermission switch
    {
        "granted" => "allowed",
        "denied" => "blocked — enable in Android/Chrome settings for this site",
        "default" => "not asked yet",
        "unsupported" => "unsupported on this browser",
        _ => BrowserPermission
    };
    string Initials => string.IsNullOrWhiteSpace(Profiles.CurrentProfile?.DisplayName)
        ? (Auth.CurrentEmail?.Substring(0, 1) ?? "?").ToUpperInvariant()
        : string.Concat(Profiles.CurrentProfile.DisplayName.Split(' ').Take(2).Select(w => w[0])).ToUpperInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsSignedIn)
        {
            await Profiles.RefreshCurrentProfileAsync();
            LoadNotificationsFromProfile();
            await RefreshPushStatusAsync();
        }
    }

    void LoadNotificationsFromProfile()
    {
        var profile = Profiles.CurrentProfile;
        if (profile == null)
        {
            NotificationsEnabled = true;
            return;
        }

        if (profile.NotificationsPreferenceSet)
            NotificationsEnabled = !profile.NotificationsMuted;
        else
        {
            var notifyByDefault = profile.Roles.Any(r =>
                r is "projector" or "accompaniment");
            NotificationsEnabled = notifyByDefault;
        }
    }

    async Task RefreshPushStatusAsync()
    {
        try
        {
            await Firebase.EnsureReadyAsync();
            BrowserPermission = await Firebase.GetNotificationPermissionAsync();
            var raw = await Firebase.DiagnosePushAsync();
            using var diag = JsonDocument.Parse(string.IsNullOrWhiteSpace(raw) ? "{}" : raw);
            var root = diag.RootElement;
            var push = root.TryGetProperty("push", out var p) ? p.GetString() ?? "" : "";
            var supported = root.TryGetProperty("messagingSupported", out var s) && s.ValueKind == JsonValueKind.True;
            var err = root.TryGetProperty("error", out var e) ? e.GetString() ?? "" : "";
            if (BrowserPermission != "granted")
            {
                PushOk = false;
                DevicePushLabel = "not registered";
                PushStatusDetail = BrowserPermission == "denied"
                    ? "Notifications are blocked for this site. Open Chrome site settings → Notifications → Allow, then tap Register."
                    : "Tap Register so Android can ask for notification permission.";
            }
            else if (!supported)
            {
                PushOk = false;
                DevicePushLabel = "not supported";
                PushStatusDetail = string.IsNullOrWhiteSpace(err)
                    ? "This browser cannot receive web push."
                    : err;
            }
            else if (push == "subscribed")
            {
                PushOk = false;
                DevicePushLabel = "needs sync";
                PushStatusDetail = "Tap Register to save this device’s push token.";
            }
            else
            {
                PushOk = false;
                DevicePushLabel = "not registered";
                PushStatusDetail = string.IsNullOrWhiteSpace(err)
                    ? "No push subscription yet. Tap Register (required after clearing browsing data)."
                    : err;
            }
        }
        catch (Exception ex)
        {
            DevicePushLabel = "error";
            PushStatusDetail = ex.Message;
            PushOk = false;
        }
    }

    async Task RegisterPushAsync()
    {
        if (Busy) return;
        Busy = true;
        DevicePushLabel = "registering…";
        PushStatusDetail = "Requesting push token…";
        await InvokeAsync(StateHasChanged);
        try
        {
            // Force=true so Re-register always rewrites Firestore (no silent no-op).
            await RegisterPushCoreAsync(force: true);
        }
        finally
        {
            Busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task RegisterPushCoreAsync(bool force = false)
    {
        try
        {
            var perm = await Firebase.RequestNotificationPermissionAsync();
            BrowserPermission = perm;
            if (perm != "granted")
            {
                PushOk = false;
                DevicePushLabel = "not registered";
                PushStatusDetail = perm == "denied"
                    ? "Permission blocked. Enable Notifications for mobihymn.web.app in Android settings, then try again."
                    : "Permission was not granted.";
                return;
            }

            PushStatusDetail = "Saving push token…";
            await InvokeAsync(StateHasChanged);

            var ok = await BoardNotifications.RegisterTokenAsync(force);
            PushOk = ok;
            DevicePushLabel = ok ? "registered" : "failed";
            if (ok)
            {
                PushStatusDetail = $"Registered {DateTime.Now:h:mm:ss tt}. Prefer the installed app (not Chrome tabs). Keep it closed to receive board alerts.";
            }
            else
            {
                var detail = BoardNotifications.LastRegisterError
                    ?? Firebase.LastFcmTokenError;
                PushStatusDetail = string.IsNullOrWhiteSpace(detail)
                    ? "Could not get a push token. Fully close the app, reopen, then tap Register again."
                    : detail;
            }
        }
        catch (Exception ex)
        {
            PushOk = false;
            DevicePushLabel = "failed";
            PushStatusDetail = ex.Message;
        }
    }

    async Task OnNotificationsToggled(ChangeEventArgs e)
    {
        // Ignoring while Busy/suppress stops a second phantom change event (common when
        // Android disables/re-enables the checkbox mid-save) from writing mute again.
        if (suppressNotifToggle || Busy) return;
        var enabled = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        var muted = !enabled;
        Busy = true;
        suppressNotifToggle = true;
        NotificationsEnabled = enabled;
        await InvokeAsync(StateHasChanged);
        try
        {
            if (!Auth.IsEmailVerified)
            {
                try { await Auth.RefreshEmailVerificationStatusAsync(); }
                catch { /* keep current claim */ }
            }

            if (!Auth.IsEmailVerified)
                throw new InvalidOperationException("Verify your email before changing notification settings.");

            await Profiles.SetNotificationsMutedAsync(muted);

            // Account enable should clear per-group mutes so congregants actually get FCM.
            if (enabled && Profiles.CurrentProfile?.GroupIds is { Count: > 0 } groupIds)
            {
                foreach (var gid in groupIds)
                {
                    try { await Groups.SetGroupNotificationsMutedAsync(gid, false); }
                    catch { /* best-effort */ }
                }
            }

            if (enabled)
                await RegisterPushCoreAsync(force: true);
        }
        catch (Exception ex)
        {
            LoadNotificationsFromProfile();
            PushStatusDetail = ex.Message;
            PushOk = false;
        }
        finally
        {
            Busy = false;
            await InvokeAsync(StateHasChanged);
            // Swallow late change events from the switch after Busy flips off.
            await Task.Delay(300);
            suppressNotifToggle = false;
        }
    }

    async Task SignOut()
    {
        Busy = true;
        try
        {
            if (Auth.IsSignedIn && Prefs.GetBool(PrefKeys.CloudPending, false))
                await Sync.PushAsync();
            await Auth.SignOutAsync();
            BoardNav.Clear();
            Nav.NavigateTo("");
        }
        finally { Busy = false; }
    }
}
