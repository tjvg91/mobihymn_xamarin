@page "/groups/{GroupId}"
@inject BoardDeepLinkService DeepLinks
@inject NavigationManager Nav

@* Legacy path → reader with query params (keeps hymn in the background). *@
@code {
    [Parameter] public string GroupId { get; set; } = "";

    protected override void OnParametersSet()
    {
        Nav.NavigateTo(DeepLinks.BoardHref(GroupId), forceLoad: false, replace: true);
    }
}
