@page "/read"
@page "/read/{Number}"
@inject AppState State
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject BoardDeepLinkService DeepLinks
@inject BoardNavigationContext BoardNav
@inject IAuthService Auth
@implements IDisposable

<PageTitle>@(State.ActiveHymn != null ? $"#{State.ActiveHymn.Number} — {State.ActiveHymn.FirstLine}" : "Read")</PageTitle>

@if (State.IsBusy)
{
    <div class="read-loader">
        <div class="pulse-ring"></div>
        <div class="pulse-logo" aria-hidden="true">
            <img class="pulse-logo-img" src="logo-mark.svg" width="64" height="48" alt="" />
        </div>
    </div>
}
else if (State.ActiveHymn == null)
{
    <div class="empty">
        <p>No hymn open.</p>
        <a class="btn" href="number">Open a hymn</a>
    </div>
}
else
{
    var h = State.ActiveHymn;

    <div class="read-shell @(State.IsReadView ? null : "read-chrome-hidden") @(ShowPlayer && MidiPanelOpen ? "midi-panel-open" : null)"
         style="--reader-theme:@State.ReaderTheme;background:@State.ReaderTheme"
         @onclick="OnReadShellClick">
        <div class="read-body"
             @ref="readBodyRef"
             style="--reader-font:@State.ReaderFont;
                    --reader-letter-spacing:@(State.ReaderLetterSpacing.ToString(System.Globalization.CultureInfo.InvariantCulture))px;
                    --reader-theme:@State.ReaderTheme;
                    font-family:@State.ReaderFont;
                    font-size:@(State.ReaderFontSize.ToString(System.Globalization.CultureInfo.InvariantCulture))px;
                    line-height:@State.ReaderLineSpacing.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    letter-spacing: var(--reader-letter-spacing);
                    text-align:@State.ReaderTextAlign;
                    background:@State.ReaderTheme;
                    color:@LyricsColor">

            <button type="button" class="read-title-row" @onclick="OpenHymnInfo" @onclick:stopPropagation="true" title="Hymn info">
                <span class="read-title-text">Hymn #@h.Number</span>
                <i class="fa-solid fa-circle-info read-title-info" aria-hidden="true"></i>
            </button>
            <div class="read-lyrics">@((MarkupString)(h.Lyrics ?? ""))</div>
        </div>

        @if (ShowBoardNav)
        {
            @if (BoardNav.CanGoPrev)
            {
                <button type="button"
                        class="board-nav-btn board-nav-btn--prev @(State.IsReadView ? null : "is-chrome-out")"
                        title="Previous board hymn"
                        aria-label="Previous board hymn"
                        @onclick="GoBoardPrev"
                        @onclick:stopPropagation="true">
                    <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                </button>
            }
            @if (BoardNav.CanGoNext)
            {
                <button type="button"
                        class="board-nav-btn board-nav-btn--next @(State.IsReadView ? null : "is-chrome-out")"
                        title="Next board hymn"
                        aria-label="Next board hymn"
                        @onclick="GoBoardNext"
                        @onclick:stopPropagation="true">
                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                </button>
            }
        }

        @if (ShowPlayer)
        {
            @* Dim sits above the lyrics and below the player. The panel itself
               stays inside .read-player so expand/collapse is a height tween. *@
            @if (AudioMode == "midi")
            {
                <div id="midi-overlay"
                     class="read-midi-scrim @(MidiPanelOpen && MidiPanelExpanded ? "is-open" : null)"
                     aria-hidden="@(!(MidiPanelOpen && MidiPanelExpanded))"
                     inert="@(!(MidiPanelOpen && MidiPanelExpanded))"
                     @onclick="CloseMidiPanel">
                </div>
            }

            <div class="read-player @(UsesLightPlayerBar ? "read-player-on-dark-theme" : null) @(MidiPanelOpen ? "midi-open" : null) @(MidiPanelOpen && MidiPanelExpanded ? "midi-expanded" : null)"
                 style="@PlayerBarStyle"
                 @onclick:stopPropagation="true">
                @if (AudioMode == "midi")
                {
                    <div class="read-midi-panel @(State.DarkMode ? null : "is-light") @(MidiPanelOpen ? "is-open" : null)"
                         aria-hidden="@(!MidiPanelOpen)"
                         inert="@(!MidiPanelOpen)"
                         @onclick:stopPropagation="true">
                        <div class="read-midi-panel-inner">
                            @MidiPanelComponent(MidiPanelExpanded)
                        </div>
                    </div>
                }
                <div class="read-player-bar">
                    <button type="button" class="player-play" @onclick="TogglePlay" title="@(IsPlaying ? "Pause" : "Play")" aria-label="@(IsPlaying ? "Pause" : "Play")" disabled="@PlayDisabled">
                        @if (PlayDisabled)
                        {
                            <span class="spinner player-spinner"></span>
                        }
                        else if (IsPlaying)
                        {
                            <i class="fa-solid fa-pause"></i>
                        }
                        else
                        {
                            <i class="fa-solid fa-play"></i>
                        }
                    </button>
                    <button type="button"
                            class="player-tool player-skip"
                            @onclick="() => SeekByAsync(-10)"
                            title="Back 10 seconds"
                            aria-label="Back 10 seconds"
                            disabled="@(Duration <= 0)">
                        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                        <span>10</span>
                    </button>
                    <span class="player-time">@FormatTime(CurrentTime)</span>
                    <div class="player-seek-wrap" style="--seek-pct:@SeekPct.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%">
                        <div class="player-seek-ui" aria-hidden="true">
                            <div class="player-seek-track"></div>
                            <div class="player-seek-knob"></div>
                        </div>
                        <input class="player-seek" type="range" min="0" max="@SeekMax" step="0.1"
                               value="@CurrentTime"
                               disabled="@(Duration <= 0)"
                               aria-label="Seek"
                               @oninput="OnSeekInput" />
                    </div>
                    <span class="player-time">@FormatTime(Duration)</span>
                    <button type="button"
                            class="player-tool player-skip"
                            @onclick="() => SeekByAsync(10)"
                            title="Forward 10 seconds"
                            aria-label="Forward 10 seconds"
                            disabled="@(Duration <= 0)">
                        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i>
                        <span>10</span>
                    </button>
                    <button type="button"
                            class="player-tool @(AudioLoop ? "is-on" : null)"
                            @onclick="ToggleLoop"
                            title="@(AudioLoop ? "Disable loop" : "Loop")"
                            aria-label="@(AudioLoop ? "Disable loop" : "Enable loop")"
                            aria-pressed="@AudioLoop">
                        <i class="fa-solid fa-repeat" aria-hidden="true"></i>
                    </button>
                    @if (AudioMode == "midi")
                    {
                        <button type="button"
                                class="player-tool player-midi-toggle @(MidiPanelOpen ? "is-open" : null)"
                                @onclick="ToggleMidiPanel"
                                title="MIDI controls"
                                aria-label="MIDI controls"
                                aria-expanded="@MidiPanelOpen">
                            <i class="fa-solid fa-sliders"></i>
                        </button>
                    }
                    else if (AudioMode == "mp3")
                    {
                        <span class="player-mode-label" title="MP3" aria-label="MP3 playback">MP3</span>
                    }
                    @if (AudioMode == "mp3" && !string.IsNullOrEmpty(AudioUrl))
                    {
                        <audio @ref="audioRef"
                               src="@AudioUrl"
                               preload="metadata"
                               @onloadedmetadata="OnAudioMeta"
                               @ontimeupdate="OnAudioTime"
                               @onplay="OnAudioPlay"
                               @onpause="OnAudioPause"
                               @onended="OnAudioEnded"
                               @onwaiting="OnAudioWaiting"
                               @onplaying="OnAudioPlaying"
                               @onerror="OnMp3Error"></audio>
                    }
                </div>

            </div>
        }

        @* Three FABs like MAUI ReadPage — visibility follows HymnInputType + IsReadView *@
        <button class="read-fab @(State.HymnInputType == 0 ? "" : "read-fab-hidden") @(State.IsReadView ? null : "read-fab-chrome-out") @(ShowPlayer ? null : "read-fab-no-player")"
                @onclick='() => Nav.NavigateTo("/number")'
                @onclick:stopPropagation="true"
                title="Enter hymn number (grid)"
                aria-hidden="@(State.HymnInputType != 0 || !State.IsReadView)">
            <i class="fa-solid fa-grip-vertical"></i>
        </button>
        <button class="read-fab @(State.HymnInputType == 1 ? "" : "read-fab-hidden") @(State.IsReadView ? null : "read-fab-chrome-out") @(ShowPlayer ? null : "read-fab-no-player")"
                @onclick='() => Nav.NavigateTo("/number")'
                @onclick:stopPropagation="true"
                title="Enter hymn number (keyboard)"
                aria-hidden="@(State.HymnInputType != 1 || !State.IsReadView)">
            <i class="fa-solid fa-keyboard"></i>
        </button>
        <button class="read-fab @(State.HymnInputType == 2 ? "" : "read-fab-hidden") @(State.IsReadView ? null : "read-fab-chrome-out") @(ShowPlayer ? null : "read-fab-no-player")"
                @onclick='() => Nav.NavigateTo("/number")'
                @onclick:stopPropagation="true"
                title="Enter hymn number (voice)"
                aria-hidden="@(State.HymnInputType != 2 || !State.IsReadView)">
            <i class="fa-solid fa-microphone"></i>
        </button>
    </div>
}

<HymnInfoPopup @bind-Visible="showHymnInfo" Hymn="State.ActiveHymn" />

@code {
    [Parameter] public string? Number { get; set; }

    [SupplyParameterFromQuery(Name = "groupId")]
    public string? BoardGroupId { get; set; }

    [SupplyParameterFromQuery(Name = "listId")]
    public string? BoardListId { get; set; }

    string? lastBoardQueryKey;
    bool showHymnInfo;
    ElementReference readBodyRef;
    DotNetObjectReference<Read>? pinchRef;
    bool suppressChromeToggle;

    ElementReference audioRef;
    bool IsPlaying;
    bool AudioLoop;
    bool AudioLoading;
    bool ShowPlayer;
    bool IsOnline = true;
    bool seeking;
    bool MidiPanelOpen;
    string AudioMode = "none";
    string? AudioUrl;
    string? resolvedForNumber;
    int resolveGeneration;
    CancellationTokenSource? midiPollCts;
    DotNetObjectReference<Read>? netRef;
    DotNetObjectReference<Read>? dialRef;
    IJSObjectReference? netSub;
    double CurrentTime;
    double Duration;
    double MidiTempoScale = 1;
    int MidiTranspose;
    int MidiTempoBpm = 120;
    string MidiKeyName = "C";
    List<int> MidiChannels = new();
    Dictionary<int, string> MidiChannelNames = new();
    Dictionary<int, double> MidiChannelVolumes = new();
    Dictionary<int, double> MidiChannelActivity = new();
    HashSet<int> MidiMuted = new();
    HashSet<int> MidiSoloChannels = new();
    string MidiInstrumentId = "acoustic_grand_piano";
    bool MidiInstrumentLoading;
    bool MidiPanelExpanded;
    bool MidiEnterAnim;
    bool midiViewHeightAnim;
    int midiEnterToken;
    bool TempoEditing;
    bool KeyEditing;
    List<MidiInstrumentOption> MidiInstruments = DefaultMidiInstruments();
    // The transport renders before the soundfont finishes streaming, so play
    // stays busy until there is actually something to sound.
    bool PlayDisabled => AudioLoading || (AudioMode == "midi" && MidiInstrumentLoading);

    RenderFragment MidiPanelComponent(bool expanded) =>
        @<MidiPanelInner
            Expanded="@expanded"
            Entering="@MidiEnterAnim"
            InstrumentLoading="@MidiInstrumentLoading"
            InstrumentId="@MidiInstrumentId"
            Instruments="@MidiInstruments.Select(i => new MidiPanelInner.InstrumentOption(i.Id, i.Label)).ToList()"
            Channels="@MidiChannels"
            Muted="@MidiMuted"
            SoloChannels="@MidiSoloChannels"
            MuteAllDisabled="@AllVoicesMuted"
            ResetChannelStateDisabled="@ChannelStateIsDefault"
            ChannelNames="@MidiChannelNames"
            ChannelVolumes="@MidiChannelVolumes"
            ChannelActivity="@MidiChannelActivity"
            TempoDialFill="@MidiTempoDialFill"
            KeyDialFill="@MidiKeyDialFill"
            TempoMin="@TempoMinBpm"
            TempoMax="@TempoMaxBpm"
            TempoStep="@TempoStepBpm"
            TempoOffset="@MidiTempoOffset"
            TempoBpm="@MidiTempoBpm"
            TempoOffsetLabel="@MidiTempoOffsetLabel"
            TempoIsDefault="@MidiTempoIsDefault"
            TempoEditing="@TempoEditing"
            KeyMin="@KeyMinSemitones"
            KeyMax="@KeyMaxSemitones"
            Transpose="@MidiTranspose"
            KeyName="@MidiKeyName"
            TransposeLabel="@MidiTransposeLabel"
            KeyIsDefault="@MidiKeyIsDefault"
            KeyEditing="@KeyEditing"
            KeyNameForSemitoneFunc="@MidiKeyForSemitone"
            OnExpandToggle="@ToggleMidiExpand"
            OnInstrumentChange="@(id => OnInstrumentChanged(new ChangeEventArgs { Value = id }))"
            OnChannelVolume="@(t => OnChannelVolumeInput(t.ch, t.e))"
            OnMuteToggle="@ToggleChannel"
            OnSoloToggle="@ToggleSolo"
            OnMuteAll="@MuteAllChannels"
            OnResetChannelState="@ResetChannelState"
            OnTempoChange="@OnTempoInput"
            OnTempoNudge="@NudgeTempo"
            OnTempoReset="@ResetTempo"
            OnTempoEditStart="@StartTempoEdit"
            OnTempoEditEnd="@(() => TempoEditing = false)"
            OnTempoBpmType="@(bpm => OnTempoBpmTyped(new ChangeEventArgs { Value = bpm.ToString() }))"
            OnTransposeChange="@OnTransposeInput"
            OnKeyNudge="@NudgeKey"
            OnKeyReset="@ResetKey"
            OnKeyEditStart="@StartKeyEdit"
            OnKeyEditEnd="@(() => KeyEditing = false)"
            OnKeySelect="@(semi => OnKeyTyped(new ChangeEventArgs { Value = semi.ToString() }))" />;
    bool AllVoicesMuted => MidiChannels.Count > 0 && MidiChannels.TrueForAll(ch => MidiMuted.Contains(ch));
    bool NoVoicesMuted => MidiChannels.Count == 0 || MidiChannels.TrueForAll(ch => !MidiMuted.Contains(ch));
    bool ChannelVolumesAreDefault =>
        MidiChannels.Count == 0
        || MidiChannels.TrueForAll(ch => ChannelVolumePercent(ch) == 100);
    bool ChannelStateIsDefault =>
        NoVoicesMuted && MidiSoloChannels.Count == 0 && ChannelVolumesAreDefault;
    double SeekMax => Duration > 0 ? Duration : 1;
    double SeekPct => Duration > 0 ? Math.Clamp(CurrentTime / Duration * 100, 0, 100) : 0;
    string MidiTempoBpmLabel => MidiTempoBpm.ToString(System.Globalization.CultureInfo.InvariantCulture);
    // Tempo dial is a BPM delta from the file tempo, snapped to ±5.
    const int TempoMinBpm = -60;
    const int TempoMaxBpm = 60;
    const int TempoStepBpm = 5;
    int MidiFileBpm =>
        MidiTempoScale > 0.01
            ? Math.Max(1, (int)Math.Round(MidiTempoBpm / MidiTempoScale))
            : 120;
    int MidiTempoOffset => ScaleToTempoOffset(MidiTempoBpm, MidiFileBpm);
    string MidiTempoOffsetLabel =>
        (MidiTempoOffset > 0 ? "+" : "") + MidiTempoOffset;
    // One octave of distinct keys: -6..+5 keeps both ends unique instead of
    // repeating the home key an octave away at -12 / +12.
    const int KeyMinSemitones = -6;
    const int KeyMaxSemitones = 5;
    string MidiTransposeLabel =>
        (MidiTranspose > 0 ? "+" : "") + MidiTranspose + " st";
    string MidiTempoDialFill => Math.Clamp(
            (MidiTempoOffset - TempoMinBpm) / (double)(TempoMaxBpm - TempoMinBpm), 0, 1)
        .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    string MidiKeyDialFill => Math.Clamp(
            (MidiTranspose - KeyMinSemitones) / (double)(KeyMaxSemitones - KeyMinSemitones), 0, 1)
        .ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    bool MidiTempoIsDefault => MidiTempoOffset == 0;
    bool MidiKeyIsDefault => MidiTranspose == 0;
    bool ShowBoardNav => Auth.IsSignedIn && BoardNav.IsActive && State.ActiveHymn != null;

    void OnReadShellClick()
    {
        if (suppressChromeToggle)
        {
            suppressChromeToggle = false;
            return;
        }
        State.ToggleReadView();
    }

    [JSInvokable]
    public Task OnReadPinchFontSize(double size)
    {
        suppressChromeToggle = true;
        return State.SetReaderFontSizeAsync(size, persist: false);
    }

    [JSInvokable]
    public Task OnReadPinchFontSizeEnd(double size)
    {
        suppressChromeToggle = true;
        return State.SetReaderFontSizeAsync(size, persist: true);
    }

    void OpenHymnInfo() => showHymnInfo = true;

    Task GoBoardPrev() => NavigateBoardHymnAsync(-1);

    Task GoBoardNext() => NavigateBoardHymnAsync(1);

    async Task NavigateBoardHymnAsync(int delta)
    {
        if (!BoardNav.IsActive)
            return;

        var nextIndex = BoardNav.CurrentIndex + delta;
        var number = BoardNav.TryGetNumberAt(nextIndex);
        if (string.IsNullOrWhiteSpace(number))
            return;

        BoardNav.SetCurrentIndex(nextIndex);
        var hymn = await State.OpenHymnAsync(number);
        if (hymn != null)
            Nav.NavigateTo($"read/{Uri.EscapeDataString(hymn.Number)}");
    }

    string LyricsColor => IsDarkBg(State.ReaderTheme) ? "#ffffff" : "#2D2D2D";

    bool UsesLightPlayerBar => IsExactTheme(State.ReaderTheme, "2d2d2d");

    string PlayerBarStyle => UsesLightPlayerBar
        ? "background:#464646;background-color:#464646"
        : "background:#2D2D2D;background-color:#2D2D2D";

    /// <summary>MAUI: only PrimaryText (#2D2D2D) elevates the player to Gray (#464646).</summary>
    static bool IsExactTheme(string? theme, string hex6)
    {
        var hex = NormalizeHex(theme);
        if (hex.Length > 6) hex = hex[..6];
        return string.Equals(hex, hex6, StringComparison.OrdinalIgnoreCase);
    }

    static string NormalizeHex(string? c)
    {
        if (string.IsNullOrWhiteSpace(c)) return "";
        var s = c.Trim();
        if (s.StartsWith('#')) s = s[1..];
        if (s.StartsWith("0x", StringComparison.OrdinalIgnoreCase)) s = s[2..];
        return s.ToLowerInvariant();
    }

    static bool IsDarkBg(string? c)
    {
        var hex = NormalizeHex(c);
        if (hex.Length > 6) hex = hex[..6];
        if (hex.Length != 6) return false;
        if (!int.TryParse(hex[..2], System.Globalization.NumberStyles.HexNumber, null, out var r)
            || !int.TryParse(hex[2..4], System.Globalization.NumberStyles.HexNumber, null, out var g)
            || !int.TryParse(hex[4..6], System.Globalization.NumberStyles.HexNumber, null, out var b))
            return false;
        // Relative luminance threshold — light themes keep dark lyrics text.
        var luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255.0;
        return luminance < 0.45;
    }

    static string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) seconds = 0;
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:D2}:{t.Seconds:D2}"
            : $"{(int)t.TotalMinutes}:{t.Seconds:D2}";
    }

    async Task TogglePlay()
    {
        if (IsPlaying)
        {
            await Js.InvokeVoidAsync("mobihymnAudio.pause", audioRef);
            IsPlaying = false;
            AudioLoading = false;
            StopMidiPoll();
            return;
        }

        if (!await EnsureOnlineForAudioAsync())
            return;

        // Offline resolve left the chrome visible with no loaded source — try again now that we're online.
        if (AudioMode is "none" && State.ActiveHymn != null)
        {
            AudioLoading = true;
            try
            {
                await ResolveAudioAsync(State.ActiveHymn.Number);
            }
            finally
            {
                AudioLoading = false;
            }
            if (AudioMode is "none")
                return;
        }

        AudioLoading = true;
        try
        {
            var started = await Js.InvokeAsync<bool>("mobihymnAudio.play", audioRef);
            if (AudioMode == "midi")
            {
                IsPlaying = true;
                AudioLoading = false;
                StartMidiPoll();
                return;
            }

            // MP3: don't depend only on DOM play events (can miss after JS play / re-bind).
            try
            {
                var state = await Js.InvokeAsync<AudioStateDto>("mobihymnAudio.getState", audioRef);
                IsPlaying = started || !state.Paused;
                if (state.Duration > 0) Duration = state.Duration;
                if (!seeking) CurrentTime = state.Current;
            }
            catch
            {
                IsPlaying = started;
            }
        }
        catch
        {
            IsPlaying = false;
        }
        finally
        {
            AudioLoading = false;
        }
    }

    async Task<bool> EnsureOnlineForAudioAsync()
    {
        try
        {
            IsOnline = await Js.InvokeAsync<bool>("mobihymnNet.isOnline");
        }
        catch
        {
            IsOnline = true;
        }

        if (IsOnline)
            return true;

        var lottie = State.DarkMode
            ? "/lottie/no-internet-dark.gif"
            : "/lottie/no-internet-light.gif";
        State.ShowToast(lottie, "Internet required to play audio.", 2200);
        return false;
    }

    async Task OnSeekInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var t)) return;
        await SeekToAsync(t);
    }

    async Task SeekByAsync(double deltaSeconds)
    {
        if (Duration <= 0) return;
        await SeekToAsync(CurrentTime + deltaSeconds);
    }

    async Task SeekToAsync(double seconds)
    {
        var t = Math.Clamp(seconds, 0, Duration > 0 ? Duration : 0);
        seeking = true;
        CurrentTime = t;
        try { await Js.InvokeVoidAsync("mobihymnAudio.seek", audioRef, t); }
        catch { /* ignore */ }
        seeking = false;
    }

    async Task ToggleLoop()
    {
        try
        {
            AudioLoop = await Js.InvokeAsync<bool>("mobihymnAudio.setLoop", !AudioLoop);
        }
        catch
        {
            AudioLoop = !AudioLoop;
        }
    }

    async Task SyncFromElement()
    {
        try
        {
            var state = await Js.InvokeAsync<AudioStateDto>("mobihymnAudio.getState", audioRef);
            if (!seeking) CurrentTime = state.Current;
            if (state.Duration > 0) Duration = state.Duration;
            IsPlaying = !state.Paused;
            if (AudioMode == "midi" && state.Paused)
                StopMidiPoll();
        }
        catch { /* element may not be ready */ }
    }

    async Task OnAudioMeta() => await SyncFromElement();
    async Task OnAudioTime() => await SyncFromElement();
    void OnAudioPlay() { IsPlaying = true; AudioLoading = false; }
    void OnAudioPause() { IsPlaying = false; AudioLoading = false; }
    void OnAudioEnded()
    {
        if (AudioLoop) return;
        IsPlaying = false;
        AudioLoading = false;
        CurrentTime = 0;
    }
    void OnAudioWaiting() => AudioLoading = true;
    void OnAudioPlaying() { IsPlaying = true; AudioLoading = false; }

    async Task OnMp3Error()
    {
        IsPlaying = false;
        AudioLoading = false;
        var online = true;
        try { online = await Js.InvokeAsync<bool>("mobihymnNet.isOnline"); }
        catch { /* assume online */ }
        IsOnline = online;
        if (!online)
        {
            // Keep the player chrome; play will toast until connectivity returns.
            AudioMode = "none";
            AudioUrl = null;
            MidiPanelOpen = false;
            ShowPlayer = true;
            try { await Js.InvokeVoidAsync("mobihymnAudio.stop"); } catch { /* ignore */ }
            return;
        }

        // MP3 failed after resolve — hide player rather than leaving a dead control.
        ShowPlayer = false;
        AudioMode = "none";
        AudioUrl = null;
        MidiPanelOpen = false;
        await Js.InvokeVoidAsync("mobihymnAudio.stop");
    }

    void ToggleMidiPanel()
    {
        if (MidiPanelOpen)
        {
            CloseMidiPanel();
            return;
        }
        MidiPanelOpen = true;
        BeginMidiEnter();
    }

    void CloseMidiPanel()
    {
        if (!MidiPanelOpen) return;
        MidiPanelOpen = false;
        MidiEnterAnim = false;
    }

    async Task ToggleMidiExpand()
    {
        try { await Js.InvokeVoidAsync("mobihymnMidiPanel.capture"); }
        catch { /* height tween is best-effort */ }
        MidiPanelExpanded = !MidiPanelExpanded;
        State.SetMidiPanelExpanded(MidiPanelExpanded);
        midiViewHeightAnim = true;
    }

    void BeginMidiEnter()
    {
        var token = ++midiEnterToken;
        MidiEnterAnim = true;
        _ = EndMidiEnterAsync(token);
    }

    async Task EndMidiEnterAsync(int token)
    {
        try { await Task.Delay(700); }
        catch { return; }
        if (token != midiEnterToken) return;
        MidiEnterAnim = false;
        await InvokeAsync(StateHasChanged);
    }

    static Dictionary<int, string> ParseChannelNames(Dictionary<string, string>? raw)
    {
        var map = new Dictionary<int, string>();
        if (raw == null) return map;
        foreach (var kv in raw)
        {
            if (!int.TryParse(kv.Key, out var ch)) continue;
            var name = kv.Value?.Trim();
            if (!string.IsNullOrEmpty(name))
                map[ch] = name;
        }
        return map;
    }

    static Dictionary<int, double> ParseChannelVolumes(Dictionary<string, double>? raw)
    {
        var map = new Dictionary<int, double>();
        if (raw == null) return map;
        foreach (var kv in raw)
        {
            if (!int.TryParse(kv.Key, out var ch)) continue;
            map[ch] = Math.Clamp(kv.Value, 0, 1);
        }
        return map;
    }

    static Dictionary<int, double> ParseChannelActivity(Dictionary<string, double>? raw)
    {
        var map = new Dictionary<int, double>();
        if (raw == null) return map;
        foreach (var kv in raw)
        {
            if (!int.TryParse(kv.Key, out var ch)) continue;
            map[ch] = Math.Clamp(kv.Value, 0, 1);
        }
        return map;
    }

    string ChannelLabel(int ch) =>
        MidiChannelNames.TryGetValue(ch, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : (ch + 1).ToString();

    string ChannelShortLabel(int ch)
    {
        var label = ChannelLabel(ch).Trim();
        if (label.StartsWith("Soprano Alt", StringComparison.OrdinalIgnoreCase)) return "S+";
        if (label.StartsWith("Bass Alt", StringComparison.OrdinalIgnoreCase)) return "B+";
        if (label.StartsWith("Soprano", StringComparison.OrdinalIgnoreCase)) return "S";
        if (label.StartsWith("Alto", StringComparison.OrdinalIgnoreCase)) return "A";
        if (label.StartsWith("Tenor", StringComparison.OrdinalIgnoreCase)) return "T";
        if (label.StartsWith("Bass", StringComparison.OrdinalIgnoreCase)) return "B";
        if (label.Length <= 3) return label;
        return label[..1].ToUpperInvariant();
    }

    // S+ (Soprano Alt) leads the stem row when present; other voices keep
    // natural channel order so SATB still reads left-to-right after it.
    List<int> OrderChannelsForDisplay(List<int> channels) =>
        channels
            .OrderBy(ch => ChannelShortLabel(ch) == "S+" ? 0 : 1)
            .ThenBy(ch => ch)
            .ToList();

    double ChannelVolume(int ch) =>
        MidiChannelVolumes.TryGetValue(ch, out var volume)
            ? Math.Clamp(volume, 0, 1)
            : 1;

    int ChannelVolumePercent(int ch) =>
        (int)Math.Round(ChannelVolume(ch) * 100);

    string ChannelToneClass(int ch)
    {
        var label = ChannelLabel(ch);
        if (label.Contains("Soprano Alt", StringComparison.OrdinalIgnoreCase)) return "tone-salt";
        if (label.Contains("Bass Alt", StringComparison.OrdinalIgnoreCase)) return "tone-balt";
        if (label.Contains("Soprano", StringComparison.OrdinalIgnoreCase) || ch == 0) return "tone-s";
        if (label.Contains("Alto", StringComparison.OrdinalIgnoreCase) || ch == 1) return "tone-a";
        if (label.Contains("Tenor", StringComparison.OrdinalIgnoreCase) || ch == 2) return "tone-t";
        if (label.Contains("Bass", StringComparison.OrdinalIgnoreCase) || ch == 3) return "tone-b";
        return "tone-" + (ch % 6);
    }

    void ApplyMidiControls(MidiControlsDto? c)
    {
        if (c == null) return;
        MidiTempoScale = c.TempoScale > 0 ? c.TempoScale : 1;
        MidiTranspose = c.Transpose;
        MidiTempoBpm = c.TempoBpm > 0 ? c.TempoBpm : (int)Math.Round(120 * MidiTempoScale);
        MidiKeyName = FormatMidiKeyLabel(c.KeyName);
        MidiChannels = c.Channels?.ToList() ?? new List<int>();
        MidiChannelNames = ParseChannelNames(c.ChannelNames);
        MidiChannelVolumes = ParseChannelVolumes(c.ChannelVolumes);
        MidiChannelActivity = ParseChannelActivity(c.ChannelActivity);
        MidiChannels = OrderChannelsForDisplay(MidiChannels);
        MidiMuted = c.Muted != null ? new HashSet<int>(c.Muted) : new HashSet<int>();
        if (!string.IsNullOrWhiteSpace(c.Instrument))
            MidiInstrumentId = c.Instrument;
        MidiInstrumentLoading = c.InstrumentLoading;
        if (c.Instruments is { Count: > 0 })
            MidiInstruments = c.Instruments
                .Where(i => !string.IsNullOrWhiteSpace(i.Id))
                .Select(i => new MidiInstrumentOption(i.Id!, string.IsNullOrWhiteSpace(i.Label) ? i.Id! : i.Label!))
                .ToList();
        MidiSoloChannels.RemoveWhere(ch => MidiMuted.Contains(ch) || !MidiChannels.Contains(ch));
    }

