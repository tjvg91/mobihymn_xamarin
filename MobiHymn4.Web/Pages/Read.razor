    async Task ResolveAudioAsync(string number)
    {
        var gen = Interlocked.Increment(ref resolveGeneration);
        ShowPlayer = false;
        AudioMode = "none";
        AudioUrl = null;
        IsPlaying = false;
        AudioLoading = false;
        CurrentTime = 0;
        Duration = 0;
        MidiPanelOpen = false;
        MidiTempoScale = 1;
        MidiTranspose = 0;
        MidiTempoBpm = 120;
        MidiKeyName = "C";
        MidiChannels = new();
        MidiChannelNames = new();
        MidiChannelVolumes = new();
        MidiMuted = new();
        MidiSoloChannels.Clear();
        StopMidiPoll();
        resolvedForNumber = number;

        try
        {
            try { IsOnline = await Js.InvokeAsync<bool>("mobihymnNet.isOnline"); }
            catch { IsOnline = true; }

            if (!IsOnline)
            {
                // Keep player chrome offline (MAUI parity: play requires internet).
                ShowPlayer = true;
                AudioMode = "none";
                AudioUrl = null;
                return;
            }

            var mp3Urls = Mp3Candidates(number).ToArray();
            var tuneKey = State.ActiveHymn?.TuneKey;
            var result = await Js.InvokeAsync<AudioResolveDto>("mobihymnAudio.resolve", number, mp3Urls, tuneKey);
            if (gen != resolveGeneration) return;

            var mode = result?.Mode?.Trim().ToLowerInvariant() ?? "none";
            if (result == null || mode is "none")
            {
                ShowPlayer = false;
                AudioMode = "none";
                AudioUrl = null;
                return;
            }

            // MIDI has no playable URL (bytes already loaded in JS). MP3 needs a URL.
            if (mode == "mp3" && string.IsNullOrWhiteSpace(result.Url))
            {
                ShowPlayer = false;
                AudioMode = "none";
                AudioUrl = null;
                return;
            }

            AudioMode = mode;
            AudioUrl = result.Url;
            ShowPlayer = mode is "midi" or "mp3";

            if (AudioMode == "midi")
            {
                await RefreshMidiControlsAsync();
                var saved = State.GetMidiPreferences(number);
                await SetTempoOffsetAsync(saved.TempoOffset, persist: false);
                await SetTransposeAsync(saved.Transpose, persist: false);
                // Samples keep downloading after the transport is on screen.
                _ = TrackInstrumentLoadAsync(gen);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ResolveAudio failed: {ex.Message}");
            if (gen != resolveGeneration)
                return;

            try { IsOnline = await Js.InvokeAsync<bool>("mobihymnNet.isOnline"); }
            catch { IsOnline = true; }

            if (!IsOnline)
            {
                ShowPlayer = true;
                AudioMode = "none";
                AudioUrl = null;
            }
            else
            {
                ShowPlayer = false;
                AudioMode = "none";
                AudioUrl = null;
            }
        }
    }

    static IEnumerable<string> Mp3Candidates(string number)
    {
        var n = number?.Trim() ?? "";
        if (n.Length == 0) yield break;
        yield return HymnApiPaths.ClientAudioUrl(n);
        var baseNumber = System.Text.RegularExpressions.Regex.Replace(n, "[stfSTF]+$", "");
        if (!string.IsNullOrEmpty(baseNumber) &&
            !string.Equals(baseNumber, n, StringComparison.OrdinalIgnoreCase))
            yield return HymnApiPaths.ClientAudioUrl(baseNumber);
    }

    static string FormatMidiKeyLabel(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "C";

        var s = name.Trim();
        // Already compact ("Am", "Eb", "F#").
        if (!s.Contains(' ', StringComparison.Ordinal))
            return s;

        var parts = s.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var root = parts[0];
        if (parts.Length > 1
            && parts[1].StartsWith("Min", StringComparison.OrdinalIgnoreCase))
            return root + "m";
        return root;
    }

