    static int ScaleToTempoOffset(int currentBpm, int fileBpm)
    {
        var delta = currentBpm - Math.Max(fileBpm, 1);
        var stepped = (int)(Math.Round(delta / (double)TempoStepBpm) * TempoStepBpm);
        return Math.Clamp(stepped, TempoMinBpm, TempoMaxBpm);
    }

    double TempoOffsetToScale(int offset)
    {
        var stepped = (int)(Math.Round(offset / (double)TempoStepBpm) * TempoStepBpm);
        stepped = Math.Clamp(stepped, TempoMinBpm, TempoMaxBpm);
        var file = MidiFileBpm;
        return Math.Clamp((file + stepped) / (double)file, 0.5, 1.5);
    }

    async Task SetTempoOffsetAsync(int offset, bool persist = true)
    {
        var scale = TempoOffsetToScale(offset);
        try
        {
            var c = await Js.InvokeAsync<MidiControlsDto>("mobihymnAudio.setTempoScale", scale);
            ApplyMidiControls(c);
            var state = await Js.InvokeAsync<AudioStateDto>("mobihymnAudio.getState", (object?)null);
            if (state.Duration > 0) Duration = state.Duration;
            if (persist)
                await PersistMidiPreferencesAsync();
        }
        catch { /* ignore */ }
    }

