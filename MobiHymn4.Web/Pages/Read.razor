    protected override async Task OnParametersSetAsync()
    {
        var number = Number;
        if (string.IsNullOrWhiteSpace(number))
            number = State.Settings.LastHymnNumber;
        if (string.IsNullOrWhiteSpace(number))
            number = "1";

        var hymnChanged = State.ActiveHymn == null ||
            !string.Equals(State.ActiveHymn.Number, number, StringComparison.OrdinalIgnoreCase);

        if (hymnChanged)
        {
            IsPlaying = false;
            CurrentTime = 0;
            Duration = 0;
            await State.OpenHymnAsync(number);
        }

        BoardNav.SyncFromHymnNumber(State.ActiveHymn?.Number);

        if (State.ActiveHymn != null
            && !string.Equals(resolvedForNumber, State.ActiveHymn.Number, StringComparison.OrdinalIgnoreCase))
        {
            await ResolveAudioAsync(State.ActiveHymn.Number);
        }

        await OpenBoardFromQueryAsync();
    }

    async Task OpenBoardFromQueryAsync()
    {
        // Keep lastBoardQueryKey across transient null query flashes during navigation.
        if (string.IsNullOrWhiteSpace(BoardGroupId))
            return;

        var key = $"{BoardGroupId.Trim()}|{(BoardListId ?? "").Trim()}";
        if (string.Equals(key, lastBoardQueryKey, StringComparison.Ordinal))
            return;
        lastBoardQueryKey = key;

        var result = await DeepLinks.TryOpenAsync(BoardGroupId, BoardListId);
        if (result == "redirect")
            return;
        if (!string.IsNullOrEmpty(result))
        {
            lastBoardQueryKey = null;
            State.ShowToast("/lottie/done.gif", result);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                IsOnline = await Js.InvokeAsync<bool>("mobihymnNet.isOnline");
                netRef = DotNetObjectReference.Create(this);
                netSub = await Js.InvokeAsync<IJSObjectReference>("mobihymnNet.subscribe", netRef);
            }
            catch
            {
                IsOnline = true;
            }

            try
            {
                dialRef = DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync("mobihymnDial.init", dialRef);
            }
            catch { /* dials fall back to keyboard only */ }
        }

        if (ShowPlayer && AudioMode == "mp3" && !string.IsNullOrEmpty(AudioUrl))
        {
            try
            {
                await Js.InvokeVoidAsync("mobihymnAudio.bindMp3", audioRef, AudioUrl);
            }
            catch { /* ref may not be ready on first paint */ }
        }

        if (State.ActiveHymn != null)
        {
            try
            {
                pinchRef ??= DotNetObjectReference.Create(this);
                await Js.InvokeVoidAsync(
                    "mobihymnReadPinch.attach",
                    readBodyRef,
                    pinchRef,
                    State.ReaderFontSize);
            }
            catch { /* element may not be in DOM yet */ }
        }

        if (midiViewHeightAnim)
        {
            midiViewHeightAnim = false;
            try { await Js.InvokeVoidAsync("mobihymnMidiPanel.run"); }
            catch { /* keep the snap if the tween helper is missing */ }
        }

        try { await Js.InvokeVoidAsync("mobihymnPlayerMetrics.sync"); }
        catch { /* FAB falls back to its static offsets */ }

        // Hoist the dim overlay to <body> so it escapes overflow:hidden ancestors.
        try
        {
            if (AudioMode == "midi" && ShowPlayer)
                await Js.InvokeVoidAsync("mobihymnPortal.hoist", "midi-overlay");
            else
                await Js.InvokeVoidAsync("mobihymnPortal.restore", "midi-overlay");
        }
        catch { /* ignore; graceful fallback if element absent */ }
    }

    [JSInvokable]
    public void OnConnectivityChanged(bool online)
    {
        if (IsOnline == online)
            return;
        IsOnline = online;
        if (online && State.ActiveHymn != null && ShowPlayer && AudioMode is "none")
            _ = ResolveAudioAsync(State.ActiveHymn.Number);
        else if (!online && ShowPlayer && IsPlaying)
        {
            IsPlaying = false;
            AudioLoading = false;
            StopMidiPoll();
            _ = Js.InvokeVoidAsync("mobihymnAudio.pause", audioRef);
        }
        _ = InvokeAsync(StateHasChanged);
    }

