    void StartMidiPoll()
    {
        StopMidiPoll();
        midiPollCts = new CancellationTokenSource();
        var token = midiPollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(200, token);
                    await InvokeAsync(async () =>
                    {
                        await SyncFromElement();
                        // Poll is not an event handler — must request a render or the seek thumb stays put.
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException) { break; }
                catch { /* ignore */ }
            }
        }, token);
    }

    void StopMidiPoll()
    {
        try { midiPollCts?.Cancel(); } catch { /* ignore */ }
        midiPollCts?.Dispose();
        midiPollCts = null;
    }

