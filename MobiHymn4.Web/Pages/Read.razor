    {
        // Account sync can finish after this page is already showing a hymn.
        // Adopt the newly pulled per-hymn values without requiring navigation.
        if (AudioMode == "midi" && State.ActiveHymn != null)
        {
            var saved = State.GetMidiPreferences(State.ActiveHymn.Number);
            if (saved.TempoOffset != MidiTempoOffset)
                await SetTempoOffsetAsync(saved.TempoOffset, persist: false);
            if (saved.Transpose != MidiTranspose)
                await SetTransposeAsync(saved.Transpose, persist: false);
        }
        StateHasChanged();
    });
    void OnBoardNavChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);
    void OnAuthChanged(object? sender, EventArgs e)
    {
        if (!Auth.IsSignedIn)
            BoardNav.Clear();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.Changed -= OnChanged;
        BoardNav.Changed -= OnBoardNavChanged;
        Auth.AuthStateChanged -= OnAuthChanged;
        StopMidiPoll();
        try { _ = Js.InvokeVoidAsync("mobihymnReadPinch.detach", readBodyRef); }
        catch { /* ignore */ }
        pinchRef?.Dispose();
        pinchRef = null;
        try { _ = netSub?.InvokeVoidAsync("dispose"); } catch { /* ignore */ }
        netSub = null;
        netRef?.Dispose();
        netRef = null;
        try { _ = Js.InvokeVoidAsync("mobihymnPlayerMetrics.stop"); } catch { /* ignore */ }
        try { _ = Js.InvokeVoidAsync("mobihymnDial.release"); } catch { /* ignore */ }
        dialRef?.Dispose();
        dialRef = null;
        _ = Js.InvokeVoidAsync("mobihymnAudio.stop");
    }
}
