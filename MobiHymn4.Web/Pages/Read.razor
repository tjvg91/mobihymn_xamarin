    // Returns the key name that would result from transposing by `semitones` from the file key.
    string MidiKeyForSemitone(int semitones)
    {
        // Use the JS-reported key name as the base when available.
        var baseKey = MidiKeyName.Trim().Split('/')[0].Trim();
        // Fall back to C if we can't parse it.
        int basePc = baseKey.Length >= 1
            ? (new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
            {
                {"C",0},{"C#",1},{"Db",1},{"D",2},{"D#",3},{"Eb",3},{"E",4},{"F",5},
                {"F#",6},{"Gb",6},{"G",7},{"G#",8},{"Ab",8},{"A",9},{"A#",10},{"Bb",10},{"B",11}
            }.TryGetValue(baseKey, out var pc) ? pc : 0)
            : 0;
        var noteNames = new[] { "C", "C#", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B" };
        var result = noteNames[((basePc + semitones) % 12 + 12) % 12];
        return result;
    }

