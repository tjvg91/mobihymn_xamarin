@page "/groups/{GroupId}/boards/{ListId}"
@inject IBoardService BoardService
@inject AppState State
@inject NavigationManager Nav
@implements IDisposable

<h1>@(List?.Name ?? "Board")</h1>

@if (List == null)
{
    <p class="muted">@(Busy ? "Loading…" : Error ?? "Board not found.")</p>
}
else
{
    <div class="row" style="margin-bottom:12px">
        <button class="btn" @onclick="() => showAdd = true">Add hymn</button>
        <button class="btn secondary" @onclick="() => showSection = true">Add section</button>
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="error">@Error</p>
    }
    @if (!string.IsNullOrEmpty(Status))
    {
        <p class="muted">@Status</p>
    }

    @foreach (var entry in List.Hymns.OrderBy(h => h.SortOrder))
    {
        if (entry.IsSection)
        {
            <h2>@(entry.SectionName ?? "Section")</h2>
        }
        else
        {
            <div class="card row spread">
                <div style="cursor:pointer" @onclick="() => Open(entry.HymnNumber)">
                    <strong>Hymn #@entry.HymnNumber</strong>
                    @if (!string.IsNullOrWhiteSpace(entry.Notes))
                    {
                        <div class="muted">@entry.Notes</div>
                    }
                </div>
                <button class="btn secondary" style="padding:6px 10px;font-size:0.8rem"
                        @onclick="() => Remove(entry)">Remove</button>
            </div>
        }
    }
}

@if (showAdd)
{
    <div class="modal-backdrop" @onclick="() => showAdd = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Add hymn</h2>
            <div class="field">
                <label>Number</label>
                <input @bind="addNumber" placeholder="e.g. 1" />
            </div>
            <div class="field">
                <label>Notes (optional)</label>
                <input @bind="addNotes" />
            </div>
            <div class="actions">
                <button class="btn secondary" @onclick="() => showAdd = false">Cancel</button>
                <button class="btn" disabled="@Busy" @onclick="AddHymn">Add</button>
            </div>
        </div>
    </div>
}

@if (showSection)
{
    <div class="modal-backdrop" @onclick="() => showSection = false">
        <div class="modal" @onclick:stopPropagation="true">
            <h2>Add section</h2>
            <div class="field">
                <label>Name</label>
                <input @bind="sectionName" />
            </div>
            <div class="actions">
                <button class="btn secondary" @onclick="() => showSection = false">Cancel</button>
                <button class="btn" disabled="@Busy" @onclick="AddSection">Add</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string GroupId { get; set; } = "";
    [Parameter] public string ListId { get; set; } = "";

    BoardListDoc? List;
    IDisposable? sub;
    bool Busy;
    string? Error;
    string? Status;
    bool showAdd;
    bool showSection;
    string addNumber = "";
    string addNotes = "";
    string sectionName = "";

    protected override void OnParametersSet()
    {
        sub?.Dispose();
        Busy = true;
        Status = "Listening for updates…";
        sub = BoardService.SubscribeList(GroupId, ListId, list =>
        {
            List = list;
            Busy = false;
            InvokeAsync(StateHasChanged);
        });
    }

    async Task Open(string? number)
    {
        if (string.IsNullOrWhiteSpace(number)) return;
        var hymn = await State.OpenHymnAsync(number);
        if (hymn != null)
            Nav.NavigateTo($"read/{Uri.EscapeDataString(hymn.Number)}");
        else
            Error = State.StatusMessage;
    }

    async Task AddHymn()
    {
        if (List == null || string.IsNullOrWhiteSpace(addNumber)) return;
        Busy = true;
        try
        {
            var next = (List.Hymns.Count == 0 ? 0 : List.Hymns.Max(h => h.SortOrder)) + 1;
            List.Hymns.Add(new BoardHymnDoc
            {
                Id = Guid.NewGuid().ToString("N")[..10],
                HymnNumber = addNumber.Trim().ToLowerInvariant(),
                Notes = addNotes.Trim(),
                SortOrder = next
            });
            await BoardService.UpdateListAsync(GroupId, List);
            showAdd = false;
            addNumber = "";
            addNotes = "";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    async Task AddSection()
    {
        if (List == null || string.IsNullOrWhiteSpace(sectionName)) return;
        Busy = true;
        try
        {
            var next = (List.Hymns.Count == 0 ? 0 : List.Hymns.Max(h => h.SortOrder)) + 1;
            List.Hymns.Add(new BoardHymnDoc
            {
                Id = Guid.NewGuid().ToString("N")[..10],
                IsSection = true,
                SectionName = sectionName.Trim(),
                SortOrder = next
            });
            await BoardService.UpdateListAsync(GroupId, List);
            showSection = false;
            sectionName = "";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    async Task Remove(BoardHymnDoc entry)
    {
        if (List == null) return;
        List.Hymns = List.Hymns.Where(h => h.Id != entry.Id).ToList();
        await BoardService.UpdateListAsync(GroupId, List);
    }

    public void Dispose() => sub?.Dispose();
}
