    string DragClass(string? id) =>
        !string.IsNullOrEmpty(id) && id == dragEntryId ? "is-dragging" : "";

    string DropLineClass(string id, bool below) =>
        dropLineEntryId == id && dropLineBelow == below ? "is-active" : "";

    async Task BeginBoardPointerDrag(PointerEventArgs e, BoardHymnDoc entry)
    {
        if (e.Button != 0 && e.PointerType == "mouse")
            return;

        dragEntryId = entry.Id;
        dropLineEntryId = null;
        dropLineBelow = false;
        suppressNextClick = true;
        dragDotNetRef ??= DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("mobihymnBoardDrag.begin", dragDotNetRef, entry.Id, e.ClientX, e.ClientY);
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnBoardPointerDragOver(string? targetId, bool preferBelow)
    {
        if (string.IsNullOrEmpty(dragEntryId) || ActiveList == null)
            return;

        var source = ActiveList.Hymns.FirstOrDefault(h => h.Id == dragEntryId);
        if (source == null)
        {
            ClearDropLine();
            return;
        }

        if (string.IsNullOrEmpty(targetId) || targetId == source.Id)
        {
            ClearDropLine();
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        var target = ActiveList.Hymns.FirstOrDefault(h => h.Id == targetId);
        if (target == null)
        {
            ClearDropLine();
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        var indicator = ResolveDropIndicator(source, target, preferBelow, out var below);
        if (indicator == null)
        {
            ClearDropLine();
        }
        else
        {
            dropLineEntryId = indicator.Id;
            dropLineBelow = below;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnBoardPointerDragEnd(string? targetId, bool preferBelow)
    {
        if (ActiveGroup == null || ActiveList == null || string.IsNullOrEmpty(dragEntryId))
        {
            dragEntryId = null;
            ClearDropLine();
            await InvokeAsync(StateHasChanged);
            return;
        }

        var source = ActiveList.Hymns.FirstOrDefault(h => h.Id == dragEntryId);

        // Prefer the last resolved indicator so the drop matches the yellow line.
        BoardHymnDoc? target = null;
        var below = dropLineBelow;
        if (!string.IsNullOrEmpty(dropLineEntryId))
        {
            target = ActiveList.Hymns.FirstOrDefault(h => h.Id == dropLineEntryId);
        }
        else if (!string.IsNullOrEmpty(targetId))
        {
            target = ActiveList.Hymns.FirstOrDefault(h => h.Id == targetId);
            if (source != null && target != null)
                ResolveDropIndicator(source, target, preferBelow, out below);
        }

        dragEntryId = null;
        ClearDropLine();

        if (source == null || target == null || source.Id == target.Id)
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        MoveEntry(source, target, below);
        RenumberBoard();
        RebuildBoardDisplayRows();
        Busy = true;
        try
        {
            await BoardService.UpdateListAsync(ActiveGroup.Id, ActiveList);
            if (sectionSortMode != "AddedOrder" && source.IsSection)
                sectionSortMode = "AddedOrder";
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    void ClearDropLine()
    {
        dropLineEntryId = null;
        dropLineBelow = false;
    }

    BoardHymnDoc? ResolveDropIndicator(BoardHymnDoc source, BoardHymnDoc target, bool preferBelow, out bool below)
    {
        below = preferBelow;
        if (ActiveList == null) return null;
        var hymns = ActiveList.Hymns;
        var sourceIndex = hymns.FindIndex(h => h.Id == source.Id);
        var targetIndex = hymns.FindIndex(h => h.Id == target.Id);
        if (sourceIndex < 0 || targetIndex < 0) return null;

        // Sections only reorder at section boundaries — never between a header and its hymns.
        if (source.IsSection)
        {
            var sourceBlock = GetSectionBlock(hymns, source);
            if (sourceBlock.Any(h => h.Id == target.Id))
                return null;

            var boundary = ResolveSectionBoundaryTarget(target, preferBelow, out below);
            return boundary;
        }

        if (target.IsSection)
        {
            // Hymn onto section: top half = above header, bottom half = first under header.
            below = preferBelow;
            return target;
        }

        below = preferBelow;
        return target;
    }

    /// <summary>
    /// Maps a hover target to a section-boundary drop: above a section header, or after
    /// its last visible item — never inside the section under the header.
    /// </summary>
    BoardHymnDoc? ResolveSectionBoundaryTarget(BoardHymnDoc target, bool preferBelow, out bool below)
    {
        below = preferBelow;
        if (ActiveList == null) return null;

        var owningSection = target.IsSection ? target : FindOwningSection(target);
        if (owningSection == null)
        {
            // Unsectioned hymns: allow placing the section relative to that hymn.
            below = preferBelow;
            return target;
        }

        if (target.IsSection && !preferBelow)
        {
            below = false;
            return owningSection;
        }

        // Bottom half of header, or any hymn in the section → after the whole block.
        var last = LastVisibleInSectionBlock(owningSection);
        below = true;
        return last;
    }

    BoardHymnDoc? FindOwningSection(BoardHymnDoc entry)
    {
        if (ActiveList == null || entry.IsSection) return entry.IsSection ? entry : null;
        var hymns = ActiveList.Hymns;
        var idx = hymns.FindIndex(h => h.Id == entry.Id);
        if (idx < 0) return null;
        for (var i = idx; i >= 0; i--)
        {
            if (hymns[i].IsSection)
                return hymns[i];
        }
        return null;
    }

    BoardHymnDoc LastVisibleInSectionBlock(BoardHymnDoc section)
    {
        var group = BoardGroups.FirstOrDefault(g => g.Section?.Id == section.Id || g.Key == section.Id);
        if (group == null || group.IsCollapsed || group.Hymns.Count == 0)
            return section;
        return group.Hymns[^1];
    }

    void MoveEntry(BoardHymnDoc source, BoardHymnDoc target, bool below)
    {
        if (ActiveList == null) return;
        if (source.IsSection)
        {
            MoveSectionBlock(source, target, below);
            return;
        }

        var hymns = ActiveList.Hymns;
        var sourceIndex = hymns.FindIndex(h => h.Id == source.Id);
        var targetIndex = hymns.FindIndex(h => h.Id == target.Id);
        if (sourceIndex < 0 || targetIndex < 0) return;

        int insertIndex;
        if (target.IsSection)
        {
            var group = BoardGroups.FirstOrDefault(g => g.Key == target.Id);
            if (group != null)
            {
                group.IsCollapsed = false;
                collapsedSections.Remove(target.Id);
            }

            // Above header = before section; under header = first hymn in section.
            insertIndex = below ? targetIndex + 1 : targetIndex;
        }
        else
        {
            insertIndex = below ? targetIndex + 1 : targetIndex;
        }

        hymns.RemoveAt(sourceIndex);
        if (sourceIndex < insertIndex)
            insertIndex--;

        insertIndex = Math.Clamp(insertIndex, 0, hymns.Count);
        hymns.Insert(insertIndex, source);
    }

    void MoveSectionBlock(BoardHymnDoc section, BoardHymnDoc target, bool below)
    {
        if (ActiveList == null) return;
        var hymns = ActiveList.Hymns;
        var sourceIndex = hymns.FindIndex(h => h.Id == section.Id);
        var targetIndex = hymns.FindIndex(h => h.Id == target.Id);
        if (sourceIndex < 0 || targetIndex < 0) return;

        var block = GetSectionBlock(hymns, section);
        if (block.Count == 0) return;

        var blockEnd = sourceIndex + block.Count - 1;
        if (targetIndex >= sourceIndex && targetIndex <= blockEnd)
            return;

        // Snap insert to a section boundary when the indicator landed on a hymn/section.
        int insertIndex;
        var owningSection = target.IsSection ? target : FindOwningSection(target);
        if (owningSection != null)
        {
            var ownerIndex = hymns.FindIndex(h => h.Id == owningSection.Id);
            if (ownerIndex < 0) return;

            if (!below && target.IsSection && target.Id == owningSection.Id)
            {
                insertIndex = ownerIndex;
            }
            else
            {
                var targetBlock = GetSectionBlock(hymns, owningSection);
                insertIndex = ownerIndex + targetBlock.Count;
            }
        }
        else
        {
            insertIndex = below ? targetIndex + 1 : targetIndex;
        }

        foreach (var item in block)
            hymns.Remove(item);

        if (sourceIndex < insertIndex)
            insertIndex -= block.Count;

        insertIndex = Math.Clamp(insertIndex, 0, hymns.Count);
        hymns.InsertRange(insertIndex, block);
    }

    static List<BoardHymnDoc> GetSectionBlock(IList<BoardHymnDoc> entries, BoardHymnDoc section)
    {
        var index = -1;
        for (var i = 0; i < entries.Count; i++)
        {
            if (entries[i].Id == section.Id)
            {
                index = i;
                break;
            }
        }

        if (index < 0) return new List<BoardHymnDoc>();

        var block = new List<BoardHymnDoc>();
        for (var i = index; i < entries.Count; i++)
        {
            if (i > index && entries[i].IsSection)
                break;
            block.Add(entries[i]);
        }

        return block;
    }

    void RenumberBoard()
    {
        if (ActiveList == null) return;
        for (var i = 0; i < ActiveList.Hymns.Count; i++)
            ActiveList.Hymns[i].SortOrder = i + 1;
    }

    string FirstLineFor(BoardHymnDoc hymn)
    {
        var number = hymn.HymnNumber?.Trim() ?? "";
        if (number.Length == 0) return "";
        return firstLineCache.TryGetValue(number, out var line) ? line : "";
    }

    async Task ResolveFirstLinesAsync()
    {
        if (ActiveList == null) return;
        var numbers = ActiveList.Hymns
            .Where(h => !h.IsSection && !string.IsNullOrWhiteSpace(h.HymnNumber))
            .Select(h => h.HymnNumber!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(n => !firstLineCache.ContainsKey(n))
            .ToList();

        foreach (var number in numbers)
        {
            try
            {
                var hymn = await Lyrics.GetHymnAsync(number);
                firstLineCache[number] = hymn.FirstLine?.Trim() ?? "";
            }
            catch
            {
                firstLineCache[number] = "";
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    static string FormatAddedAt(DateTimeOffset when)
    {
        var local = when.ToLocalTime();
        var now = DateTimeOffset.Now;
        if (local.Date == now.Date)
            return local.ToString("h:mm tt");
        if (local.Year == now.Year)
            return local.ToString("MMM d");
        return local.ToString("MMM d, yyyy");
    }

