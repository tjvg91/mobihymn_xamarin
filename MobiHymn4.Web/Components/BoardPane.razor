    void OnSwipePointerDown(BoardListDoc list, PointerEventArgs e)
    {
        if (e.Button != 0 && e.PointerType == "mouse")
            return;

        CloseOpenHymnSwipe();
        CloseOpenSectionSwipe();
        swipePointerId = e.PointerId;
        swipeDragListId = list.Id;
        swipeStartX = e.ClientX;
        swipeStartY = e.ClientY;
        swipeStartOffset = string.Equals(swipedListId, list.Id, StringComparison.Ordinal) ? -SwipeActionsWidth : 0;
        swipeDragX = swipeStartOffset;
        swipeMoved = false;
        swipeAxisLocked = false;
        swipeHorizontal = false;
    }

    void OnSwipePointerMove(BoardListDoc list, PointerEventArgs e)
    {
        if (swipePointerId != e.PointerId || !string.Equals(swipeDragListId, list.Id, StringComparison.Ordinal))
            return;

        var dx = e.ClientX - swipeStartX;
        var dy = e.ClientY - swipeStartY;

        if (!swipeAxisLocked && (Math.Abs(dx) > 8 || Math.Abs(dy) > 8))
        {
            swipeAxisLocked = true;
            swipeHorizontal = Math.Abs(dx) >= Math.Abs(dy);
            if (!swipeHorizontal)
            {
                swipeDragListId = null;
                swipePointerId = null;
                return;
            }
        }

        if (!swipeHorizontal)
            return;

        if (Math.Abs(dx) > 6)
            swipeMoved = true;

        var next = Math.Clamp(swipeStartOffset + dx, -SwipeActionsWidth, 0);
        swipeDragX = next;

        if (swipedListId != null && !string.Equals(swipedListId, list.Id, StringComparison.Ordinal))
            swipedListId = null;
    }

    void OnSwipePointerUp(BoardListDoc list, PointerEventArgs e)
    {
        if (swipePointerId != e.PointerId)
            return;

        var wasDraggingThis = string.Equals(swipeDragListId, list.Id, StringComparison.Ordinal);
        swipePointerId = null;
        swipeDragListId = null;

        if (!wasDraggingThis)
            return;

        if (swipeMoved && swipeHorizontal)
        {
            suppressListClick = true;
            var open = swipeDragX <= -SwipeActionsWidth * 0.4;
            swipedListId = open ? list.Id : null;
            swipeDragX = open ? -SwipeActionsWidth : 0;
        }
        else if (string.Equals(swipedListId, list.Id, StringComparison.Ordinal))
        {
            // Tap on an already-open card closes swipe instead of opening the list.
            suppressListClick = true;
            CloseOpenSwipe();
        }
    }

    void OnListCardClick(BoardListDoc list)
    {
        if (suppressListClick)
        {
            suppressListClick = false;
            return;
        }

        if (swipedListId != null && !string.Equals(swipedListId, list.Id, StringComparison.Ordinal))
        {
            CloseOpenSwipe();
            return;
        }

        if (string.Equals(swipedListId, list.Id, StringComparison.Ordinal))
        {
            CloseOpenSwipe();
            return;
        }

        OpenList(list);
    }

