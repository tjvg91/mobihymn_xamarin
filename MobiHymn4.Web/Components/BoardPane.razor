    async Task ConfirmAddHymn()
    {
        addHymnError = null;
        await EnsureAddHymnCatalogAsync();

        var resolved = await ResolveAddHymnSelectionAsync();
        if (resolved == null)
            return;

        var ok = await AddHymnToListAsync(
            resolved.Value.Number,
            addHymnNotes?.Trim() ?? "",
            firstLine: resolved.Value.Line,
            panelError: true);
        if (ok)
            CloseAddHymn();
    }

    async Task<(string Number, string? Line)?> ResolveAddHymnSelectionAsync()
    {
        if (!string.IsNullOrWhiteSpace(addHymnPickedNumber))
            return (addHymnPickedNumber!.Trim(), addHymnPickedLine);

        var query = (addHymnQuery ?? "").Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            addHymnError = "Enter a hymn number or line.";
            return null;
        }

        if (IsNumberQuery(query))
        {
            var prefix = ExtractNumberPrefix(query);
            if (!string.IsNullOrEmpty(prefix))
            {
                var exact = addHymnCatalog.FirstOrDefault(h =>
                    string.Equals(h.Number, prefix, StringComparison.OrdinalIgnoreCase));
                if (exact != null)
                    return (exact.Number, exact.FirstLine ?? exact.Title);

                var matches = BuildNumberSuggestions(query, addHymnCatalog, maxCount: 2);
                if (matches.Count == 1)
                    return (matches[0].Number, matches[0].Line);
            }

            addHymnError = "Hymn not found.";
            return null;
        }

        try
        {
            var hits = await Lyrics.SearchLyricsAsync(query);
            if (hits.Count == 1)
                return (hits[0].Number, hits[0].Line);
            if (hits.Count == 0)
            {
                addHymnError = "No matching hymn. Pick one from the list or refine your search.";
                return null;
            }
        }
        catch
        {
            var fallback = BuildCatalogLineSuggestions(query, addHymnCatalog, maxCount: 2);
            if (fallback.Count == 1)
                return (fallback[0].Number, fallback[0].Line);
        }

        addHymnError = "No matching hymn. Pick one from the list or refine your search.";
        return null;
    }

    static List<BoardHymnSuggestion> BuildNumberSuggestions(
        string query,
        IReadOnlyList<HymnCatalogEntry> hymns,
        int maxCount = 8)
    {
        if (hymns == null || hymns.Count == 0 || string.IsNullOrWhiteSpace(query))
            return new();

        var prefix = ExtractNumberPrefix(query.Trim());
        if (string.IsNullOrEmpty(prefix))
            return new();

        return hymns
            .Where(h => !string.IsNullOrEmpty(h.Number) &&
                h.Number.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            .OrderBy(h => HymnNumberSortKey(h.Number))
            .Select(h => new BoardHymnSuggestion
            {
                Number = h.Number,
                Line = h.FirstLine ?? h.Title ?? "",
                LineFirst = false,
            })
            .Take(maxCount)
            .ToList();
    }

    static List<BoardHymnSuggestion> BuildCatalogLineSuggestions(
        string query,
        IReadOnlyList<HymnCatalogEntry> hymns,
        int maxCount = 8)
    {
        if (hymns == null || hymns.Count == 0 || string.IsNullOrWhiteSpace(query))
            return new();

        var stripped = NormalizeSuggestionText(query.Trim());
        if (stripped.Length < 2)
            return new();

        return hymns
            .Select(h =>
            {
                var line = !string.IsNullOrWhiteSpace(h.FirstLine) ? h.FirstLine!.Trim()
                    : !string.IsNullOrWhiteSpace(h.Title) ? h.Title!.Trim()
                    : "";
                return (Entry: h, Line: line);
            })
            .Where(x => !string.IsNullOrWhiteSpace(x.Line)
                && NormalizeSuggestionText(x.Line).Contains(stripped, StringComparison.OrdinalIgnoreCase))
            .OrderBy(x => NormalizeSuggestionText(x.Line), StringComparer.OrdinalIgnoreCase)
            .ThenBy(x => HymnNumberSortKey(x.Entry.Number))
            .GroupBy(x => (
                Line: NormalizeSuggestionText(x.Line).ToLowerInvariant(),
                Number: (x.Entry.Number ?? "").ToLowerInvariant()))
            .Select(g => g.First())
            .Take(maxCount)
            .Select(x => new BoardHymnSuggestion
            {
                Number = x.Entry.Number,
                Line = x.Line,
                LineFirst = true,
            })
            .ToList();
    }

    static bool IsNumberQuery(string query) =>
        !string.IsNullOrWhiteSpace(query) && char.IsDigit(query.Trim()[0]);

    static string ExtractNumberPrefix(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";

        var match = System.Text.RegularExpressions.Regex.Match(
            text.Trim(),
            @"^(\d+)([fst]?)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success || string.IsNullOrEmpty(match.Groups[1].Value))
            return "";

        return (match.Groups[1].Value + match.Groups[2].Value).ToLowerInvariant();
    }

    static string NormalizeSuggestionText(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return "";
        var chars = text.Where(c => !char.IsPunctuation(c)).ToArray();
        return System.Text.RegularExpressions.Regex.Replace(new string(chars).Trim(), @"\s+", " ");
    }

    static double HymnNumberSortKey(string number)
    {
        if (string.IsNullOrWhiteSpace(number))
            return double.MaxValue;

        var normalized = number
            .Replace("f", ".4", StringComparison.OrdinalIgnoreCase)
            .Replace("s", ".2", StringComparison.OrdinalIgnoreCase)
            .Replace("t", ".3", StringComparison.OrdinalIgnoreCase);
        return double.TryParse(normalized, out var value) ? value : double.MaxValue;
    }

    sealed class BoardHymnSuggestion
    {
        public string Number { get; set; } = "";
        public string Line { get; set; } = "";
        public bool LineFirst { get; set; }
    }

    async Task ConfirmAddSection()
    {
        if (ActiveGroup == null || ActiveList == null)
            return;

        var name = (addSectionName ?? "").Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            addSectionError = "Enter a section name.";
            return;
        }

        if (ActiveList.Hymns.Any(h =>
                h.IsSection &&
                string.Equals(h.SectionName?.Trim(), name, StringComparison.OrdinalIgnoreCase)))
        {
            addSectionError = "A section with that name already exists.";
            return;
        }

        Busy = true;
        addSectionError = null;
        Error = null;
        try
        {
            await Profiles.RefreshCurrentProfileAsync();
            var actor = ActorDisplayName();
            var next = (ActiveList.Hymns.Count == 0 ? 0 : ActiveList.Hymns.Max(h => h.SortOrder)) + 1;
            ActiveList.Hymns.Add(new BoardHymnDoc
            {
                Id = Guid.NewGuid().ToString("N")[..10],
                IsSection = true,
                SectionName = name,
                SortOrder = next,
                AddedBy = Auth.CurrentUserId,
                AddedByName = actor,
                UpdatedAt = DateTimeOffset.UtcNow
            });
            await BoardService.UpdateListAsync(ActiveGroup.Id, ActiveList);

            if (!addSectionThisListOnly)
            {
                await BoardService.SaveSectionToTemplateAsync(ActiveGroup.Id, ActiveList.Id, name);
                savedSectionNames.Add(name);
                State.ShowToast("/lottie/done.gif", "Section saved for all dates.");
            }
            else
            {
                State.ShowToast("/lottie/done.gif", "Section added.");
            }

            RebuildBoardDisplayRows();
            CloseAddSection();
        }
        catch (Exception ex)
        {
            addSectionError = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    string ActorDisplayName()
    {
        var profile = Profiles.CurrentProfile;
        if (!string.IsNullOrWhiteSpace(profile?.Nickname))
            return profile!.Nickname.Trim();
        if (!string.IsNullOrWhiteSpace(profile?.DisplayName))
            return profile!.DisplayName.Trim();
        return Auth.CurrentEmail ?? "";
    }

    async Task<bool> AddHymnToListAsync(string number, string notes, string? firstLine, bool panelError = false)
    {
        if (ActiveGroup == null || ActiveList == null)
            return false;

        if (ActiveList.Hymns.Any(h =>
                !h.IsSection &&
                string.Equals(h.HymnNumber, number, StringComparison.OrdinalIgnoreCase)))
        {
            var msg = $"Hymn #{number} is already on this list.";
            if (panelError)
                addHymnError = msg;
            else
                Status = msg;
            return false;
        }

        Busy = true;
        Status = null;
        Error = null;
        try
        {
            // Soft-validate against catalog when possible.
            try
            {
                var found = await Lyrics.GetHymnAsync(number);
                if (string.IsNullOrWhiteSpace(firstLine) && !string.IsNullOrWhiteSpace(found.FirstLine))
                    firstLine = found.FirstLine;
                if (!string.IsNullOrWhiteSpace(found.Number))
                    number = found.Number.Trim();
            }
            catch (ArgumentException)
            {
                var msg = "Invalid hymn number.";
                if (panelError)
                    addHymnError = msg;
                else
                    Error = msg;
                return false;
            }
            catch
            {
                if (panelError && string.IsNullOrWhiteSpace(firstLine))
                {
                    addHymnError = "Hymn not found.";
                    return false;
                }
                // Offline / already-known active hymn — still allow add by number.
            }

            await Profiles.RefreshCurrentProfileAsync();
            var actor = ActorDisplayName();

            // Place new hymns before the first section (MAUI parity).
            var firstSectionIndex = ActiveList.Hymns.FindIndex(h => h.IsSection);
            var entry = new BoardHymnDoc
            {
                Id = Guid.NewGuid().ToString("N")[..10],
                HymnNumber = number,
                Notes = notes,
                SortOrder = 0,
                AddedBy = Auth.CurrentUserId,
                AddedByName = actor,
                UpdatedAt = DateTimeOffset.UtcNow
            };
            if (firstSectionIndex < 0)
                ActiveList.Hymns.Add(entry);
            else
                ActiveList.Hymns.Insert(firstSectionIndex, entry);

            RenumberBoard();
            if (!string.IsNullOrWhiteSpace(firstLine))
                firstLineCache[number] = firstLine.Trim();

            await BoardService.UpdateListAsync(ActiveGroup.Id, ActiveList);
            RebuildBoardDisplayRows();
            State.ShowToast("/lottie/done.gif", "Added to board.");
            return true;
        }
        catch (Exception ex)
        {
            if (panelError)
                addHymnError = ex.Message;
            else
                Error = ex.Message;
            return false;
        }
        finally
        {
            Busy = false;
        }
    }

