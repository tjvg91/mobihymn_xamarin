    void SetRoleFilter(string role)
    {
        memberRoleFilter = role == "All" ? null : role;
        RefreshMemberPresentation();
    }

    void SetMembersGrouped(bool grouped)
    {
        membersGroupByRole = grouped;
        RefreshMemberPresentation();
    }

    void RefreshMemberPresentation()
    {
        var filtered = FilterMembers(Members).ToList();
        var rows = new List<MemberRow>();

        if (membersGroupByRole)
        {
            if (string.Equals(memberRoleFilter, "Admin", StringComparison.OrdinalIgnoreCase))
            {
                var admins = filtered
                    .Where(m => m.IsAdmin)
                    .OrderBy(m => DisplayName(m), StringComparer.OrdinalIgnoreCase)
                    .ToList();
                if (admins.Count > 0)
                {
                    rows.Add(new MemberRow { IsHeader = true, Header = "Admin" });
                    rows.AddRange(admins.Select(m => new MemberRow { Member = m }));
                }
            }
            else
            {
                foreach (var role in RoleOrder)
                {
                    if (!string.IsNullOrEmpty(memberRoleFilter) &&
                        !role.Equals(memberRoleFilter, StringComparison.OrdinalIgnoreCase))
                        continue;

                    var section = filtered
                        .Where(m => HasRole(m, role))
                        .OrderBy(m => DisplayName(m), StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    if (section.Count == 0) continue;
                    rows.Add(new MemberRow { IsHeader = true, Header = role });
                    rows.AddRange(section.Select(m => new MemberRow { Member = m }));
                }

                if (string.IsNullOrEmpty(memberRoleFilter))
                {
                    var other = filtered
                        .Where(m => !RoleOrder.Any(r => HasRole(m, r)))
                        .OrderBy(m => DisplayName(m), StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    if (other.Count > 0)
                    {
                        rows.Add(new MemberRow { IsHeader = true, Header = "Members" });
                        rows.AddRange(other.Select(m => new MemberRow { Member = m }));
                    }
                }
            }
        }
        else
        {
            rows.AddRange(filtered
                .OrderBy(m => DisplayName(m), StringComparer.OrdinalIgnoreCase)
                .Select(m => new MemberRow { Member = m }));
        }

        DisplayedMemberRows = rows;
    }

    IEnumerable<GroupMemberDoc> FilterMembers(IEnumerable<GroupMemberDoc> source)
    {
        var filtered = source;
        if (!string.IsNullOrEmpty(memberRoleFilter))
        {
            if (string.Equals(memberRoleFilter, "Admin", StringComparison.OrdinalIgnoreCase))
                filtered = filtered.Where(m => m.IsAdmin);
            else
                filtered = filtered.Where(m => HasRole(m, memberRoleFilter));
        }

        if (string.IsNullOrWhiteSpace(memberSearch))
            return filtered;

        var tokens = memberSearch.Trim().Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        return filtered.Where(m =>
        {
            var hay = $"{m.FirstName} {m.LastName} {m.Nickname} {m.Email}";
            return tokens.All(t => hay.Contains(t, StringComparison.OrdinalIgnoreCase));
        });
    }

    static bool HasRole(GroupMemberDoc member, string roleLabel)
    {
        if (string.Equals(roleLabel, "Admin", StringComparison.OrdinalIgnoreCase))
            return member.IsAdmin;
        if (member.Roles == null || member.Roles.Count == 0) return false;
        return member.Roles.Any(r => RoleMatches(r, roleLabel));
    }

    static bool RoleMatches(string raw, string label)
    {
        var n = NormalizeRole(raw);
        return n.Equals(NormalizeRole(label), StringComparison.OrdinalIgnoreCase);
    }

    static string NormalizeRole(string raw) =>
        (raw ?? "").Trim().ToLowerInvariant() switch
        {
            "pastor" or "preacher" => "preacher",
            "worshipleader" or "worship leader" => "worship leader",
            "projector" => "projector",
            "accompaniment" => "accompaniment",
            _ => (raw ?? "").Trim().ToLowerInvariant()
        };

    static string DisplayName(GroupMemberDoc m)
    {
        if (!string.IsNullOrWhiteSpace(m.Nickname)) return m.Nickname.Trim();
        var full = $"{m.FirstName} {m.LastName}".Trim();
        if (!string.IsNullOrWhiteSpace(full)) return full;
        if (!string.IsNullOrWhiteSpace(m.Email)) return m.Email.Trim();
        return "Member";
    }

    string MemberListName(GroupMemberDoc m) =>
        string.Equals(m.Id, Auth.CurrentUserId, StringComparison.Ordinal)
            ? "You"
            : DisplayName(m);

    static string Initials(GroupMemberDoc m)
    {
        var first = m.FirstName?.Trim() ?? "";
        var last = m.LastName?.Trim() ?? "";
        if (first.Length > 0 && last.Length > 0)
            return $"{char.ToUpperInvariant(first[0])}{char.ToUpperInvariant(last[0])}";
        if (first.Length > 0)
            return first.Length >= 2
                ? first[..2].ToUpperInvariant()
                : char.ToUpperInvariant(first[0]).ToString();
        if (last.Length > 0)
            return last.Length >= 2
                ? last[..2].ToUpperInvariant()
                : char.ToUpperInvariant(last[0]).ToString();

        var fallback = DisplayName(m);
        var parts = fallback.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
        if (parts.Length == 1 && parts[0].Length >= 2)
            return parts[0][..2].ToUpperInvariant();
        if (parts.Length == 1)
            return char.ToUpperInvariant(parts[0][0]).ToString();
        return "?";
    }

    static string RolesSummary(GroupMemberDoc m)
    {
        var labels = new List<string>();
        if (m.IsAdmin)
            labels.Add("Admin");
        if (m.Roles != null)
        {
            labels.AddRange(m.Roles
                .Select(PrettyRole)
                .Where(r => !string.IsNullOrWhiteSpace(r)));
        }

        return string.Join(", ", labels.Distinct(StringComparer.OrdinalIgnoreCase));
    }

    static string PrettyRole(string raw) =>
        NormalizeRole(raw) switch
        {
            "preacher" => "Preacher",
            "worship leader" => "Worship Leader",
            "projector" => "Projector",
            "accompaniment" => "Accompaniment",
            _ => string.IsNullOrWhiteSpace(raw) ? "" : raw.Trim()
        };

    static string AvatarStyle(GroupMemberDoc m)
    {
        var (fg, bg) = AvatarColors(m);
        return $"color:{fg};background:{bg};border-color:{fg}";
    }

    static (string Fg, string Bg) AvatarColors(GroupMemberDoc m)
    {
        if (m.IsAdmin) return ("#0F766E", "rgba(15,118,110,.15)");
        if (HasRole(m, "Preacher")) return ("#B8860B", "rgba(184,134,11,.15)");
        if (HasRole(m, "Worship Leader")) return ("#2563EB", "rgba(37,99,235,.15)");
        if (HasRole(m, "Projector")) return ("#6B7280", "rgba(107,114,128,.15)");
        if (HasRole(m, "Accompaniment")) return ("#8B5CF6", "rgba(139,92,246,.15)");
        return ("#2563EB", "rgba(37,99,235,.15)");
    }

