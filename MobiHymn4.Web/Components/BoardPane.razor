@code {
    enum View { Groups, Lists, ListDetail, Members }
    enum BoardConfirmAction { None, ClearHymns, ClearSections, ClearSavedSections }

    static readonly string[] BoardOptionsMenu =
    [
        "Sort sections",
        "Clear all hymns in this list",
        "Clear all sections in this list",
        "Clear all saved sections",
    ];

    static readonly (string Mode, string Label)[] SortModes =
    [
        ("AddedOrder", "Order added"),
        ("DateNewest", "Date (newest first)"),
        ("DateOldest", "Date (oldest first)"),
        ("NameAsc", "Name (A–Z)"),
        ("NameDesc", "Name (Z–A)"),
    ];

    sealed class MemberRow
    {
        public bool IsHeader { get; init; }
        public string? Header { get; init; }
        public GroupMemberDoc? Member { get; init; }
    }

    sealed class BoardSectionGroup
    {
        public string Key { get; init; } = "";
        public BoardHymnDoc? Section { get; init; }
        public List<BoardHymnDoc> Hymns { get; init; } = new();
        public bool IsCollapsed { get; set; }
    }

    static readonly string[] RoleFilters =
    [
        "All", "Admin", "Preacher", "Worship Leader", "Projector", "Accompaniment"
    ];

    static readonly string[] RoleOrder =
    [
        "Preacher", "Worship Leader", "Projector", "Accompaniment"
    ];

    const int CloseMs = 220;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    bool show;
    bool animOpen;
    bool closing;
    bool Busy;
    bool showCreateList;
    bool showGroupMenu;
    bool showBoardOptions;
    bool showSortMenu;
    bool showLeaveConfirm;
    bool showRemoveMemberConfirm;
    bool showRemoveAdminConfirm;
    bool showMemberMenu;
    bool showBoardConfirm;
    bool showDeleteListConfirm;
    bool showDeleteHymnConfirm;
    bool showEditHymn;
    bool showAddHymn;
    bool showAddSection;
    bool fabMenuOpen;
    bool addSectionThisListOnly = true;
    bool showRemoveSection;
    bool removeDeleteHymns;
    bool removeCurrentDateOnly = true;
    bool removeSectionIsSaved;
    int removeSectionHymnCount;
    bool membersGroupByRole;
    bool currentUserIsGroupAdmin;
    bool listsEnterAnim;
    bool hymnsEnterAnim;
    bool membersEnterAnim;
    int listsEnterAnimToken;
    int hymnsEnterAnimToken;
    int membersEnterAnimToken;
    string? Error;
    string? Status;
    string? createListError;
    string deleteListConfirmMessage = "";
    string deleteHymnConfirmMessage = "";
    string removeMemberConfirmMessage = "";
    string removeAdminConfirmMessage = "";
    GroupMemberDoc? pendingRemoveMember;
    GroupMemberDoc? pendingRemoveAdmin;
    GroupMemberDoc? memberMenuTarget;
    List<string> memberMenuOptions = new();
    string editHymnNumber = "";
    string editHymnNotes = "";
    string? editHymnError;
    string addHymnQuery = "";
    string addHymnNotes = "";
    string? addHymnError;
    string? addHymnPickedNumber;
    string? addHymnPickedLine;
    string addSectionName = "";
    string? addSectionError;
    List<BoardHymnSuggestion> addHymnSuggestions = new();
    List<HymnCatalogEntry> addHymnCatalog = new();
    CancellationTokenSource? addHymnSuggestCts;
    const int AddHymnSuggestDebounceMs = 180;
    BoardListDoc? editingList;
    BoardListDoc? pendingDeleteList;
    BoardHymnDoc? pendingDeleteHymn;
    BoardHymnDoc? pendingRemoveSection;
    BoardHymnDoc? editingHymn;
    DateTime newListDate = DateTime.Today;
    DateTime createListMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    const double SwipeActionsWidth = 116;
    string? swipedListId;
    string? swipeDragListId;
    double swipeStartX;
    double swipeStartY;
    double swipeStartOffset;
    double swipeDragX;
    bool swipeMoved;
    bool swipeAxisLocked;
    bool swipeHorizontal;
    bool suppressListClick;
    long? swipePointerId;

    string? swipedHymnId;
    string? swipeHymnDragId;
    double swipeHymnStartX;
    double swipeHymnStartY;
    double swipeHymnStartOffset;
    double swipeHymnDragX;
    bool swipeHymnMoved;
    bool swipeHymnAxisLocked;
    bool swipeHymnHorizontal;
    bool suppressHymnClick;
    long? swipeHymnPointerId;

    string? swipedSectionId;
    string? swipeSectionDragId;
    double swipeSectionStartX;
    double swipeSectionStartY;
    double swipeSectionStartOffset;
    double swipeSectionDragX;
    bool swipeSectionMoved;
    bool swipeSectionAxisLocked;
    bool swipeSectionHorizontal;
    bool suppressSectionClick;
    long? swipeSectionPointerId;
    string createListMonthTitle => createListMonth.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    IEnumerable<DateTime?> CreateListCalendarDays
    {
        get
        {
            var first = createListMonth;
            var startPad = (int)first.DayOfWeek; // Sunday = 0
            var daysInMonth = DateTime.DaysInMonth(first.Year, first.Month);
            for (var i = 0; i < startPad; i++)
                yield return null;
            for (var d = 1; d <= daysInMonth; d++)
                yield return new DateTime(first.Year, first.Month, d);
        }
    }
    string memberSearch = "";
    string? memberRoleFilter;
    string sectionSortMode = "AddedOrder";
    string boardConfirmTitle = "";
    string boardConfirmMessage = "";
    BoardConfirmAction pendingBoardAction = BoardConfirmAction.None;
    View view = View.Groups;

    List<WorshipGroupDoc> Groups = new();
    List<BoardListDoc> Lists = new();
    List<GroupMemberDoc> Members = new();
    List<MemberRow> DisplayedMemberRows = new();
    List<BoardSectionGroup> BoardGroups = new();
    List<string> groupMenuOptions = new();
    List<string> boardOptionsMenu = BoardOptionsMenu.ToList();
    List<string> sortMenuOptions = new();
    readonly HashSet<string> collapsedSections = new(StringComparer.Ordinal);
    readonly HashSet<string> savedSectionNames = new(StringComparer.OrdinalIgnoreCase);
    readonly Dictionary<string, string> firstLineCache = new(StringComparer.OrdinalIgnoreCase);
    WorshipGroupDoc? ActiveGroup;
    BoardListDoc? ActiveList;
    IDisposable? listSub;
    DotNetObjectReference<BoardPane>? dragDotNetRef;
    string? dragEntryId;
    string? dropLineEntryId;
    bool dropLineBelow;
    bool suppressNextClick;

    bool HasActiveHymn => State.ActiveHymn != null && !string.IsNullOrWhiteSpace(State.ActiveHymn.Number);
    bool UseDashboardChrome => Auth.IsSignedIn
        && view is View.Lists or View.ListDetail or View.Members
        && ActiveGroup != null;
    bool CanGoBack => false;

    string ScrollClass => view switch
    {
        View.Lists => "board-pane-body--scroll-lists",
        View.Members => "board-pane-body--scroll-members",
        View.ListDetail => "board-pane-body--scroll-hymns",
        _ => ""
    };

    string memberVirtualKey =>
        $"{membersGroupByRole}|{memberRoleFilter}|{memberSearch}|{DisplayedMemberRows.Count}";

    string HeaderTitle => "Group Board";

    string LeaveConfirmMessage =>
        ActiveGroup == null
            ? "Leave this group? You can rejoin later with the group code or ID."
            : $"Leave {ActiveGroup.Name}? You can rejoin later with the group code or ID.";

    static string HymnCountLabel(BoardListDoc list)
    {
        var n = list.Hymns?.Count(h => !h.IsSection) ?? 0;
        return n == 1 ? "1 hymn" : $"{n} hymns";
    }

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        State.Changed += OnStateChanged;
        BoardUi.UnreadChanged += OnUnreadChanged;
        BoardUi.OpenRequested += OnOpenRequested;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !show && !closing)
        {
            show = true;
            animOpen = false;
            ResetNav();
            await EnterAsync();
            if (Auth.IsSignedIn)
                await LoadGroupsAsync();
        }
        else if (!Visible && show && !closing)
        {
            await ExitAsync(notifyParent: false);
        }
    }

    async Task EnterAsync()
    {
        await Task.Delay(20);
        if (!show || closing) return;
        animOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task ExitAsync(bool notifyParent)
    {
        if (closing) return;
        closing = true;
        animOpen = false;
        showGroupMenu = false;
        showBoardOptions = false;
        showSortMenu = false;
        showLeaveConfirm = false;
        showBoardConfirm = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(CloseMs);
        show = false;
        closing = false;
        listSub?.Dispose();
        listSub = null;
        if (notifyParent || Visible)
            await VisibleChanged.InvokeAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    Task Close() => ExitAsync(notifyParent: true);

    void ResetNav()
    {
        view = View.Groups;
        ActiveGroup = null;
        ActiveList = null;
        Lists = new();
        Members = new();
        DisplayedMemberRows = new();
        BoardGroups = new();
        collapsedSections.Clear();
        memberSearch = "";
        memberRoleFilter = null;
        membersGroupByRole = false;
        Error = null;
        Status = null;
        listSub?.Dispose();
        listSub = null;
    }

    void GoBack()
    {
        Status = null;
        Error = null;
        fabMenuOpen = false;
        showAddSection = false;
        showAddHymn = false;
        if (view == View.ListDetail)
        {
            listSub?.Dispose();
            listSub = null;
            ActiveList = null;
            view = View.Lists;
            TriggerListsEnterAnim();
            return;
        }

        if (view == View.Members)
        {
            BackFromMembers();
            return;
        }

        ActiveGroup = null;
        Lists = new();
        view = View.Groups;
    }

    void BackFromMembers()
    {
        Error = null;
        view = View.Lists;
        TriggerListsEnterAnim();
    }

    void TriggerListsEnterAnim() =>
        TriggerCascadeEnter(ref listsEnterAnim, ref listsEnterAnimToken, Lists.Count, "lists");

    void TriggerHymnsEnterAnim() =>
        TriggerCascadeEnter(ref hymnsEnterAnim, ref hymnsEnterAnimToken, CountVisibleBoardCascadeItems(), "hymns");

    void TriggerMembersEnterAnim() =>
        TriggerCascadeEnter(ref membersEnterAnim, ref membersEnterAnimToken, DisplayedMemberRows.Count, "members");

    void TriggerCascadeEnter(ref bool flag, ref int token, int itemCount, string kind)
    {
        token++;
        var t = token;
        flag = itemCount > 0;
        if (!flag)
            return;
        _ = ClearCascadeEnterKindAsync(kind, t, itemCount);
    }

    async Task ClearCascadeEnterKindAsync(string kind, int token, int itemCount)
    {
        var wait = 320 + Math.Min(Math.Max(itemCount, 1), 24) * 45;
        await Task.Delay(wait);
        var changed = false;
        switch (kind)
        {
            case "lists" when token == listsEnterAnimToken:
                listsEnterAnim = false;
                changed = true;
                break;
            case "hymns" when token == hymnsEnterAnimToken:
                hymnsEnterAnim = false;
                changed = true;
                break;
            case "members" when token == membersEnterAnimToken:
                membersEnterAnim = false;
                changed = true;
                break;
        }
        if (changed)
            await InvokeAsync(StateHasChanged);
    }

    int CountVisibleBoardCascadeItems()
    {
        var n = 0;
        foreach (var group in BoardGroups)
        {
            if (group.Section != null)
                n++;
            if (!group.IsCollapsed)
                n += group.Hymns.Count;
        }
        return n;
    }

    static string EnterDelayStyle(int index)
    {
        if (index < 0)
            return "";
        var ms = index * 45;
        return $"--enter-delay:{ms.ToString(System.Globalization.CultureInfo.InvariantCulture)}ms";
    }

    static string CascadeStyle(double swipeX, int enterIndex)
    {
        var x = swipeX.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        if (enterIndex < 0)
            return $"--swipe-x: {x}px";
        var delay = (enterIndex * 45).ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"--swipe-x: {x}px; --enter-delay:{delay}ms";
    }

    void OpenBoardOptions()
    {
        showBoardOptions = true;
    }

    async Task OnBoardOptionSelected(string action)
    {
        if (ActiveGroup == null || ActiveList == null || string.IsNullOrEmpty(action)) return;
        switch (action)
        {
            case "Sort sections":
                sortMenuOptions = SortModes
                    .Select(m => m.Mode == sectionSortMode ? $"✓ {m.Label}" : m.Label)
                    .ToList();
                showSortMenu = true;
                break;
            case "Clear all hymns in this list":
                pendingBoardAction = BoardConfirmAction.ClearHymns;
                boardConfirmTitle = "Clear all hymns";
                boardConfirmMessage = "Remove every hymn from this list? Unsaved sections will also be removed.";
                showBoardConfirm = true;
                break;
            case "Clear all sections in this list":
                pendingBoardAction = BoardConfirmAction.ClearSections;
                boardConfirmTitle = "Clear all sections";
                boardConfirmMessage = "Remove every section from this list? Saved sections for other lists will remain.";
                showBoardConfirm = true;
                break;
            case "Clear all saved sections":
                pendingBoardAction = BoardConfirmAction.ClearSavedSections;
                boardConfirmTitle = "Clear all saved sections";
                boardConfirmMessage = "Clear saved sections for all lists and remove sections from this list?";
                showBoardConfirm = true;
                break;
        }

        await Task.CompletedTask;
    }

    async Task OnSortOptionSelected(string picked)
    {
        if (ActiveGroup == null || ActiveList == null || string.IsNullOrWhiteSpace(picked)) return;
        var label = picked.StartsWith("✓ ", StringComparison.Ordinal) ? picked[2..] : picked;
        var mode = SortModes.FirstOrDefault(m => m.Label == label).Mode;
        if (string.IsNullOrEmpty(mode)) return;

        Busy = true;
        Error = null;
        try
        {
            sectionSortMode = mode;
            ActiveList = await BoardService.ApplySectionSortAsync(ActiveGroup.Id, ActiveList.Id, mode);
            RebuildBoardDisplayRows();
            var nice = SortModes.First(m => m.Mode == mode).Label.ToLowerInvariant();
            State.ShowToast("/lottie/done.gif", $"Sections sorted by {nice}.");
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

