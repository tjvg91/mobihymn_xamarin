    static DateTime ResolveListDate(BoardListDoc list)
    {
        if (DateTime.TryParseExact(
                list.Id,
                "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out var idDate))
            return idDate.Date;

        if (DateTime.TryParseExact(
                list.Name,
                "MMM d, yyyy",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out var nameDate))
            return nameDate.Date;

        if (list.CreatedAt != default)
            return list.CreatedAt.Date;

        return DateTime.Today;
    }

