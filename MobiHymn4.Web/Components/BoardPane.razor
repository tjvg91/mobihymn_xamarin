@namespace MobiHymn4.Web.Components
@inject IAuthService Auth
@inject IGroupService GroupService
@inject IBoardService BoardService
@inject IBoardNotificationService BoardNotifications
@inject BoardUiState BoardUi
@inject IProfileService Profiles
@inject IHymnLyricsSource Lyrics
@inject AppState State
@inject AuthNavigation AuthNav
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

@if (show)
{
    <div class="board-pane-host @(animOpen ? "is-open" : null)" aria-live="polite">
        <div class="board-pane-dimmer" @onclick="Close"></div>
        <aside class="board-pane @(UseDashboardChrome ? "board-pane--dash" : null)"
               @onclick:stopPropagation="true"
               role="dialog"
               aria-label="Group board">
            @if (!UseDashboardChrome)
            {
                <header class="board-pane-header">
                    @if (CanGoBack)
                    {
                        <button type="button" class="board-pane-icon-btn" title="Back" @onclick="GoBack">
                            <i class="fa-solid fa-arrow-left"></i>
                        </button>
                    }
                    <div class="board-pane-titles">
                        <div class="board-pane-title">@HeaderTitle</div>
                    </div>
                    <button type="button" class="board-pane-icon-btn" title="Close" @onclick="Close">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </header>
            }

            <div class="board-pane-body @(UseDashboardChrome ? "board-pane-body--dash" : null) @(ScrollClass)">
                @if (!Auth.IsSignedIn)
                {
                    <div class="board-pane-empty">
                        <lottie-player class="board-pane-lottie"
                                       src="/lottie/group.json"
                                       background="transparent"
                                       speed="1"
                                       loop
                                       autoplay>
                        </lottie-player>
                        <p class="board-pane-empty-title">Join your worship community</p>
                        <p class="board-pane-empty-copy">Sign in to plan hymns on a group board.</p>
                        <a class="btn" href="@AuthNav.LoginUrl()" @onclick="Close">Log in</a>
                    </div>
                }
                else if (view == View.Groups)
                {
                    @if (Busy)
                    {
                        <div class="board-pane-empty">
                            <span class="spinner" aria-hidden="true"></span>
                            <p class="board-pane-empty-copy">Loading…</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Error))
                    {
                        <p class="board-pane-error">@Error</p>
                    }
                    else if (Groups.Count == 0)
                    {
                        <div class="board-pane-empty">
                            <lottie-player class="board-pane-lottie"
                                           src="/lottie/group.json"
                                           background="transparent"
                                           speed="1"
                                           loop
                                           autoplay>
                            </lottie-player>
                            <p class="board-pane-empty-title">No groups yet</p>
                            <p class="board-pane-empty-copy">Create or join a worship group to use boards.</p>
                            <a class="btn" href="groups" @onclick="Close">Open groups</a>
                        </div>
                    }
                    else
                    {
                        <div class="board-pane-list">
                            @foreach (var g in Groups)
                            {
                                <button type="button" class="board-pane-row" @onclick="() => OpenGroup(g)">
                                    <span class="board-pane-row-main">
                                        <span class="board-pane-row-title">@g.Name</span>
                                        <span class="board-pane-row-meta">Code @g.JoinCode</span>
                                    </span>
                                    <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
                                </button>
                            }
                        </div>
                        <a class="board-pane-manage" href="groups" @onclick="Close">Manage groups</a>
                    }
                }
                else if (Auth.IsSignedIn && view == View.Lists && ActiveGroup != null)
                {
                    <header class="board-pane-dash-header">
                        <div class="board-pane-eyebrow">Group Board</div>
                        <div class="board-pane-dash-title-row">
                            <h2 class="board-pane-dash-name">@ActiveGroup.Name</h2>
                            <button type="button"
                                    class="board-pane-dash-icon"
                                    title="Group options"
                                    @onclick="OpenGroupMenuAsync">
                                <i class="fa-solid fa-users" aria-hidden="true"></i>
                            </button>
                        </div>
                    </header>

                    <h3 class="board-pane-section-title">Hymn Setlist</h3>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <p class="board-pane-error">@Error</p>
                    }

                    @if (Busy && Lists.Count == 0)
                    {
                        <div class="board-pane-empty board-pane-empty--inline">
                            <span class="spinner" aria-hidden="true"></span>
                        </div>
                    }
                    else if (Lists.Count == 0)
                    {
                        <div class="board-pane-empty board-pane-empty--inline">
                            <p class="board-pane-empty-title">No hymn lists yet</p>
                            <p class="board-pane-empty-copy">Tap + to create today’s setlist (same as the mobile app).</p>
                        </div>
                    }
                    else
                    {
                        <div class="board-pane-setlist board-cascade @(listsEnterAnim ? "is-entering" : null)">
                            <Virtualize Items="Lists" ItemSize="72f" OverscanCount="10" Context="list">
                                @{
                                    var unread = ActiveGroup == null
                                        ? 0
                                        : BoardUi.GetListUnreadCount(ActiveGroup.Id, list.Id);
                                    var isOpen = string.Equals(swipedListId, list.Id, StringComparison.Ordinal);
                                    var isDragging = string.Equals(swipeDragListId, list.Id, StringComparison.Ordinal);
                                    var offset = isDragging ? swipeDragX : (isOpen ? -SwipeActionsWidth : 0);
                                    var listEnterIdx = listsEnterAnim ? Lists.IndexOf(list) : -1;
                                }
                                <div class="board-swipe board-cascade-item @(isOpen ? "is-open" : null) @(isDragging ? "is-dragging" : null) @(offset < -1 ? "is-revealing" : null)"
                                     data-list-id="@list.Id"
                                     style="@CascadeStyle(offset, listEnterIdx)">
                                    <div class="board-swipe-actions" aria-hidden="@(!isOpen)">
                                        <button type="button"
                                                class="board-swipe-btn board-swipe-btn--delete"
                                                title="Delete"
                                                @onclick="() => AskDeleteList(list)"
                                                @onclick:stopPropagation="true">
                                            <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                        </button>
                                        <button type="button"
                                                class="board-swipe-btn board-swipe-btn--edit"
                                                title="Edit date"
                                                @onclick="() => StartEditList(list)"
                                                @onclick:stopPropagation="true">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div class="board-swipe-front board-pane-card"
                                         @onpointerdown="e => OnSwipePointerDown(list, e)"
                                         @onpointermove="e => OnSwipePointerMove(list, e)"
                                         @onpointerup="e => OnSwipePointerUp(list, e)"
                                         @onpointercancel="e => OnSwipePointerUp(list, e)"
                                         @onclick="() => OnListCardClick(list)">
                                        <span class="board-pane-card-title-row">
                                            <span class="board-pane-card-title">@list.Name</span>
                                            @if (unread > 0)
                                            {
                                                <span class="board-unread-badge" aria-label="@unread unread">
                                                    @(unread > 99 ? "99+" : unread.ToString())
                                                </span>
                                            }
                                        </span>
                                        <span class="board-pane-card-meta">@HymnCountLabel(list)</span>
                                    </div>
                                </div>
                            </Virtualize>
                        </div>
                    }

                    <button type="button"
                            class="board-pane-fab"
                            title="Create list"
                            disabled="@Busy"
                            @onclick="StartCreateList">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                    </button>
                }
                else if (Auth.IsSignedIn && view == View.Members && ActiveGroup != null)
                {
                    <header class="board-pane-dash-header">
                        <div class="board-pane-eyebrow">Group Board</div>
                        <div class="board-pane-dash-title-row">
                            <h2 class="board-pane-dash-name">@ActiveGroup.Name</h2>
                            <button type="button"
                                    class="board-pane-dash-icon"
                                    title="Group options"
                                    @onclick="OpenGroupMenuAsync">
                                <i class="fa-solid fa-users" aria-hidden="true"></i>
                            </button>
                        </div>
                    </header>

                    <div class="board-pane-members-title-row">
                        <button type="button" class="board-pane-dash-icon" title="Back" @onclick="BackFromMembers">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        </button>
                        <h3 class="board-pane-members-title">Members</h3>
                    </div>

                    <label class="board-pane-field-label">Search</label>
                    <div class="board-pane-search">
                        <input type="search"
                               placeholder="Name or nickname"
                               @bind="memberSearch"
                               @bind:event="oninput"
                               @bind:after="RefreshMemberPresentation" />
                    </div>

                    <label class="board-pane-field-label">Filter by role</label>
                    <div class="board-pane-chips">
                        @foreach (var role in RoleFilters)
                        {
                            var selected = string.Equals(memberRoleFilter, role, StringComparison.OrdinalIgnoreCase)
                                           || (role == "All" && string.IsNullOrEmpty(memberRoleFilter));
                            <button type="button"
                                    class="board-pane-chip @(selected ? "is-selected" : null)"
                                    @onclick="() => SetRoleFilter(role)">
                                @role
                            </button>
                        }
                    </div>

                    <label class="board-pane-field-label">View</label>
                    <div class="board-pane-segments">
                        <button type="button"
                                class="board-pane-segment @(!membersGroupByRole ? "is-selected" : null)"
                                @onclick="() => SetMembersGrouped(false)">
                            List
                        </button>
                        <button type="button"
                                class="board-pane-segment @(membersGroupByRole ? "is-selected" : null)"
                                @onclick="() => SetMembersGrouped(true)">
                            By role
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <p class="board-pane-error">@Error</p>
                    }

                    @if (Busy && Members.Count == 0)
                    {
                        <div class="board-pane-empty board-pane-empty--inline">
                            <span class="spinner" aria-hidden="true"></span>
                        </div>
                    }
                    else if (DisplayedMemberRows.Count == 0)
                    {
                        <div class="board-pane-empty board-pane-empty--inline">
                            <p class="board-pane-empty-copy">No members match.</p>
                        </div>
                    }
                    else
                    {
                        <div class="board-pane-members board-cascade @(membersEnterAnim ? "is-entering" : null)">
                            <Virtualize @key="memberVirtualKey"
                                        Items="DisplayedMemberRows"
                                        ItemSize="52f"
                                        OverscanCount="12"
                                        Context="row">
                                @if (row.IsHeader)
                                {
                                    <div class="board-pane-member-section board-cascade-item"
                                         style="@EnterDelayStyle(DisplayedMemberRows.IndexOf(row))">@row.Header</div>
                                }
                                else if (row.Member != null)
                                {
                                    <div class="board-pane-member board-cascade-item"
                                         style="@EnterDelayStyle(DisplayedMemberRows.IndexOf(row))">
                                        <span class="board-pane-avatar" style="@AvatarStyle(row.Member)">@Initials(row.Member)</span>
                                        <span class="board-pane-member-main">
                                            <span class="board-pane-member-name">@MemberListName(row.Member)</span>
                                            @if (string.IsNullOrEmpty(memberRoleFilter)
                                                 && !membersGroupByRole
                                                 && !string.IsNullOrWhiteSpace(RolesSummary(row.Member)))
                                            {
                                                <span class="board-pane-member-roles">@RolesSummary(row.Member)</span>
                                            }
                                        </span>
                                        @if (currentUserIsGroupAdmin
                                             && !string.Equals(row.Member.Id, Auth.CurrentUserId, StringComparison.Ordinal))
                                        {
                                            <button type="button"
                                                    class="board-pane-member-menu"
                                                    title="Member options"
                                                    disabled="@Busy"
                                                    @onclick="() => OpenMemberMenu(row.Member)"
                                                    @onclick:stopPropagation="true">
                                                <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </Virtualize>
                        </div>
                    }
                }
                else if (Auth.IsSignedIn && view == View.ListDetail && ActiveList != null && ActiveGroup != null)
                {
                    <header class="board-pane-dash-header board-pane-list-header">
                        <div class="board-pane-eyebrow">Group Board</div>
                        <div class="board-pane-dash-title-row">
                            <h2 class="board-pane-dash-name">@ActiveGroup.Name</h2>
                        </div>
                    </header>

                    <div class="board-pane-detail-header">
                        <button type="button" class="board-pane-dash-icon" title="Back" @onclick="GoBack">
                            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
                        </button>
                        <div class="board-pane-detail-titles">
                            <div class="board-pane-detail-name">@ActiveList.Name</div>
                        </div>
                        <button type="button"
                                class="board-pane-dash-icon"
                                title="Board options"
                                @onclick="OpenBoardOptions">
                            <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(Status))
                    {
                        <p class="board-pane-status">@Status</p>
                    }
                    @if (!string.IsNullOrEmpty(Error))
                    {
                        <p class="board-pane-error">@Error</p>
                    }

                    <div class="board-pane-list board-pane-hymns board-cascade @(hymnsEnterAnim ? "is-entering" : null)">
                        @if (ActiveList.Hymns.Count == 0)
                        {
                            <div class="board-pane-empty board-pane-empty--inline">
                                <p class="board-pane-empty-title">No hymns scheduled</p>
                                <p class="board-pane-empty-copy">Tap + below to add a hymn.</p>
                            </div>
                        }
                        else
                        {
                            var boardCascade = 0;
                            @foreach (var group in BoardGroups)
                            {
                                <div class="board-pane-section-block @(DragClass(group.Section?.Id))" @key="group.Key">
                                    @if (group.Section != null)
                                    {
                                        var sectionEntry = group.Section;
                                        var sectionSaved = IsSectionSaved(sectionEntry.SectionName);
                                        var sectionOpen = string.Equals(swipedSectionId, sectionEntry.Id, StringComparison.Ordinal);
                                        var sectionDragging = string.Equals(swipeSectionDragId, sectionEntry.Id, StringComparison.Ordinal);
                                        var sectionOffset = sectionDragging ? swipeSectionDragX : (sectionOpen ? -SwipeActionsWidth : 0);
                                        var sectionEnterIdx = hymnsEnterAnim ? boardCascade++ : -1;
                                        <div class="board-pane-drop-line @(DropLineClass(sectionEntry.Id, below: false))"></div>
                                        <div class="board-swipe board-swipe--section board-cascade-item @(sectionOpen ? "is-open" : null) @(sectionDragging ? "is-dragging" : null) @(sectionOffset < -1 ? "is-revealing" : null)"
                                             style="@CascadeStyle(sectionOffset, sectionEnterIdx)">
                                            <div class="board-swipe-actions" aria-hidden="@(!sectionOpen)">
                                                <button type="button"
                                                        class="board-swipe-btn board-swipe-btn--delete"
                                                        title="Delete section"
                                                        @onclick="() => AskDeleteSection(sectionEntry)"
                                                        @onclick:stopPropagation="true">
                                                    <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                </button>
                                                @if (sectionSaved)
                                                {
                                                    <button type="button"
                                                            class="board-swipe-btn board-swipe-btn--unsave"
                                                            title="This setlist only"
                                                            @onclick="() => ToggleSectionTemplate(sectionEntry, false)"
                                                            @onclick:stopPropagation="true">
                                                        <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="board-swipe-btn board-swipe-btn--save"
                                                            title="All future setlists"
                                                            @onclick="() => ToggleSectionTemplate(sectionEntry, true)"
                                                            @onclick:stopPropagation="true">
                                                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </div>
                                            <div class="board-swipe-front board-pane-section-row"
                                                 data-board-entry-id="@sectionEntry.Id"
                                                 @onpointerdown="e => OnSectionSwipePointerDown(sectionEntry, e)"
                                                 @onpointermove="e => OnSectionSwipePointerMove(sectionEntry, e)"
                                                 @onpointerup="e => OnSectionSwipePointerUp(sectionEntry, e)"
                                                 @onpointercancel="e => OnSectionSwipePointerUp(sectionEntry, e)"
                                                 @onclick="() => OnSectionRowClick(group.Key)">
                                                <span class="board-pane-grip"
                                                      title="Drag to reorder"
                                                      @onpointerdown="e => BeginBoardPointerDrag(e, sectionEntry)"
                                                      @onpointerdown:preventDefault
                                                      @onpointerdown:stopPropagation="true"
                                                      @onclick:stopPropagation="true">
                                                    <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
                                                </span>
                                                <span class="board-pane-section-name">@(sectionEntry.SectionName ?? "Section")</span>
                                                @if (sectionSaved)
                                                {
                                                    <i class="fa-solid fa-bookmark board-pane-section-saved"
                                                       title="Applies to future setlists"
                                                       aria-hidden="true"></i>
                                                }
                                                <span class="board-pane-section-count">@group.Hymns.Count</span>
                                                <i class="fa-solid fa-chevron-down board-pane-section-chevron @(group.IsCollapsed ? "is-collapsed" : null)"
                                                   aria-hidden="true"></i>
                                            </div>
                                        </div>
                                        <div class="board-pane-drop-line @(DropLineClass(sectionEntry.Id, below: true))"></div>
                                    }

                                    <div class="board-pane-section-panel @(group.IsCollapsed ? "is-collapsed" : null)">
                                        <div class="board-pane-section-panel-inner@(group.Section != null ? " board-pane-section-panel-inner--indented" : "")">
                                            @foreach (var hymn in group.Hymns)
                                            {
                                                var hymnOpen = string.Equals(swipedHymnId, hymn.Id, StringComparison.Ordinal);
                                                var hymnDragging = string.Equals(swipeHymnDragId, hymn.Id, StringComparison.Ordinal);
                                                var hymnOffset = hymnDragging ? swipeHymnDragX : (hymnOpen ? -SwipeActionsWidth : 0);
                                                var hymnEnterIdx = hymnsEnterAnim && !group.IsCollapsed ? boardCascade++ : -1;
                                                <div class="board-pane-hymn-wrap board-cascade-item @(DragClass(hymn.Id))"
                                                     @key="hymn.Id"
                                                     style="@EnterDelayStyle(hymnEnterIdx)">
                                                    <div class="board-pane-drop-line @(DropLineClass(hymn.Id, below: false))"></div>
                                                    <div class="board-swipe board-swipe--hymn @(hymnOpen ? "is-open" : null) @(hymnDragging ? "is-dragging" : null) @(hymnOffset < -1 ? "is-revealing" : null)"
                                                         style="--swipe-x: @(hymnOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))px">
                                                        <div class="board-swipe-actions" aria-hidden="@(!hymnOpen)">
                                                            <button type="button"
                                                                    class="board-swipe-btn board-swipe-btn--delete"
                                                                    title="Delete"
                                                                    @onclick="() => AskDeleteHymn(hymn)"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                                                            </button>
                                                            <button type="button"
                                                                    class="board-swipe-btn board-swipe-btn--edit"
                                                                    title="Edit"
                                                                    @onclick="() => StartEditHymn(hymn)"
                                                                    @onclick:stopPropagation="true">
                                                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                                            </button>
                                                        </div>
                                                        <div class="board-swipe-front board-pane-hymn-card"
                                                             data-board-entry-id="@hymn.Id"
                                                             @onpointerdown="e => OnHymnSwipePointerDown(hymn, e)"
                                                             @onpointermove="e => OnHymnSwipePointerMove(hymn, e)"
                                                             @onpointerup="e => OnHymnSwipePointerUp(hymn, e)"
                                                             @onpointercancel="e => OnHymnSwipePointerUp(hymn, e)"
                                                             @onclick="() => OnHymnCardClick(hymn)">
                                                            <span class="board-pane-grip"
                                                                  title="Drag to reorder"
                                                                  @onpointerdown="e => BeginBoardPointerDrag(e, hymn)"
                                                                  @onpointerdown:preventDefault
                                                                  @onpointerdown:stopPropagation="true"
                                                                  @onclick:stopPropagation="true">
                                                                <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
                                                            </span>
                                                            <span class="board-pane-hymn-body">
                                                                <span class="board-pane-hymn-top">
                                                                    <span class="board-pane-hymn-number">Hymn #@hymn.HymnNumber</span>
                                                                    @if (hymn.UpdatedAt != default)
                                                                    {
                                                                        <span class="board-pane-hymn-when">
                                                                            <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                                                            @FormatAddedAt(hymn.UpdatedAt)
                                                                        </span>
                                                                    }
                                                                </span>
                                                                @if (!string.IsNullOrWhiteSpace(FirstLineFor(hymn)))
                                                                {
                                                                    <span class="board-pane-hymn-line">@FirstLineFor(hymn)</span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(hymn.AddedByName))
                                                                {
                                                                    <span class="board-pane-hymn-meta">
                                                                        <i class="fa-solid fa-user" aria-hidden="true"></i>
                                                                        @hymn.AddedByName
                                                                    </span>
                                                                }
                                                                @if (!string.IsNullOrWhiteSpace(hymn.Notes)
                                                                     && !string.Equals(hymn.Notes, FirstLineFor(hymn), StringComparison.Ordinal))
                                                                {
                                                                    <span class="board-pane-hymn-note">
                                                                        <i class="fa-solid fa-note-sticky" aria-hidden="true"></i>
                                                                        @hymn.Notes
                                                                    </span>
                                                                }
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="board-pane-drop-line @(DropLineClass(hymn.Id, below: true))"></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (showAddHymn)
                    {
                        <div class="board-add-panel" @onclick:stopPropagation="true">
                            <div class="board-add-panel-head">
                                <span class="board-add-panel-title">Add hymn</span>
                                <button type="button"
                                        class="board-add-panel-close"
                                        title="Close"
                                        @onclick="CloseAddHymn">
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="board-add-suggest-wrap">
                                @if (addHymnSuggestions.Count > 0)
                                {
                                    <div class="board-add-suggest" role="listbox" aria-label="Hymn suggestions">
                                        @foreach (var s in addHymnSuggestions)
                                        {
                                            <button type="button"
                                                    class="board-add-suggest-item"
                                                    role="option"
                                                    @onclick="() => PickHymnSuggestion(s)">
                                                @if (s.LineFirst)
                                                {
                                                    <span class="board-add-suggest-primary">@s.Line</span>
                                                    <span class="board-add-suggest-secondary">Hymn #@s.Number</span>
                                                }
                                                else
                                                {
                                                    <span class="board-add-suggest-primary">Hymn #@s.Number</span>
                                                    @if (!string.IsNullOrWhiteSpace(s.Line))
                                                    {
                                                        <span class="board-add-suggest-secondary">@s.Line</span>
                                                    }
                                                }
                                            </button>
                                        }
                                    </div>
                                }
                                <input class="board-add-panel-input"
                                       type="text"
                                       autocomplete="off"
