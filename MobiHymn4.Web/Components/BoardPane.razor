    async Task EnsureAddHymnCatalogAsync()
    {
        if (addHymnCatalog.Count > 0)
            return;

        try
        {
            var meta = await Lyrics.GetCatalogMetaAsync();
            addHymnCatalog = meta.Hymns?
                .Where(h => !string.IsNullOrWhiteSpace(h.Number))
                .ToList() ?? new();
        }
        catch
        {
            addHymnCatalog = new();
        }
    }

    async Task OnAddHymnQueryInput(ChangeEventArgs e)
    {
        addHymnQuery = e.Value?.ToString() ?? "";
        addHymnPickedNumber = null;
        addHymnPickedLine = null;
        addHymnError = null;
        await UpdateAddHymnSuggestionsAsync(addHymnQuery);
    }

    async Task UpdateAddHymnSuggestionsAsync(string query)
    {
        addHymnSuggestCts?.Cancel();
        var cts = new CancellationTokenSource();
        addHymnSuggestCts = cts;
        var token = cts.Token;

        if (string.IsNullOrWhiteSpace(query))
        {
            addHymnSuggestions = new();
            return;
        }

        try
        {
            await Task.Delay(AddHymnSuggestDebounceMs, token);
            await EnsureAddHymnCatalogAsync();
            if (token.IsCancellationRequested)
                return;

            List<BoardHymnSuggestion> suggestions;
            if (IsNumberQuery(query))
            {
                suggestions = BuildNumberSuggestions(query, addHymnCatalog);
            }
            else
            {
                var hits = await Lyrics.SearchLyricsAsync(query.Trim(), token);
                if (token.IsCancellationRequested)
                    return;

                suggestions = hits
                    .Take(8)
                    .Select(h => new BoardHymnSuggestion
                    {
                        Number = h.Number,
                        Line = h.Line ?? "",
                        LineFirst = true,
                    })
                    .ToList();
            }

            if (token.IsCancellationRequested)
                return;

            addHymnSuggestions = suggestions;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // superseded
        }
        catch
        {
            // Fall back to first-line catalog match if lyrics index isn't ready.
            if (!token.IsCancellationRequested && !IsNumberQuery(query))
            {
                addHymnSuggestions = BuildCatalogLineSuggestions(query, addHymnCatalog);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

