    async Task ConfirmDeleteHymn()
    {
        if (ActiveGroup == null || ActiveList == null || pendingDeleteHymn == null)
            return;

        var entryId = pendingDeleteHymn.Id;
        Busy = true;
        Error = null;
        try
        {
            ActiveList.Hymns.RemoveAll(h => string.Equals(h.Id, entryId, StringComparison.Ordinal));
            RenumberBoard();
            await BoardService.UpdateListAsync(ActiveGroup.Id, ActiveList);
            RebuildBoardDisplayRows();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            pendingDeleteHymn = null;
            Busy = false;
        }
    }

    void StartEditHymn(BoardHymnDoc hymn)
    {
        CloseOpenHymnSwipe();
        if (!CanModifyHymn(hymn))
        {
            Error = "You can only edit hymns you added.";
            return;
        }

        editingHymn = hymn;
        editHymnNumber = hymn.HymnNumber ?? "";
        editHymnNotes = hymn.Notes ?? "";
        editHymnError = null;
        showEditHymn = true;
    }

    void CloseEditHymn()
    {
        showEditHymn = false;
        editingHymn = null;
        editHymnError = null;
    }

    async Task SaveEditHymn()
    {
        if (ActiveGroup == null || ActiveList == null || editingHymn == null)
            return;

        var number = (editHymnNumber ?? "").Trim();
        if (string.IsNullOrWhiteSpace(number))
        {
            editHymnError = "Enter a hymn number.";
            return;
        }

        if (ActiveList.Hymns.Any(h =>
                !h.IsSection
                && !string.Equals(h.Id, editingHymn.Id, StringComparison.Ordinal)
                && string.Equals(h.HymnNumber, number, StringComparison.OrdinalIgnoreCase)))
        {
            editHymnError = $"Hymn #{number} is already on this list.";
            return;
        }

        Busy = true;
        editHymnError = null;
        Error = null;
        try
        {
            editingHymn.HymnNumber = number;
            editingHymn.Notes = string.IsNullOrWhiteSpace(editHymnNotes) ? null : editHymnNotes.Trim();
            editingHymn.UpdatedAt = DateTimeOffset.UtcNow;
            await BoardService.UpdateListAsync(ActiveGroup.Id, ActiveList);
            RebuildBoardDisplayRows();
            CloseEditHymn();
        }
        catch (Exception ex)
        {
            editHymnError = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    async Task LoadGroupsAsync()
    {
        Busy = true;
        Error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            Groups = (await GroupService.GetMyGroupsAsync()).ToList();
            if (Groups.Count == 0)
                return;

            // Prefer a group that actually has hymn lists (groupIds order can be wrong/stale).
            WorshipGroupDoc? preferred = null;
            if (Groups.Count == 1)
            {
                preferred = Groups[0];
            }
            else
            {
                foreach (var g in Groups)
                {
                    try
                    {
                        var lists = await BoardService.GetListsAsync(g.Id);
                        if (lists.Count > 0)
                        {
                            preferred = g;
                            break;
                        }
                    }
                    catch
                    {
                        // try next group
                    }
                }

                preferred ??= Groups[0];
            }

            await OpenGroup(preferred);
            return;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Groups = new();
        }
        finally
        {
            if (view == View.Groups)
                Busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task OpenGroup(WorshipGroupDoc group)
    {
        ActiveGroup = group;
        view = View.Lists;
        Lists = new();
        Busy = true;
        Error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            Lists = (await BoardService.GetListsAsync(group.Id))
                .OrderByDescending(l => l.CreatedAt)
                .ToList();

            if (Lists.Count == 0)
            {
                // Distinguish "truly empty" from "can't read boards" (not a member / rules).
                try
                {
                    var members = await GroupService.GetMembersAsync(group.Id);
                    var me = members.FirstOrDefault(m =>
                        string.Equals(m.Id, Auth.CurrentUserId, StringComparison.Ordinal));
                    if (me == null)
                    {
                        Error = "You're not a member of this group in Firestore, so board lists can't load. Try leaving and rejoining with the invite code.";
                    }
                }
                catch (Exception memberEx)
                {
                    var msg = memberEx.Message ?? "";
                    if (msg.Contains("permission", StringComparison.OrdinalIgnoreCase)
                        || msg.Contains("insufficient", StringComparison.OrdinalIgnoreCase))
                    {
                        Error = "Can't read this group's boards (membership/permission). Try rejoining with the invite code.";
                    }
                }
            }
        }
        catch (Exception ex)
        {
            var msg = ex.Message ?? "";
            Error = msg.Contains("permission", StringComparison.OrdinalIgnoreCase)
                || msg.Contains("insufficient", StringComparison.OrdinalIgnoreCase)
                ? "Can't load hymn lists for this group (permission). Confirm you're a member and try rejoining."
                : msg;
        }
        finally
        {
            Busy = false;
            TriggerListsEnterAnim();
            await InvokeAsync(StateHasChanged);
        }
    }

    void OpenList(BoardListDoc list)
    {
        if (ActiveGroup == null) return;
        ActiveList = list;
        view = View.ListDetail;
        Status = null;
        collapsedSections.Clear();
        fabMenuOpen = false;
        showAddSection = false;
        showAddHymn = false;
        CloseAllSwipes();
        RebuildBoardDisplayRows();
        TriggerHymnsEnterAnim();
        listSub?.Dispose();
        listSub = BoardService.SubscribeList(ActiveGroup.Id, list.Id, updated =>
        {
            ActiveList = updated;
            RebuildBoardDisplayRows();
            _ = ResolveFirstLinesAsync();
            InvokeAsync(StateHasChanged);
        });
        _ = ResolveFirstLinesAsync();
        _ = RefreshSavedSectionNamesAsync();
        _ = EnsureSavedSectionsForActiveListAsync();
        _ = BoardNotifications.MarkListReadAsync(ActiveGroup.Id, list.Id);
    }

    async Task EnsureSavedSectionsForActiveListAsync()
    {
        if (ActiveGroup == null || ActiveList == null)
            return;

        try
        {
            var merged = await BoardService.EnsureSavedSectionsOnListAsync(ActiveGroup.Id, ActiveList.Id);
            if (merged == null)
                return;

            ActiveList = merged;
            RebuildBoardDisplayRows();
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Optional seed — list is still usable without it.
        }
    }

    async Task RefreshSavedSectionNamesAsync()
    {
        if (ActiveGroup == null)
            return;

        try
        {
            var names = await BoardService.GetSavedSectionNamesAsync(ActiveGroup.Id);
            savedSectionNames.Clear();
            foreach (var name in names)
            {
                if (!string.IsNullOrWhiteSpace(name))
                    savedSectionNames.Add(name.Trim());
            }
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Template load is optional for viewing the board.
        }
    }

    bool IsSectionSaved(string? sectionName)
    {
        var name = sectionName?.Trim();
        return !string.IsNullOrEmpty(name) && savedSectionNames.Contains(name);
    }

    void OnUnreadChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    void OnOpenRequested(object? sender, EventArgs e) => _ = HandleOpenRequestAsync();

    async Task HandleOpenRequestAsync()
    {
        var groupId = BoardUi.PendingGroupId;
        var listId = BoardUi.PendingListId;
        BoardUi.ClearPendingOpen();

        if (!Visible)
            await VisibleChanged.InvokeAsync(true);

        // Wait for pane to open / groups to load.
        for (var i = 0; i < 20 && (!show || Groups.Count == 0); i++)
            await Task.Delay(50);

        if (!Auth.IsSignedIn) return;

        if (Groups.Count == 0)
            await LoadGroupsAsync();

        if (string.IsNullOrWhiteSpace(groupId))
        {
            await InvokeAsync(StateHasChanged);
            return;
        }

        var group = Groups.FirstOrDefault(g => string.Equals(g.Id, groupId, StringComparison.Ordinal));
        if (group == null)
        {
            await LoadGroupsAsync();
            group = Groups.FirstOrDefault(g => string.Equals(g.Id, groupId, StringComparison.Ordinal));
        }

        if (group == null) return;

        await OpenGroup(group);
        if (!string.IsNullOrWhiteSpace(listId))
        {
            var list = Lists.FirstOrDefault(l => string.Equals(l.Id, listId, StringComparison.Ordinal));
            if (list != null)
                OpenList(list);
        }
    }

    void RebuildBoardDisplayRows()
    {
        var groups = new List<BoardSectionGroup>();
        if (ActiveList == null)
        {
            BoardGroups = groups;
            return;
        }

        var ordered = ActiveList.Hymns.OrderBy(h => h.SortOrder).ToList();
        BoardSectionGroup? current = null;

        foreach (var entry in ordered)
        {
            if (entry.IsSection)
            {
                current = new BoardSectionGroup
                {
                    Key = entry.Id,
                    Section = entry,
                    Hymns = new List<BoardHymnDoc>(),
                    IsCollapsed = collapsedSections.Contains(entry.Id)
                };
                groups.Add(current);
                continue;
            }

            if (current == null)
            {
                current = new BoardSectionGroup
                {
                    Key = "_leading",
                    Hymns = new List<BoardHymnDoc>()
                };
                groups.Add(current);
            }

            current.Hymns.Add(entry);
        }

        BoardGroups = groups;
    }

    void ToggleSection(string sectionId)
    {
        if (string.IsNullOrEmpty(sectionId) || sectionId == "_leading")
            return;

        if (!collapsedSections.Add(sectionId))
            collapsedSections.Remove(sectionId);

        var group = BoardGroups.FirstOrDefault(g => g.Key == sectionId);
        if (group != null)
            group.IsCollapsed = collapsedSections.Contains(sectionId);
    }

