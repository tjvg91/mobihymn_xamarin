    void OnSectionSwipePointerDown(BoardHymnDoc section, PointerEventArgs e)
    {
        if (e.Button != 0 && e.PointerType == "mouse")
            return;

        CloseOpenSwipe();
        CloseOpenHymnSwipe();
        swipeSectionPointerId = e.PointerId;
        swipeSectionDragId = section.Id;
        swipeSectionStartX = e.ClientX;
        swipeSectionStartY = e.ClientY;
        swipeSectionStartOffset = string.Equals(swipedSectionId, section.Id, StringComparison.Ordinal) ? -SwipeActionsWidth : 0;
        swipeSectionDragX = swipeSectionStartOffset;
        swipeSectionMoved = false;
        swipeSectionAxisLocked = false;
        swipeSectionHorizontal = false;
    }

    void OnSectionSwipePointerMove(BoardHymnDoc section, PointerEventArgs e)
    {
        if (swipeSectionPointerId != e.PointerId || !string.Equals(swipeSectionDragId, section.Id, StringComparison.Ordinal))
            return;

        var dx = e.ClientX - swipeSectionStartX;
        var dy = e.ClientY - swipeSectionStartY;

        if (!swipeSectionAxisLocked && (Math.Abs(dx) > 8 || Math.Abs(dy) > 8))
        {
            swipeSectionAxisLocked = true;
            swipeSectionHorizontal = Math.Abs(dx) >= Math.Abs(dy);
            if (!swipeSectionHorizontal)
            {
                swipeSectionDragId = null;
                swipeSectionPointerId = null;
                return;
            }
        }

        if (!swipeSectionHorizontal)
            return;

        if (Math.Abs(dx) > 6)
            swipeSectionMoved = true;

        swipeSectionDragX = Math.Clamp(swipeSectionStartOffset + dx, -SwipeActionsWidth, 0);

        if (swipedSectionId != null && !string.Equals(swipedSectionId, section.Id, StringComparison.Ordinal))
            swipedSectionId = null;
    }

    void OnSectionSwipePointerUp(BoardHymnDoc section, PointerEventArgs e)
    {
        if (swipeSectionPointerId != e.PointerId)
            return;

        var wasDraggingThis = string.Equals(swipeSectionDragId, section.Id, StringComparison.Ordinal);
        swipeSectionPointerId = null;
        swipeSectionDragId = null;

        if (!wasDraggingThis)
            return;

        if (swipeSectionMoved && swipeSectionHorizontal)
        {
            suppressSectionClick = true;
            var open = swipeSectionDragX <= -SwipeActionsWidth * 0.4;
            swipedSectionId = open ? section.Id : null;
            swipeSectionDragX = open ? -SwipeActionsWidth : 0;
        }
        else if (string.Equals(swipedSectionId, section.Id, StringComparison.Ordinal))
        {
            suppressSectionClick = true;
            CloseOpenSectionSwipe();
        }
    }

    async Task ToggleSectionTemplate(BoardHymnDoc section, bool save)
    {
        CloseOpenSectionSwipe();
        if (ActiveGroup == null || ActiveList == null || section == null || !section.IsSection)
            return;

        var name = section.SectionName?.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            Error = "Section name is required.";
            return;
        }

        Busy = true;
        Error = null;
        try
        {
            if (save)
            {
                await BoardService.SaveSectionToTemplateAsync(ActiveGroup.Id, ActiveList.Id, name);
                savedSectionNames.Add(name);
                State.ShowToast("/lottie/done.gif", "Applies to future setlists.");
            }
            else
            {
                await BoardService.RemoveSectionFromTemplateAsync(ActiveGroup.Id, name);
                savedSectionNames.Remove(name);
                State.ShowToast("/lottie/done.gif", "This setlist only.");
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    void AskDeleteSection(BoardHymnDoc section)
    {
        CloseOpenSectionSwipe();
        if (section == null || !section.IsSection || ActiveList == null)
            return;

        pendingRemoveSection = section;
        removeSectionIsSaved = IsSectionSaved(section.SectionName);
        removeSectionHymnCount = CountHymnsInSection(section);
        removeDeleteHymns = false;
        removeCurrentDateOnly = true;
        showRemoveSection = true;
    }

    void CloseRemoveSection()
    {
        showRemoveSection = false;
        pendingRemoveSection = null;
        removeDeleteHymns = false;
        removeCurrentDateOnly = true;
        removeSectionIsSaved = false;
        removeSectionHymnCount = 0;
    }

    int CountHymnsInSection(BoardHymnDoc section)
    {
        if (ActiveList == null)
            return 0;

        var index = ActiveList.Hymns.FindIndex(h => h.Id == section.Id);
        if (index < 0)
            return 0;

        var count = 0;
        for (var i = index + 1; i < ActiveList.Hymns.Count; i++)
        {
            if (ActiveList.Hymns[i].IsSection)
                break;
            count++;
        }

        return count;
    }

    async Task ConfirmRemoveSection()
    {
        if (ActiveGroup == null || ActiveList == null || pendingRemoveSection == null)
            return;

        var section = pendingRemoveSection;
        var name = section.SectionName?.Trim() ?? "";
        Busy = true;
        Error = null;
        try
        {
            if (removeSectionIsSaved && !removeCurrentDateOnly && !string.IsNullOrEmpty(name))
            {
                await BoardService.RemoveSectionFromTemplateAsync(ActiveGroup.Id, name);
                savedSectionNames.Remove(name);
            }

            await BoardService.RemoveSectionAsync(
                ActiveGroup.Id,
                ActiveList.Id,
                section.Id,
                removeDeleteHymns);

            ActiveList = await BoardService.GetListAsync(ActiveGroup.Id, ActiveList.Id) ?? ActiveList;
            RebuildBoardDisplayRows();
            State.ShowToast("/lottie/done.gif", "Section removed.");
            CloseRemoveSection();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

