@if (showCreateList && ActiveGroup != null)
{
    <div class="modal-backdrop" @onclick="CloseCreateList">
        <div class="modal create-hymn-list-modal" @onclick:stopPropagation="true">
            <h2>@(editingList == null ? "New hymn list" : "Change date")</h2>
            <p class="create-hymn-list-copy">@(editingList == null ? "Choose a date for this hymn list." : "Choose a new date for this hymn list.")</p>
            <p class="create-hymn-list-selected">@newListDate.ToString("dddd, MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
            <div class="create-hymn-cal" role="group" aria-label="Choose date">
                <div class="create-hymn-cal-head">
                    <button type="button" class="create-hymn-cal-nav" @onclick="PrevCreateListMonth" aria-label="Previous month">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="create-hymn-cal-title">@createListMonthTitle</div>
                    <button type="button" class="create-hymn-cal-nav" @onclick="NextCreateListMonth" aria-label="Next month">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
                <div class="create-hymn-cal-weekdays" aria-hidden="true">
                    <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                </div>
                <div class="create-hymn-cal-grid">
                    @foreach (var day in CreateListCalendarDays)
                    {
                        if (day == null)
                        {
                            <span class="create-hymn-cal-cell is-empty"></span>
                        }
                        else
                        {
                            var d = day.Value;
                            var selected = d.Date == newListDate.Date;
                            var today = d.Date == DateTime.Today;
                            <button type="button"
                                    class="create-hymn-cal-cell @(selected ? "is-selected" : null) @(today ? "is-today" : null)"
                                    @onclick="() => SelectCreateListDate(d)">
                                <span>@d.Day</span>
                            </button>
                        }
                    }
                </div>
                <div class="create-hymn-cal-footer">
                    <button type="button" class="create-hymn-cal-link" @onclick="SelectCreateListToday">Today</button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(createListError))
            {
                <p class="create-hymn-list-error">@createListError</p>
            }
            <div class="actions">
                <button type="button" class="btn secondary" @onclick="CloseCreateList">Cancel</button>
                <button type="button" class="btn btn-yellow-black" disabled="@Busy" @onclick="ConfirmListDate">
                    @(editingList == null ? "Create" : "Save")
                </button>
            </div>
        </div>
    </div>
}

