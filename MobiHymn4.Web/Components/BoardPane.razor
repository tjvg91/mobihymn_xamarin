    async Task SaveEditedListDate()
    {
        if (ActiveGroup == null || editingList == null) return;
        var date = newListDate.Date;
        var displayName = date.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
        var dateKey = date.ToString("yyyy-MM-dd");
        var oldId = editingList.Id;
        if (Lists.Any(l =>
                string.Equals(l.Id, dateKey, StringComparison.Ordinal)
                && !string.Equals(l.Id, oldId, StringComparison.Ordinal)))
        {
            createListError = $"A hymn list already exists for {displayName}.";
            return;
        }

        Busy = true;
        Error = null;
        createListError = null;
        try
        {
            var updated = await BoardService.UpdateListDateAsync(ActiveGroup.Id, oldId, date);
            var idx = Lists.FindIndex(l => string.Equals(l.Id, oldId, StringComparison.Ordinal));
            if (idx >= 0)
                Lists[idx] = updated;
            else
                Lists.Insert(0, updated);

            Lists = Lists
                .OrderByDescending(l => l.CreatedAt)
                .ToList();

            if (ActiveList != null && string.Equals(ActiveList.Id, oldId, StringComparison.Ordinal))
                ActiveList = updated;

            CloseCreateList();
        }
        catch (Exception ex)
        {
            var msg = ex.Message ?? "";
            if (msg.Contains("already exists", StringComparison.OrdinalIgnoreCase))
            {
                createListError = msg;
                return;
            }

            Error = msg;
            CloseCreateList();
        }
        finally
        {
            Busy = false;
        }
    }

    async Task CreateList()
    {
        if (ActiveGroup == null) return;
        var date = newListDate.Date;
        var displayName = date.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture);
        var dateKey = date.ToString("yyyy-MM-dd");
        if (Lists.Any(l => string.Equals(l.Id, dateKey, StringComparison.Ordinal)))
        {
            createListError = $"A hymn list already exists for {displayName}.";
            return;
        }

        Busy = true;
        Error = null;
        createListError = null;
        try
        {
            var created = await BoardService.CreateListAsync(ActiveGroup.Id, displayName);
            CloseCreateList();
            Lists.Insert(0, created);
            OpenList(created);
        }
        catch (Exception ex)
        {
            var msg = ex.Message ?? "";
            if (msg.Contains("already exists", StringComparison.OrdinalIgnoreCase))
            {
                createListError = msg;
                return;
            }

            Error = msg.Contains("permission", StringComparison.OrdinalIgnoreCase)
                || msg.Contains("insufficient", StringComparison.OrdinalIgnoreCase)
                ? "Could not create list. Confirm your email is verified and you have a leadership role."
                : msg;
            CloseCreateList();
        }
        finally
        {
            Busy = false;
        }
    }

