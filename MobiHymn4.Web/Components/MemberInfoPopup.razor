@namespace MobiHymn4.Web.Components
@using MobiHymn4.Shared.Models

@if (Visible && Member != null)
{
    <div class="hi-backdrop" @onclick="Close">
        <div class="hi-popup" @onclick:stopPropagation="true" role="dialog" aria-label="Member details">
            <div class="hi-header">
                <div class="hi-header-icon mi-header-avatar" style="@AvatarStyle" aria-hidden="true">@Initials</div>
                <div class="hi-header-text">
                    <div class="hi-eyebrow">MEMBER</div>
                    <div class="hi-number">@HeaderName</div>
                    @if (IsYou)
                    {
                        <div class="hi-name">You</div>
                    }
                </div>
            </div>

            <div class="hi-body">
                @if (Rows.Count == 0)
                {
                    <p class="hi-empty">No extra details for this member.</p>
                }
                else
                {
                    @foreach (var row in Rows)
                    {
                        <div class="hi-row">
                            <div class="hi-row-icon" aria-hidden="true">
                                <i class="fa-solid @row.Icon"></i>
                            </div>
                            <div class="hi-row-text">
                                <div class="hi-row-label">@row.Label</div>
                                @foreach (var value in row.Values)
                                {
                                    <div class="hi-row-value">@value</div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="hi-footer">
                <button type="button" class="hi-close" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public GroupMemberDoc? Member { get; set; }
    [Parameter] public bool IsYou { get; set; }
    [Parameter] public string AvatarStyle { get; set; } = "";
    [Parameter] public string Initials { get; set; } = "?";

    string HeaderName => Member == null ? "Member" : DisplayName(Member);

    List<DetailRow> Rows => BuildRows(Member);

    static List<DetailRow> BuildRows(GroupMemberDoc? member)
    {
        var rows = new List<DetailRow>();
        if (member == null) return rows;

        var full = $"{member.FirstName} {member.LastName}".Trim();
        Add(rows, "Name", "fa-user", full);
        Add(rows, "Nickname", "fa-id-badge", member.Nickname);
        Add(rows, "Email", "fa-envelope", member.Email);

        var roles = new List<string>();
        if (member.IsAdmin) roles.Add("Admin");
        if (member.Roles != null)
        {
            roles.AddRange(member.Roles
                .Select(PrettyRole)
                .Where(r => !string.IsNullOrWhiteSpace(r)));
        }
        roles = roles.Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        AddMany(rows, "Roles", "fa-users", roles);

        if (member.JoinedAt != default)
            Add(rows, "Joined", "fa-calendar", member.JoinedAt.ToLocalTime().ToString("d MMM yyyy"));

        return rows;
    }

    static string DisplayName(GroupMemberDoc m)
    {
        if (!string.IsNullOrWhiteSpace(m.Nickname)) return m.Nickname.Trim();
        var full = $"{m.FirstName} {m.LastName}".Trim();
        if (!string.IsNullOrWhiteSpace(full)) return full;
        if (!string.IsNullOrWhiteSpace(m.Email)) return m.Email.Trim();
        return "Member";
    }

    static string PrettyRole(string raw) =>
        (raw ?? "").Trim().ToLowerInvariant() switch
        {
            "pastor" or "preacher" => "Preacher",
            "worshipleader" or "worship leader" => "Worship Leader",
            "projector" => "Projector",
            "accompaniment" => "Accompaniment",
            _ => string.IsNullOrWhiteSpace(raw) ? "" : raw.Trim()
        };

    static void Add(List<DetailRow> rows, string label, string icon, string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        rows.Add(new DetailRow(label.ToUpperInvariant(), icon, new[] { value.Trim() }));
    }

    static void AddMany(List<DetailRow> rows, string label, string icon, IEnumerable<string>? values)
    {
        if (values == null) return;
        var pills = values.Where(v => !string.IsNullOrWhiteSpace(v)).Select(v => v.Trim()).ToList();
        if (pills.Count == 0) return;
        rows.Add(new DetailRow(label.ToUpperInvariant(), icon, pills));
    }

    async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    sealed record DetailRow(string Label, string Icon, IReadOnlyList<string> Values);
}
