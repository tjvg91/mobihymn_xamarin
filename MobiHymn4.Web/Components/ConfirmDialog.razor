@namespace MobiHymn4.Web.Components

@if (show)
{
    <div class="confirm-dialog-host @(animOpen ? "is-open" : null)" aria-live="assertive">
        <div class="confirm-dialog-overlay" @onclick="Cancel"></div>
        <div class="confirm-dialog" @onclick:stopPropagation="true" role="alertdialog" aria-labelledby="confirm-dialog-title">
            <h2 id="confirm-dialog-title" class="confirm-dialog-title">@Title</h2>
            <p class="confirm-dialog-message">@Message</p>
            <div class="confirm-dialog-actions">
                <button type="button" class="confirm-dialog-btn" disabled="@confirming" @onclick="Cancel">@CancelLabel</button>
                <button type="button"
                        class="confirm-dialog-btn @(DangerConfirm ? "confirm-dialog-btn-danger" : "confirm-dialog-btn-primary")"
                        disabled="@confirming"
                        @onclick="Confirm">@(confirming ? "…" : ConfirmLabel)</button>
            </div>
        </div>
    </div>
}

@code {
    const int CloseMs = 200;

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public string Title { get; set; } = "Delete?";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string ConfirmLabel { get; set; } = "Yes";
    [Parameter] public string CancelLabel { get; set; } = "No";
    [Parameter] public bool DangerConfirm { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }

    bool show;
    bool animOpen;
    bool closing;
    bool confirming;

    protected override void OnParametersSet()
    {
        if (Visible && !show && !closing)
        {
            show = true;
            animOpen = false;
            confirming = false;
            _ = EnterAsync();
        }
        else if (!Visible && show && !closing)
        {
            _ = ExitAsync(notifyParent: false);
        }
    }

    async Task EnterAsync()
    {
        await Task.Delay(20);
        if (!show || closing) return;
        animOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    async Task ExitAsync(bool notifyParent)
    {
        if (closing) return;
        closing = true;
        animOpen = false;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(CloseMs);
        show = false;
        closing = false;
        confirming = false;
        if (notifyParent || Visible)
            await VisibleChanged.InvokeAsync(false);
        await InvokeAsync(StateHasChanged);
    }

    async Task Confirm()
    {
        if (confirming || closing) return;
        confirming = true;
        await InvokeAsync(StateHasChanged);
        // Close first so slow OnConfirmed work (e.g. boardUpdateList) does not
        // leave the popup frozen on "Remove" with no feedback.
        await ExitAsync(notifyParent: true);
        try
        {
            await OnConfirmed.InvokeAsync();
        }
        finally
        {
            confirming = false;
        }
    }

    Task Cancel()
    {
        if (confirming) return Task.CompletedTask;
        return ExitAsync(notifyParent: true);
    }
}
