@inject IJSRuntime Js
@inject NavigationManager Nav
@implements IDisposable

@* Block the reader until the PWA gate allows access (installed / localhost /dashboard). *@
@if (allowApp)
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="@routeData" Selector="main" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <h1>Not found</h1>
                <p class="muted">That page does not exist. <a href="">Go home</a>.</p>
            </LayoutView>
        </NotFound>
    </Router>
}
else if (gateReady)
{
    <PwaAccessGate ModeChanged="OnGateModeChanged" />
}

@code {
    bool gateReady;
    bool allowApp;
    bool navWired;
    /// <summary>Installed PWA/TWA — never re-apply browser gate on navigation.</summary>
    bool installedShell;

    protected override async Task OnInitializedAsync()
    {
        // index.html sets window.__mhStandalone before Blazor boots — skip an
        // extra post-render interop round-trip on installed PWAs.
        try
        {
            installedShell = await Js.InvokeAsync<bool>("mobihymnBoot.isStandalone");
        }
        catch
        {
            installedShell = false;
        }

        if (installedShell)
        {
            allowApp = true;
            gateReady = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (!installedShell)
        {
            try
            {
                installedShell = await Js.InvokeAsync<bool>("mobihymnPwa.isStandalone");
            }
            catch
            {
                installedShell = false;
            }
        }

        if (!navWired)
        {
            Nav.LocationChanged += OnLocationChanged;
            navWired = true;
        }

        await RefreshGateAsync();
        gateReady = true;
        await InvokeAsync(StateHasChanged);
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Installed app: ignore path changes — gate is browser-only.
        if (installedShell)
            return;

        _ = InvokeAsync(async () =>
        {
            var prev = allowApp;
            await RefreshGateAsync();
            if (prev != allowApp)
                StateHasChanged();
        });
    }

    async Task RefreshGateAsync()
    {
        if (installedShell)
        {
            allowApp = true;
            try { await Js.InvokeVoidAsync("mobihymnPwa.applyAccessGate"); }
            catch { /* ignore */ }
            return;
        }

        try
        {
            var mode = await Js.InvokeAsync<string>("mobihymnPwa.getGateMode");
            allowApp = string.Equals(mode, "none", StringComparison.Ordinal);
            try { await Js.InvokeVoidAsync("mobihymnPwa.applyAccessGate"); }
            catch { /* ignore */ }
        }
        catch
        {
            allowApp = true;
        }
    }

    void OnGateModeChanged(string mode)
    {
        if (installedShell)
            return;
        var next = string.Equals(mode, "none", StringComparison.Ordinal);
        if (next == allowApp)
            return;
        allowApp = next;
        StateHasChanged();
    }

    public void Dispose()
    {
        if (navWired)
            Nav.LocationChanged -= OnLocationChanged;
    }
}
