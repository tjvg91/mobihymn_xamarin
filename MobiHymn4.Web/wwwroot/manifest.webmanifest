{
  "name": "MobiHymn",
  "short_name": "MobiHymn",
  "id": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#2D2D2D",
  "theme_color": "#2D2D2D",
  "display_override": ["standalone", "minimal-ui"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://mobihymn.web.app/manifest.webmanifest"
    },
    {
      "platform": "play",
      "id": "com.tjapps.mobihymn.twa",
      "url": "https://play.google.com/store/apps/details?id=com.tjapps.mobihymn.twa"
    }
  ],
  "icons": [
    {
      "src": "icon-512.png?v=splash2",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "icon-192.png?v=splash2",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "icon-512-maskable.png?v=splash2",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "icon-192-maskable.png?v=splash2",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    }
  ]
}
